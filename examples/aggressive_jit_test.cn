// Aggressive JIT Test - Force JIT compilation with many function calls
using ns lang;

fn simple_add(a : int, b : int) : int {
    return a + b;
}

fn main() : int {
    lang::println("=== Aggressive JIT Test ===");
    
    // Call simple_add many times to force JIT compilation
    var total : int = 0;
    var i : int = 0;
    
    while (i < 20) {
        total = simple_add(total, i);
        i = i + 1;
    }
    
    lang::print("Total after 20 calls: ");
    lang::println(lang::to_string(total));
    
    return total;
}
