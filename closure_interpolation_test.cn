// CodeNothing 闭包插值测试
// 测试在字符串插值中使用闭包的基础功能

using ns lang;

fn main() : int {
    lang::println("CodeNothing Closure Interpolation Test");
    lang::println("=====================================");
    
    // 测试基础闭包插值（立即执行）
    test_immediate_closures();
    
    // 测试数学运算闭包
    test_math_closures();
    
    // 测试条件闭包
    test_conditional_closures();
    
    // 测试复杂闭包
    test_complex_closures();
    
    lang::println("");
    lang::println("Closure interpolation test completed!");
    
    return 0;
}

// 测试立即执行的闭包
fn test_immediate_closures() : int {
    lang::println("Testing Immediate Closures");
    lang::println("==========================");
    
    // 简单的数学运算闭包
    var result1 : string = "Add one: ${|x| x + 1}(5)";
    lang::println(result1);
    
    var result2 : string = "Double: ${|x| x * 2}(10)";
    lang::println(result2);
    
    var result3 : string = "Subtract: ${|x| x - 1}(7)";
    lang::println(result3);
    
    lang::println("");
    return 0;
}

// 测试数学运算闭包
fn test_math_closures() : int {
    lang::println("Testing Math Closures");
    lang::println("=====================");
    
    var x : int = 15;
    var y : int = 25;
    
    // 使用变量作为闭包参数
    var sum_result : string = "Sum: ${|a| a + 10}(x)";
    lang::println(sum_result);
    
    var product_result : string = "Product: ${|a| a * 3}(y)";
    lang::println(product_result);
    
    // 多参数闭包（如果支持的话）
    // var multi_param : string = "Multi: ${|a, b| a + b}(x, y)";
    // lang::println(multi_param);
    
    lang::println("");
    return 0;
}

// 测试条件闭包
fn test_conditional_closures() : int {
    lang::println("Testing Conditional Closures");
    lang::println("============================");
    
    var score : int = 85;
    
    // 条件判断闭包
    var grade : string = "Grade: ${|s| s >= 90 ? \"A\" : \"B\"}(score)";
    lang::println(grade);
    
    var status : string = "Status: ${|x| x > 50 ? \"Pass\" : \"Fail\"}(score)";
    lang::println(status);
    
    lang::println("");
    return 0;
}

// 测试复杂闭包
fn test_complex_closures() : int {
    lang::println("Testing Complex Closures");
    lang::println("========================");
    
    // 嵌套运算
    var complex1 : string = "Complex: ${|x| (x + 5) * 2}(10)";
    lang::println(complex1);
    
    // 多步运算
    var complex2 : string = "Multi-step: ${|x| x * x + x}(6)";
    lang::println(complex2);
    
    // 字符串操作闭包
    var str_op : string = "String op: ${|x| \"Value: \" + x}(42)";
    lang::println(str_op);
    
    lang::println("");
    return 0;
}

// 辅助函数用于演示
fn square(n : int) : int {
    return n * n;
}

fn is_even(n : int) : bool {
    return n % 2 == 0;
}
