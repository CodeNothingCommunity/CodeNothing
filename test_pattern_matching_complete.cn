// 🎯 CodeNothing 模式匹配功能完整测试
// 测试各种模式匹配场景

lib <io>;

fn test_basic_patterns() {
    std::println("=== 基本模式匹配测试 ===");
    
    // 测试整数字面量模式
    var x : int = 42;
    var result : string = match x {
        42 => "找到答案!",
        0 => "零",
        _ => "其他数字",
    };
    std::println("x = 42, 匹配结果: " + result);
    
    // 测试不同的值
    var y : int = 0;
    var result2 : string = match y {
        42 => "找到答案!",
        0 => "零",
        _ => "其他数字",
    };
    std::println("y = 0, 匹配结果: " + result2);
    
    // 测试默认分支
    var z : int = 100;
    var result3 : string = match z {
        42 => "找到答案!",
        0 => "零",
        _ => "其他数字",
    };
    std::println("z = 100, 匹配结果: " + result3);
}

fn test_string_patterns() {
    std::println("");
    std::println("=== 字符串模式匹配测试 ===");
    
    var name : string = "Alice";
    var greeting : string = match name {
        "Alice" => "你好, Alice!",
        "Bob" => "嗨, Bob!",
        _ => "你好, 陌生人!",
    };
    std::println("name = Alice, 问候: " + greeting);
    
    var name2 : string = "Charlie";
    var greeting2 : string = match name2 {
        "Alice" => "你好, Alice!",
        "Bob" => "嗨, Bob!",
        _ => "你好, 陌生人!",
    };
    std::println("name2 = Charlie, 问候: " + greeting2);
}

fn test_boolean_patterns() {
    std::println("");
    std::println("=== 布尔值模式匹配测试 ===");
    
    var flag : bool = true;
    var status : string = match flag {
        true => "开启",
        false => "关闭",
    };
    std::println("flag = true, 状态: " + status);
    
    var flag2 : bool = false;
    var status2 : string = match flag2 {
        true => "开启",
        false => "关闭",
    };
    std::println("flag2 = false, 状态: " + status2);
}

fn test_wildcard_patterns() {
    std::println("");
    std::println("=== 通配符模式测试 ===");
    
    var value : int = 999;
    var category : string = match value {
        1 => "一",
        2 => "二",
        3 => "三",
        _ => "其他",
    };
    std::println("value = 999, 分类: " + category);
}

fn test_identifier_patterns() {
    std::println("");
    std::println("=== 标识符模式测试 ===");
    
    // 注意：标识符模式绑定功能还未完全实现
    // 这里只是测试语法解析
    var number : int = 123;
    var description : string = match number {
        n => "任意数字",  // n 应该绑定到 number 的值
    };
    std::println("number = 123, 描述: " + description);
}

fn test_multiple_patterns() {
    std::println("");
    std::println("=== 多模式匹配测试 ===");
    
    var score : int = 85;
    var grade : string = match score {
        100 => "满分!",
        90 => "优秀",
        80 => "良好",
        70 => "及格",
        _ => "需要努力",
    };
    std::println("score = 85, 等级: " + grade);
    
    var score2 : int = 90;
    var grade2 : string = match score2 {
        100 => "满分!",
        90 => "优秀",
        80 => "良好",
        70 => "及格",
        _ => "需要努力",
    };
    std::println("score2 = 90, 等级: " + grade2);
}

fn test_nested_match() {
    std::println("");
    std::println("=== 嵌套匹配测试 ===");
    
    var x : int = 1;
    var y : int = 2;
    
    var result : string = match x {
        1 => match y {
            1 => "x=1, y=1",
            2 => "x=1, y=2",
            _ => "x=1, y=其他",
        },
        2 => "x=2",
        _ => "x=其他",
    };
    std::println("x=1, y=2, 嵌套匹配结果: " + result);
}

fn test_match_as_expression() {
    std::println("");
    std::println("=== Match 作为表达式测试 ===");
    
    var day : int = 3;
    
    // match 表达式可以直接用在函数调用中
    std::println("今天是: " + match day {
        1 => "星期一",
        2 => "星期二", 
        3 => "星期三",
        4 => "星期四",
        5 => "星期五",
        6 => "星期六",
        7 => "星期日",
        _ => "无效日期",
    });
    
    // match 表达式可以用在算术运算中
    var multiplier : int = match day {
        1 => 1,
        2 => 2,
        3 => 3,
        _ => 0,
    };
    var result : int = day * multiplier;
    std::println("day * multiplier = " + to_string(result));
}

fn main() : int {
    std::println("🚀 CodeNothing 模式匹配功能完整测试");
    std::println("=====================================");
    
    test_basic_patterns();
    test_string_patterns();
    test_boolean_patterns();
    test_wildcard_patterns();
    test_identifier_patterns();
    test_multiple_patterns();
    test_nested_match();
    test_match_as_expression();
    
    std::println("");
    std::println("✅ 模式匹配测试完成!");
    std::println("🎉 CodeNothing 现在支持模式匹配功能!");
    
    return 0;
}
