// CodeNothing 猜数字小游戏 - 面向对象 - CODENOTHING 官方示例程序。
// 展示 CodeNothing 语言的 OOP 特性：类、封装、方法

lib <math>;
lib <io>;

// ========================================
// 🔧 辅助函数
// ========================================

// 安全的字符串转整数函数
fn to_int_safe(input: string): int {
    try {
        return lang::to_int(input);
    } catch {
        return -999;  // 返回特殊值表示转换失败
    }
}

// ========================================
// 🎮 游戏类定义
// ========================================

// 玩家类 - 封装玩家信息和统计数据
class Player {
    public name: string;
    public total_games: int;
    public wins: int;
    public total_score: int;

    Player(name: string) {
        self.name = name;
        self.total_games = 0;
        self.wins = 0;
        self.total_score = 0;
    }

    public fn get_name(self: Player): string {
        return self.name;
    }

    public fn start_new_game(self: Player): void {
        self.total_games = self.total_games + 1;
    }

    public fn win_game(self: Player, score: int): void {
        self.wins = self.wins + 1;
        self.total_score = self.total_score + score;
    }

    public fn get_win_rate(self: Player): float {
        if (self.total_games == 0) {
            return 0.0;
        }
        return lang::to_float(self.wins) / lang::to_float(self.total_games) * 100.0;
    }

    public fn get_average_score(self: Player): float {
        if (self.wins == 0) {
            return 0.0;
        }
        return lang::to_float(self.total_score) / lang::to_float(self.wins);
    }

    public fn show_stats(self: Player): void {
        std::println("📊 " + self.name + " 的游戏统计：");
        std::println("   总游戏数: " + lang::to_string(self.total_games));
        std::println("   获胜次数: " + lang::to_string(self.wins));
        std::println("   总得分: " + lang::to_string(self.total_score));
        std::println("   胜率: " + lang::to_string(self.get_win_rate()) + "%");
        if (self.wins > 0) {
            std::println("   平均得分: " + lang::to_string(self.get_average_score()));
        }
    }
}

// 猜数字游戏类 - 封装游戏逻辑和状态
class GuessNumberGame {
    public player: Player;
    public target_number: int;
    public attempts: int;
    public max_attempts: int;
    public min_range: int;
    public max_range: int;
    public is_won: bool;
    public current_score: int;

    GuessNumberGame(player: Player) {
        self.player = player;
        self.attempts = 0;
        self.max_attempts = 10;
        self.min_range = 1;
        self.max_range = 100;
        self.is_won = false;
        self.current_score = 0;

        // 初始化 target_number 为 0，将在 start_new_round 中设置
        self.target_number = 0;
    }

    public fn show_welcome(self: GuessNumberGame): void {
        std::println("欢迎来到 CodeNothing 猜数字游戏！");
        std::println("=====================================");
        std::println("游戏规则：");
        std::println("1. 系统会生成一个 " + lang::to_string(self.min_range) + "-" + lang::to_string(self.max_range) + " 之间的随机数");
        std::println("2. 你需要猜出这个数字");
        std::println("3. 系统会提示你猜的数字是大了还是小了");
        std::println("4. 你有 " + lang::to_string(self.max_attempts) + " 次机会！");
        std::println("=====================================");
        std::println("");
    }

    public fn start_new_round(self: GuessNumberGame): void {
        // 重置游戏状态
        self.attempts = 0;
        self.is_won = false;
        self.current_score = 0;

        // 生成随机数
        random::seed();
        var random_str := random::randint("1", "100");
        self.target_number = to_int_safe(random_str);

        // 通知玩家开始新游戏
        self.player.start_new_game();

        std::println("我已经想好了一个 " + lang::to_string(self.min_range) + "-" + lang::to_string(self.max_range) + " 之间的数字！");
        std::println("开始猜吧！");
        std::println("");
    }

    public fn make_guess(self: GuessNumberGame, guess: int): bool {
        self.attempts = self.attempts + 1;

        if (guess == self.target_number) {
            self.is_won = true;
            self.handle_correct_guess();
            return true;
        } else if (guess < self.target_number) {
            self.handle_too_low();
        } else {
            self.handle_too_high();
        }

        // 检查是否用完机会
        if (self.attempts >= self.max_attempts) {
            self.handle_game_over();
            return true; // 游戏结束
        }

        return false; // 继续游戏
    }

    public fn handle_correct_guess(self: GuessNumberGame): void {
        std::println("[✓] 恭喜你！猜对了！");
        std::println("答案就是：" + lang::to_string(self.target_number));
        std::println("你用了 " + lang::to_string(self.attempts) + " 次就猜中了！");

        // 计算得分
        self.calculate_score();
        std::println("本局得分：" + lang::to_string(self.current_score) + " 分");

        // 更新玩家统计
        self.player.win_game(self.current_score);

        // 给出表现评价
        self.give_performance_feedback();
    }

    public fn handle_too_low(self: GuessNumberGame): void {
        std::println("[-] 太小了！再试试更大的数字");
        self.show_remaining_attempts();
    }

    public fn handle_too_high(self: GuessNumberGame): void {
        std::println("[+] 太大了！再试试更小的数字");
        self.show_remaining_attempts();
    }

    public fn handle_game_over(self: GuessNumberGame): void {
        std::println("{:(} 很遗憾，你用完了所有 " + lang::to_string(self.max_attempts) + " 次机会！");
        std::println("答案是：" + lang::to_string(self.target_number));
        std::println("下次再来挑战吧！");
    }

    public fn show_remaining_attempts(self: GuessNumberGame): void {
        var remaining := self.max_attempts - self.attempts;
        if (remaining > 0) {
            std::println("还有 " + lang::to_string(remaining) + " 次机会");
        }
        std::println("");
    }

    public fn calculate_score(self: GuessNumberGame): void {
        // 根据尝试次数计算得分，尝试次数越少得分越高
        var base_score := 1000;
        var penalty := (self.attempts - 1) * 100;
        self.current_score = base_score - penalty;

        if (self.current_score < 100) {
            self.current_score = 100; // 最低得分
        }
    }

    public fn give_performance_feedback(self: GuessNumberGame): void {
        std::println("");
        std::println("🏆 你的表现评价：");

        if (self.attempts == 1) {
            std::println("🌟 神级！一次就猜中了！你是天才吗？");
        } else if (self.attempts <= 3) {
            std::println("🔥 优秀！你的直觉很准！");
        } else if (self.attempts <= 5) {
            std::println("👍 不错！你很快就找到了答案！");
        } else if (self.attempts <= 7) {
            std::println("😊 还可以！继续努力！");
        } else {
            std::println("🤔 需要多练习！下次试试二分法？");
        }

        std::println("💡 提示：使用二分法最多只需要 7 次就能猜中 1-100 的数字！");
    }

    public fn is_game_over(self: GuessNumberGame): bool {
        return self.is_won || self.attempts >= self.max_attempts;
    }
}

// 输入验证器类 - 处理用户输入验证
class InputValidator {
    InputValidator() {
        // 空构造函数
    }

    public fn validate_number_input(self: InputValidator, input: string, min_val: int, max_val: int): int {
        var number := 0;

        try {
            number = lang::to_int(input);
        } catch {
            std::println("[!] 请输入有效的数字！");
            return -1; // 表示无效输入
        }

        if (number < min_val || number > max_val) {
            std::println("[!] 请输入 " + lang::to_string(min_val) + "-" + lang::to_string(max_val) + " 之间的数字！");
            return -1; // 表示超出范围
        }

        return number;
    }

    public fn validate_yes_no_input(self: InputValidator, input: string): bool {
        return input == "y" || input == "Y" || input == "yes" || input == "Yes";
    }
}

// 游戏管理器类 - 协调整个游戏流程
class GameManager {
    public player: Player;
    public game: GuessNumberGame;
    public validator: InputValidator;

    GameManager() {
        // 初始化随机数种子
        random::seed();

        // 获取玩家名字
        std::println("👋 欢迎来到 CodeNothing 猜数字游戏！");
        std::print("请输入你的名字: ");
        var player_name := std::input();

        // 创建游戏对象
        self.player = Player(player_name);
        self.game = GuessNumberGame(self.player);
        self.validator = InputValidator();

        std::println("你好，" + player_name + "！让我们开始游戏吧！");
        std::println("");
    }

    public fn start_game_loop(self: GameManager): void {
        var continue_playing := true;

        while (continue_playing) {
            self.play_single_round();
            continue_playing = self.ask_play_again();
        }

        self.show_final_results();
    }

    public fn play_single_round(self: GameManager): void {
        // 显示欢迎信息并开始新一轮
        self.game.show_welcome();
        self.game.start_new_round();

        // 游戏主循环
        while (!self.game.is_game_over()) {
            var prompt := "<?> 第 " + lang::to_string(self.game.attempts + 1) + " 次猜测，请输入你的数字 (" + lang::to_string(self.game.min_range) + "-" + lang::to_string(self.game.max_range) + "): ";
            std::print(prompt);

            var input := std::input();

            // 检查 debug 命令
            if (input == "debug") {
                std::println("DEBUG : NUMBER IS " + lang::to_string(self.game.target_number));
                continue;  // 继续循环，不计入猜测次数
            }

            var guess := self.validator.validate_number_input(input, self.game.min_range, self.game.max_range);

            if (guess != -1) {
                self.game.make_guess(guess);
            }
        }
    }

    public fn ask_play_again(self: GameManager): bool {
        std::println("");
        std::print("<?> 想再玩一局吗？(y/n): ");
        var answer := std::input();
        return self.validator.validate_yes_no_input(answer);
    }

    public fn show_final_results(self: GameManager): void {
        std::println("");
        std::println("=== 游戏结束 ===");
        self.player.show_stats();
        std::println("谢谢游玩！再见！");
    }
}

// 主程序 - 简洁的入口点
fn main() {
    var game_manager := GameManager();
    game_manager.start_game_loop();
}