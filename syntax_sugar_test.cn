// 🍭 CodeNothing 语法糖测试
// 测试自增/自减操作符、复合赋值操作符和三元条件操作符

lib <io>;

fn main() : int {
    std::println("🍭 CodeNothing 语法糖功能测试");
    std::println("==============================");
    std::println("");
    
    // 测试1: 自增/自减操作符
    std::println("🔸 测试1: 自增/自减操作符");
    std::println("========================");
    
    var counter : int = 5;
    std::println("初始值: " + lang::to_string(counter));
    
    // 前置自增
    var pre_inc : int = ++counter;
    std::println("前置自增 ++counter: " + lang::to_string(pre_inc) + ", counter = " + lang::to_string(counter));
    
    // 后置自增
    var post_inc : int = counter++;
    std::println("后置自增 counter++: " + lang::to_string(post_inc) + ", counter = " + lang::to_string(counter));
    
    // 前置自减
    var pre_dec : int = --counter;
    std::println("前置自减 --counter: " + lang::to_string(pre_dec) + ", counter = " + lang::to_string(counter));
    
    // 后置自减
    var post_dec : int = counter--;
    std::println("后置自减 counter--: " + lang::to_string(post_dec) + ", counter = " + lang::to_string(counter));
    
    std::println("");
    
    // 测试2: 复合赋值操作符
    std::println("🔸 测试2: 复合赋值操作符");
    std::println("======================");
    
    var value : int = 10;
    std::println("初始值: " + lang::to_string(value));
    
    // 加法赋值
    value += 5;
    std::println("value += 5: " + lang::to_string(value));
    
    // 减法赋值
    value -= 3;
    std::println("value -= 3: " + lang::to_string(value));
    
    // 乘法赋值
    value *= 2;
    std::println("value *= 2: " + lang::to_string(value));
    
    // 除法赋值
    value /= 4;
    std::println("value /= 4: " + lang::to_string(value));
    
    // 取模赋值
    value %= 5;
    std::println("value %= 5: " + lang::to_string(value));
    
    std::println("");
    
    // 测试3: 三元条件操作符
    std::println("🔸 测试3: 三元条件操作符");
    std::println("======================");
    
    var score : int = 85;
    var grade : string = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "F";
    std::println("分数 " + lang::to_string(score) + " 对应等级: " + grade);
    
    var age : int = 20;
    var status : string = age >= 18 ? "成年人" : "未成年人";
    std::println("年龄 " + lang::to_string(age) + " 状态: " + status);
    
    var temperature : int = 25;
    var weather : string = temperature > 30 ? "炎热" : temperature > 20 ? "温暖" : temperature > 10 ? "凉爽" : "寒冷";
    std::println("温度 " + lang::to_string(temperature) + "°C 天气: " + weather);
    
    std::println("");
    
    // 测试4: 组合使用
    std::println("🔸 测试4: 语法糖组合使用");
    std::println("======================");
    
    var x : int = 10;
    var y : int = 5;
    
    // 使用三元操作符选择操作，然后使用复合赋值
    var operation : string = "add";
    var result : int = x;
    
    if (operation == "add") {
        result += y;
    } else {
        result -= y;
    }
    
    std::println("x = " + lang::to_string(x) + ", y = " + lang::to_string(y));
    std::println("操作: " + operation);
    std::println("结果: " + lang::to_string(result));
    
    // 在循环中使用自增操作符
    std::println("");
    std::println("循环中的自增操作:");
    var i : int = 0;
    while (i < 5) {
        std::println("循环 " + lang::to_string(i) + ": i++ = " + lang::to_string(i++));
    }
    
    std::println("");
    
    // 测试5: 复杂表达式
    std::println("🔸 测试5: 复杂表达式");
    std::println("==================");
    
    var a : int = 10;
    var b : int = 20;
    var c : int = 30;
    
    // 复杂的三元表达式
    var max_value : int = a > b ? (a > c ? a : c) : (b > c ? b : c);
    std::println("a=" + lang::to_string(a) + ", b=" + lang::to_string(b) + ", c=" + lang::to_string(c));
    std::println("最大值: " + lang::to_string(max_value));
    
    // 复合赋值与自增的组合
    var total : int = 0;
    var multiplier : int = 2;
    total += ++multiplier * 5;  // multiplier先自增到3，然后乘以5，再加到total
    std::println("total += ++multiplier * 5: " + lang::to_string(total));
    std::println("multiplier = " + lang::to_string(multiplier));
    
    std::println("");
    std::println("🎉 所有语法糖测试完成!");
    std::println("");
    std::println("新增语法糖功能:");
    std::println("✅ 前置自增/自减: ++x, --x");
    std::println("✅ 后置自增/自减: x++, x--");
    std::println("✅ 复合赋值: +=, -=, *=, /=, %=");
    std::println("✅ 三元条件操作符: condition ? true_value : false_value");
    std::println("✅ 支持复杂嵌套和组合使用");
    std::println("");
    std::println("🔥 CodeNothing 语法更加简洁和现代化!");
    
    return 0;
}
