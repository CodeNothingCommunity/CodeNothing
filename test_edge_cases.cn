// Test edge cases for include system
using ns lang;

// Test 1: Selective import with alias
include "include_test_utils.cn" { add_numbers as add_func, MAX_VALUE };

// Test 2: Multiple selective imports
include "wildcard_utils_a.cn" { func_a, CONST_A as ALIAS_A };

fn main() : int {
    lang::println("=== Edge Cases Test ===");
    
    // Test aliased function
    var result1 : int = add_func(10, 20);
    lang::print("add_func(10, 20) = ");
    lang::println(lang::to_string(result1));
    
    // Test imported constant
    lang::print("MAX_VALUE = ");
    lang::println(lang::to_string(MAX_VALUE));
    
    // Test selective import
    var result2 : int = func_a(8);
    lang::print("func_a(8) = ");
    lang::println(lang::to_string(result2));
    
    // Test aliased constant
    lang::print("ALIAS_A = ");
    lang::println(lang::to_string(ALIAS_A));
    
    return 0;
}
