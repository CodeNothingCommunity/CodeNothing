// 🔥 CodeNothing 超复杂箭头函数测试
// 展示箭头函数在极端复杂场景中的应用能力

lib <io>;

// 复杂的金融风险评估系统
fn complex_financial_risk_system() {
    std::println("🔥 复杂金融风险评估系统");
    std::println("======================");
    
    // 超复杂的信用评分算法
    var calculate_credit_score = (income: int, debt: int, age: int, employment_years: int, payment_history: int, assets: int) => {
        var debt_to_income_ratio = debt * 100 / income;
        var age_factor = when { age >= 65 => 95, age >= 45 => 100, age >= 25 => 105, else => 90 };
        var employment_stability = when { employment_years >= 10 => 120, employment_years >= 5 => 110, employment_years >= 2 => 100, else => 85 };
        var payment_score = when { payment_history >= 95 => 150, payment_history >= 85 => 130, payment_history >= 75 => 110, payment_history >= 60 => 90, else => 70 };
        var asset_bonus = when { assets >= 1000000 => 100, assets >= 500000 => 80, assets >= 100000 => 60, assets >= 50000 => 40, else => 20 };
        var debt_penalty = when { debt_to_income_ratio >= 80 => -200, debt_to_income_ratio >= 60 => -150, debt_to_income_ratio >= 40 => -100, debt_to_income_ratio >= 20 => -50, else => 0 };
        var base_score = 600;
        var final_score = base_score + (age_factor * employment_stability * payment_score / 10000) + asset_bonus + debt_penalty;
        return when { final_score > 850 => 850, final_score < 300 => 300, else => final_score };
    };
    
    // 复杂的贷款利率定价模型
    var calculate_loan_rate = (credit_score: int, loan_amount: int, loan_term: int, property_value: int, market_rate: int) => {
        var ltv_ratio = loan_amount * 100 / property_value;
        var credit_adjustment = when { credit_score >= 800 => -100, credit_score >= 750 => -50, credit_score >= 700 => 0, credit_score >= 650 => 50, credit_score >= 600 => 100, else => 200 };
        var ltv_adjustment = when { ltv_ratio >= 95 => 150, ltv_ratio >= 90 => 100, ltv_ratio >= 80 => 50, ltv_ratio >= 70 => 25, else => 0 };
        var term_adjustment = when { loan_term >= 30 => 75, loan_term >= 20 => 50, loan_term >= 15 => 25, else => 0 };
        var amount_adjustment = when { loan_amount >= 1000000 => -25, loan_amount >= 500000 => -10, loan_amount >= 200000 => 0, else => 25 };
        return market_rate + credit_adjustment + ltv_adjustment + term_adjustment + amount_adjustment;
    };
    
    // 复杂的投资组合风险评估
    var assess_portfolio_risk = (stocks_percent: int, bonds_percent: int, real_estate_percent: int, cash_percent: int, investor_age: int, risk_tolerance: int) => {
        var age_risk_factor = when { investor_age >= 65 => 30, investor_age >= 55 => 50, investor_age >= 45 => 70, investor_age >= 35 => 85, else => 100 };
        var portfolio_volatility = (stocks_percent * 20 + bonds_percent * 5 + real_estate_percent * 15 + cash_percent * 1) / 100;
        var risk_mismatch_penalty = when { risk_tolerance >= 80 && portfolio_volatility < 10 => 20, risk_tolerance <= 30 && portfolio_volatility > 15 => 50, else => 0 };
        var diversification_bonus = when { stocks_percent <= 70 && bonds_percent >= 20 && real_estate_percent >= 5 => -10, else => 0 };
        var age_mismatch_penalty = when { investor_age >= 60 && stocks_percent > 60 => 30, investor_age <= 35 && stocks_percent < 60 => 15, else => 0 };
        return portfolio_volatility + risk_mismatch_penalty + diversification_bonus + age_mismatch_penalty - (age_risk_factor / 10);
    };
    
    std::println("信用评分算法: " + lang::to_string(calculate_credit_score));
    std::println("贷款利率定价: " + lang::to_string(calculate_loan_rate));
    std::println("投资组合风险: " + lang::to_string(assess_portfolio_risk));
    std::println("");
}

// 复杂的AI决策引擎
fn complex_ai_decision_engine() {
    std::println("🔥 复杂AI决策引擎");
    std::println("=================");
    
    // 超复杂的游戏AI战斗决策
    var ai_combat_decision = (my_health: int, my_mana: int, my_level: int, enemy_health: int, enemy_level: int, distance: int, terrain: string, weather: string, allies_nearby: int, items_available: int) => {
        var health_ratio = my_health * 100 / 100; // 假设满血为100
        var mana_ratio = my_mana * 100 / 100; // 假设满蓝为100
        var level_advantage = my_level - enemy_level;
        var terrain_bonus = when { terrain == "forest" => 10, terrain == "mountain" => 5, terrain == "desert" => -5, terrain == "swamp" => -10, else => 0 };
        var weather_modifier = when { weather == "rain" => -5, weather == "storm" => -15, weather == "sunny" => 5, weather == "fog" => -10, else => 0 };
        var ally_support = allies_nearby * 15;
        var item_advantage = items_available * 5;
        
        var combat_score = health_ratio + mana_ratio + (level_advantage * 20) + terrain_bonus + weather_modifier + ally_support + item_advantage;
        var enemy_threat = enemy_health + (enemy_level * 10);
        var distance_factor = when { distance <= 2 => 20, distance <= 5 => 10, distance <= 10 => 0, else => -10 };
        
        var final_decision_score = combat_score - enemy_threat + distance_factor;
        
        return when {
            final_decision_score >= 100 => 1, // 1 = aggressive_attack
            final_decision_score >= 50 => 2,  // 2 = cautious_attack
            final_decision_score >= 0 => 3,   // 3 = defensive_stance
            final_decision_score >= -50 => 4, // 4 = tactical_retreat
            else => 5                          // 5 = emergency_flee
        };
    };
    
    // 复杂的自动驾驶决策算法
    var autonomous_driving_decision = (speed: int, traffic_density: int, weather_visibility: int, road_condition: int, fuel_level: int, destination_distance: int, time_pressure: int, passenger_comfort: int) => {
        var safety_score = (weather_visibility + road_condition) / 2;
        var efficiency_score = when { traffic_density <= 20 => 90, traffic_density <= 50 => 70, traffic_density <= 80 => 50, else => 30 };
        var urgency_factor = when { time_pressure >= 80 => 30, time_pressure >= 60 => 20, time_pressure >= 40 => 10, else => 0 };
        var fuel_constraint = when { fuel_level <= 10 => -50, fuel_level <= 25 => -20, fuel_level <= 50 => -5, else => 0 };
        var comfort_priority = when { passenger_comfort >= 80 => -10, passenger_comfort >= 60 => -5, else => 0 }; // 负值表示更平稳驾驶
        
        var optimal_speed = when {
            safety_score <= 30 => speed * 60 / 100, // 恶劣条件下减速40%
            safety_score <= 60 => speed * 80 / 100, // 一般条件下减速20%
            efficiency_score >= 80 && urgency_factor >= 20 => speed * 110 / 100, // 良好条件下可适当加速
            else => speed
        };
        
        var lane_change_aggressiveness = efficiency_score + urgency_factor + fuel_constraint + comfort_priority;
        var following_distance = when { safety_score >= 80 => 2, safety_score >= 60 => 3, safety_score >= 40 => 4, else => 5 };
        
        return when {
            lane_change_aggressiveness >= 80 => 1, // 1 = aggressive_driving
            lane_change_aggressiveness >= 60 => 2, // 2 = assertive_driving
            lane_change_aggressiveness >= 40 => 3, // 3 = normal_driving
            lane_change_aggressiveness >= 20 => 4, // 4 = cautious_driving
            else => 5                               // 5 = very_cautious_driving
        };
    };
    
    // 复杂的医疗诊断辅助系统
    var medical_diagnosis_assistant = (symptom1_severity: int, symptom2_severity: int, symptom3_severity: int, patient_age: int, medical_history_risk: int, lab_result1: int, lab_result2: int, vital_signs_stability: int) => {
        var symptom_cluster_score = (symptom1_severity * 3 + symptom2_severity * 2 + symptom3_severity * 1);
        var age_risk_multiplier = when { patient_age >= 80 => 150, patient_age >= 65 => 130, patient_age >= 50 => 110, patient_age >= 30 => 100, else => 90 };
        var history_weight = when { medical_history_risk >= 80 => 40, medical_history_risk >= 60 => 30, medical_history_risk >= 40 => 20, medical_history_risk >= 20 => 10, else => 0 };
        var lab_abnormality = when { lab_result1 >= 80 || lab_result2 >= 80 => 50, lab_result1 >= 60 || lab_result2 >= 60 => 30, lab_result1 >= 40 || lab_result2 >= 40 => 15, else => 0 };
        var vital_concern = when { vital_signs_stability <= 20 => 100, vital_signs_stability <= 40 => 60, vital_signs_stability <= 60 => 30, vital_signs_stability <= 80 => 10, else => 0 };
        
        var total_risk_score = (symptom_cluster_score * age_risk_multiplier / 100) + history_weight + lab_abnormality + vital_concern;
        
        return when {
            total_risk_score >= 200 => 1, // 1 = immediate_emergency_care
            total_risk_score >= 150 => 2, // 2 = urgent_specialist_referral
            total_risk_score >= 100 => 3, // 3 = schedule_follow_up_soon
            total_risk_score >= 50 => 4,  // 4 = routine_monitoring
            else => 5                      // 5 = reassurance_and_discharge
        };
    };
    
    std::println("AI战斗决策: " + lang::to_string(ai_combat_decision));
    std::println("自动驾驶决策: " + lang::to_string(autonomous_driving_decision));
    std::println("医疗诊断辅助: " + lang::to_string(medical_diagnosis_assistant));
    std::println("");
}

// 复杂的供应链优化系统
fn complex_supply_chain_optimization() {
    std::println("🔥 复杂供应链优化系统");
    std::println("====================");
    
    // 超复杂的库存优化算法
    var optimize_inventory_levels = (current_stock: int, daily_demand: int, lead_time: int, demand_variability: int, storage_cost: int, stockout_penalty: int, supplier_reliability: int, seasonal_factor: int, economic_outlook: int) => {
        var base_safety_stock = daily_demand * lead_time / 2;
        var variability_buffer = (daily_demand * demand_variability * lead_time) / 100;
        var reliability_adjustment = when { supplier_reliability >= 95 => 0, supplier_reliability >= 85 => base_safety_stock * 10 / 100, supplier_reliability >= 75 => base_safety_stock * 25 / 100, else => base_safety_stock * 50 / 100 };
        var seasonal_adjustment = (daily_demand * seasonal_factor * lead_time) / 100;
        var economic_adjustment = when { economic_outlook >= 80 => daily_demand * 5, economic_outlook >= 60 => daily_demand * 2, economic_outlook >= 40 => 0, economic_outlook >= 20 => daily_demand * -2, else => daily_demand * -5 };
        
        var optimal_safety_stock = base_safety_stock + variability_buffer + reliability_adjustment + seasonal_adjustment + economic_adjustment;
        var reorder_point = (daily_demand * lead_time) + optimal_safety_stock;
        var max_inventory = reorder_point + (daily_demand * 30); // 30天的额外库存
        
        var cost_efficiency_score = (stockout_penalty * 100) / (storage_cost + 1); // 避免除零
        var order_quantity_multiplier = when { cost_efficiency_score >= 1000 => 150, cost_efficiency_score >= 500 => 130, cost_efficiency_score >= 200 => 110, cost_efficiency_score >= 100 => 100, else => 90 };
        
        return (reorder_point * order_quantity_multiplier) / 100;
    };
    
    // 复杂的供应商评估和选择算法
    var evaluate_supplier_performance = (quality_score: int, delivery_reliability: int, cost_competitiveness: int, financial_stability: int, innovation_capability: int, sustainability_rating: int, geographic_proximity: int, relationship_history: int, capacity_flexibility: int) => {
        var quality_weight = quality_score * 25; // 质量权重25%
        var reliability_weight = delivery_reliability * 20; // 可靠性权重20%
        var cost_weight = cost_competitiveness * 20; // 成本权重20%
        var stability_weight = financial_stability * 15; // 财务稳定性权重15%
        var innovation_weight = innovation_capability * 10; // 创新能力权重10%
        var sustainability_weight = sustainability_rating * 5; // 可持续性权重5%
        var proximity_weight = geographic_proximity * 3; // 地理位置权重3%
        var history_weight = relationship_history * 2; // 历史关系权重2%
        
        var base_score = (quality_weight + reliability_weight + cost_weight + stability_weight + innovation_weight + sustainability_weight + proximity_weight + history_weight) / 100;
        
        var flexibility_bonus = when { capacity_flexibility >= 90 => 10, capacity_flexibility >= 75 => 7, capacity_flexibility >= 60 => 5, capacity_flexibility >= 45 => 3, else => 0 };
        var risk_penalty = when { financial_stability <= 30 => -20, financial_stability <= 50 => -10, financial_stability <= 70 => -5, else => 0 };
        var strategic_bonus = when { innovation_capability >= 80 && sustainability_rating >= 70 => 15, innovation_capability >= 60 || sustainability_rating >= 60 => 8, else => 0 };
        
        return base_score + flexibility_bonus + risk_penalty + strategic_bonus;
    };
    
    // 复杂的物流路径优化算法
    var optimize_logistics_route = (distance_km: int, traffic_congestion: int, fuel_cost_per_km: int, driver_hours: int, cargo_value: int, delivery_urgency: int, weather_risk: int, route_security: int, toll_costs: int) => {
        var base_transport_cost = distance_km * fuel_cost_per_km;
        var congestion_delay_cost = (traffic_congestion * driver_hours * 25) / 100; // 假设司机每小时成本25
        var urgency_premium = when { delivery_urgency >= 90 => cargo_value * 5 / 100, delivery_urgency >= 70 => cargo_value * 3 / 100, delivery_urgency >= 50 => cargo_value * 1 / 100, else => 0 };
        var weather_risk_cost = when { weather_risk >= 80 => base_transport_cost * 20 / 100, weather_risk >= 60 => base_transport_cost * 10 / 100, weather_risk >= 40 => base_transport_cost * 5 / 100, else => 0 };
        var security_cost = when { route_security <= 30 => cargo_value * 2 / 100, route_security <= 50 => cargo_value * 1 / 100, route_security <= 70 => cargo_value * 50 / 10000, else => 0 };
        
        var total_cost = base_transport_cost + congestion_delay_cost + urgency_premium + weather_risk_cost + security_cost + toll_costs;
        var efficiency_score = (cargo_value * 100) / (total_cost + 1); // 避免除零
        
        var route_priority = when { efficiency_score >= 500 => 1, efficiency_score >= 300 => 2, efficiency_score >= 200 => 3, efficiency_score >= 100 => 4, else => 5 };
        
        return route_priority * 1000 + total_cost / 10; // 编码：优先级*1000 + 成本/10
    };
    
    std::println("库存优化算法: " + lang::to_string(optimize_inventory_levels));
    std::println("供应商评估算法: " + lang::to_string(evaluate_supplier_performance));
    std::println("物流路径优化: " + lang::to_string(optimize_logistics_route));
    std::println("");
}

