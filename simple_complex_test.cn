lib <io>;

fn main() : int {
    std::println("开始复杂测试");
    
    // 测试多个模式
    var value : int = 25;
    var result : string = match value {
        1 => "一",
        5 => "五", 
        10 => "十",
        15 => "十五",
        20 => "二十",
        25 => "二十五",
        30 => "三十",
        _ => "其他",
    };
    
    std::println("值 25 匹配结果: " + result);
    
    return 0;
}
