//! 基础语法测试 - 变量声明、基本表达式、控制流

// 全局变量声明测试 (parser期望的语法: name: type = value;)
x: int = 42;
y: float = 3.14;
z: string = "hello";
auto_var: auto = 100;  // 自动类型推断

// 基本表达式测试 (这些需要在函数内部)
sum: int = 52;  // x + 10 的结果
product: float = 6.28;  // y * 2.0 的结果
concat: string = "hello world";  // z + " world" 的结果
comparison: bool = true;  // x > 30 的结果
logical: bool = true;  // comparison && true 的结果

// 函数声明测试 (parser期望的语法: fn name(params): return_type)
fn add(a: int, b: int): int {
    return a + b;
}

fn greet(name: string): string {
    return "Hello, " + name;
}

fn factorial(n: int): int {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

// 控制流测试
fn test_control_flow(): auto {
    // If语句
    if (x > 0) {
        print("x is positive");
    } else {
        print("x is not positive");
    }

    // While循环
    var i: int = 0;
    while (i < 5) {
        print("i = " + i);
        i = i + 1;
    }

    // For循环
    for (var j: int = 0; j < 3; j = j + 1) {
        print("j = " + j);
    }
}

// 数组测试
fn test_collections(): auto {
    var numbers: array = [1, 2, 3, 4, 5];
    var first: int = numbers[0];
}

// Range测试 (暂时注释掉，因为parser可能有问题)
// fn test_range(): auto {
//     for (num : 1...5) {
//         print("num = " + num);
//     }
// }

// 主函数
fn main(): auto {
    test_control_flow();
    test_collections();
    // test_range();

    var result: int = add(10, 20);
    print("10 + 20 = " + result);

    var greeting: string = greet("World");
    print(greeting);

    var fact: int = factorial(5);
    print("5! = " + fact);
}
