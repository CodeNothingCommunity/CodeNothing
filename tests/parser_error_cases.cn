//! 错误情况测试 - 这些应该产生解析错误

// 语法错误示例 - 这些会导致解析失败

// 1. 缺少分号
fn missing_semicolon() {
    var x = 10  // 错误：缺少分号
    var y = 20;
}

// 2. 不匹配的括号
fn unmatched_brackets() {
    var arr = [1, 2, 3;  // 错误：缺少 ]
    var obj = {key: value;  // 错误：缺少 }
}

// 3. 无效的函数声明
fn invalid_function(  // 错误：缺少参数列表结束
    a: int,
    b: int
{
    return a + b;
}

// 4. 无效的类型注解
fn invalid_types() {
    var x: invalid_type = 10;  // 错误：无效类型
    var y: array<> = [];       // 错误：空泛型参数
}

// 5. 无效的表达式
fn invalid_expressions() {
    var x = 10 +;              // 错误：不完整的表达式
    var y = * 5;               // 错误：无效的一元操作
    var z = (10 + 5;           // 错误：不匹配的括号
}

// 6. 无效的控制流
fn invalid_control_flow() {
    if (true {                 // 错误：缺少 )
        print("hello");
    }
    
    while true) {              // 错误：缺少 (
        break;
    }
    
    for (var i = 0; i < 10 {   // 错误：缺少 )
        continue;
    }
}

// 7. 无效的Switch语句
fn invalid_switch() {
    switch (value {            // 错误：缺少 )
        case 1
            return "one";      // 错误：缺少 :
        case 2:
            return "two"       // 错误：缺少 ;
        default
            return "other";    // 错误：缺少 :
    }
}

// 8. 无效的异常处理
fn invalid_exceptions() {
    try                        // 错误：缺少 {
        throw "error";
    } catch {                  // 错误：缺少异常变量
        print("caught");
    } finally                  // 错误：缺少 {
        print("cleanup");
    }
}

// 9. 无效的命名空间
ns InvalidNamespace        // 错误：缺少 {
    fn test() {
        return 1;
    }
}

ns {                       // 错误：缺少命名空间名
    fn test() {
        return 1;
    }
}

// 10. 无效的Using声明
using ns;                  // 错误：缺少命名空间名
using InvalidNamespace;    // 错误：缺少 ns 关键字

// 11. 无效的Memo声明
memo(max_size: ) {         // 错误：缺少参数值
    fn test() {
        return 1;
    }
}

memo(invalid_param: 100) { // 错误：无效的参数名
    fn test() {
        return 1;
    }
}

// 12. 无效的数组和对象字面量
fn invalid_literals() {
    var arr = [1, 2, ];        // 错误：尾随逗号后缺少元素
    var obj = {key: };         // 错误：缺少值
    var obj2 = {: value};      // 错误：缺少键
}

// 13. 无效的函数调用
fn invalid_calls() {
    var result = func(1, 2, ); // 错误：尾随逗号后缺少参数
    var result2 = func(;       // 错误：缺少参数和 )
}

// 14. 无效的赋值
fn invalid_assignments() {
    10 = x;                    // 错误：不能给字面量赋值
    func() = 20;               // 错误：不能给函数调用赋值
}

// 15. 无效的Range表达式
fn invalid_ranges() {
    for (var x : ...5) {       // 错误：缺少起始值
        print(x);
    }
    
    for (var y : 1...) {       // 错误：缺少结束值
        print(y);
    }
}

// 这个文件应该产生多个解析错误
// 用于测试错误处理和错误报告的质量
