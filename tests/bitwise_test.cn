//! 位运算操作符测试

// 测试位运算AND
fn test_bitwise_and(): auto {
    lang::println("=== Bitwise AND Test ===");
    
    var a: int = 12;  // 1100 in binary
    var b: int = 10;  // 1010 in binary
    var result: int = a & b;  // Should be 8 (1000 in binary)
    
    lang::println("12 & 10 = " + lang::to_string(result));
}

// 测试位运算OR
fn test_bitwise_or(): auto {
    lang::println("=== Bitwise OR Test ===");
    
    var a: int = 12;  // 1100 in binary
    var b: int = 10;  // 1010 in binary
    var result: int = a | b;  // Should be 14 (1110 in binary)
    
    lang::println("12 | 10 = " + lang::to_string(result));
}

// 测试位运算XOR
fn test_bitwise_xor(): auto {
    lang::println("=== Bitwise XOR Test ===");
    
    var a: int = 12;  // 1100 in binary
    var b: int = 10;  // 1010 in binary
    var result: int = a ^ b;  // Should be 6 (0110 in binary)
    
    lang::println("12 ^ 10 = " + lang::to_string(result));
}

// 测试位运算NOT
fn test_bitwise_not(): auto {
    lang::println("=== Bitwise NOT Test ===");
    
    var a: int = 5;   // 0101 in binary
    var result: int = ~a;  // Should be -6 (two's complement)
    
    lang::println("~5 = " + lang::to_string(result));
}

// 测试左移
fn test_left_shift(): auto {
    lang::println("=== Left Shift Test ===");
    
    var a: int = 5;   // 0101 in binary
    var result: int = a << 2;  // Should be 20 (10100 in binary)
    
    lang::println("5 << 2 = " + lang::to_string(result));
}

// 测试右移
fn test_right_shift(): auto {
    lang::println("=== Right Shift Test ===");
    
    var a: int = 20;  // 10100 in binary
    var result: int = a >> 2;  // Should be 5 (0101 in binary)
    
    lang::println("20 >> 2 = " + lang::to_string(result));
}

// 测试复合位运算
fn test_complex_bitwise(): auto {
    lang::println("=== Complex Bitwise Test ===");
    
    var x: int = 15;  // 1111 in binary
    var y: int = 7;   // 0111 in binary
    
    // 复合运算
    var result1: int = (x & y) | (x ^ y);
    var result2: int = ~(x & y);
    var result3: int = (x << 1) >> 1;
    
    lang::println("(15 & 7) | (15 ^ 7) = " + lang::to_string(result1));
    lang::println("~(15 & 7) = " + lang::to_string(result2));
    lang::println("(15 << 1) >> 1 = " + lang::to_string(result3));
}

// 主函数
fn main(): auto {
    lang::println("Starting Bitwise Operations Test");
    lang::println("");
    
    test_bitwise_and();
    lang::println("");
    
    test_bitwise_or();
    lang::println("");
    
    test_bitwise_xor();
    lang::println("");
    
    test_bitwise_not();
    lang::println("");
    
    test_left_shift();
    lang::println("");
    
    test_right_shift();
    lang::println("");
    
    test_complex_bitwise();
    lang::println("");
    
    lang::println("All bitwise operations tests completed!");
}
