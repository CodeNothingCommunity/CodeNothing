//! 泛型类型语法测试

// 测试泛型数组类型
fn test_generic_arrays(): auto {
    lang::println("=== Generic Array Types Test ===");
    
    // 整数数组
    var int_array: array<int> = [1, 2, 3, 4, 5];
    var first_int: int = int_array[0];
    lang::println("Integer array first element: " + lang::to_string(first_int));
    
    // 字符串数组
    var string_array: array<string> = ["hello", "world", "test"];
    var first_string: string = string_array[0];
    lang::println("String array first element: " + first_string);
    
    // 布尔数组
    var bool_array: array<bool> = [true, false, true];
    var first_bool: bool = bool_array[0];
    lang::println("Boolean array first element: " + lang::to_string(first_bool));
}

// 测试嵌套泛型类型
fn test_nested_generic_types(): auto {
    lang::println("=== Nested Generic Types Test ===");
    
    // 数组的数组 (二维数组)
    var matrix: array<array<int>> = [[1, 2], [3, 4], [5, 6]];
    var first_row: array<int> = matrix[0];
    var first_element: int = first_row[0];
    lang::println("Matrix first element: " + lang::to_string(first_element));
}

// 测试函数参数中的泛型类型
fn process_int_array(arr: array<int>): int {
    return arr[0];
}

fn process_string_array(arr: array<string>): string {
    return arr[0];
}

fn test_generic_function_parameters(): auto {
    lang::println("=== Generic Function Parameters Test ===");
    
    var numbers: array<int> = [10, 20, 30];
    var words: array<string> = ["first", "second", "third"];
    
    var first_number: int = process_int_array(numbers);
    var first_word: string = process_string_array(words);
    
    lang::println("First number: " + lang::to_string(first_number));
    lang::println("First word: " + first_word);
}

// 测试函数返回值中的泛型类型
fn create_int_array(): array<int> {
    return [100, 200, 300];
}

fn create_string_array(): array<string> {
    return ["created", "array", "test"];
}

fn test_generic_return_types(): auto {
    lang::println("=== Generic Return Types Test ===");
    
    var created_numbers: array<int> = create_int_array();
    var created_words: array<string> = create_string_array();
    
    lang::println("Created number: " + lang::to_string(created_numbers[0]));
    lang::println("Created word: " + created_words[0]);
}

// 测试混合泛型和非泛型类型
fn test_mixed_types(): auto {
    lang::println("=== Mixed Types Test ===");
    
    // 泛型数组
    var typed_array: array<int> = [1, 2, 3];
    
    // 非泛型数组 (应该默认为auto)
    var auto_array: array = [4, 5, 6];
    
    var typed_first: int = typed_array[0];
    var auto_first: int = auto_array[0];
    
    lang::println("Typed array first: " + lang::to_string(typed_first));
    lang::println("Auto array first: " + lang::to_string(auto_first));
}

// 主函数
fn main(): auto {
    lang::println("Starting Generic Types Test");
    lang::println("");
    
    test_generic_arrays();
    lang::println("");
    
    test_nested_generic_types();
    lang::println("");
    
    test_generic_function_parameters();
    lang::println("");
    
    test_generic_return_types();
    lang::println("");
    
    test_mixed_types();
    lang::println("");
    
    lang::println("All generic types tests completed!");
}
