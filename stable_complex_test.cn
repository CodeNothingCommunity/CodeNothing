// 🔥 CodeNothing 稳定复杂语法糖测试
// 展示高级语法糖在复杂场景中的稳定应用

lib <io>;

// 复杂的员工管理系统
fn employee_management_system() {
    std::println("🔥 员工管理系统");
    std::println("==============");
    
    var employee_name : string = "Alice";
    var role : string = "engineer";
    var level : int = 7;
    var years : int = 5;
    var performance : int = 88;
    var department : string = "tech";
    var bonus_eligible : string = "";
    
    // 复杂的职级评定
    var job_grade : string = bonus_eligible ?? when { role == "manager" && level >= 8 => "senior_manager", role == "manager" => "manager", role == "engineer" && level >= 7 => "senior_engineer", role == "engineer" && level >= 5 => "engineer", else => "junior" };
    
    // 薪资计算
    var base_pay : int = 50000;
    var level_bonus : int = level * 2000;
    var performance_bonus : int = when { performance >= 90 => 10000, performance >= 85 => 7000, performance >= 80 => 5000, else => 2000 };
    var dept_multiplier : int = when { department == "tech" => 110, department == "sales" => 105, else => 100 };
    
    var total_salary : int = ((base_pay + level_bonus) * dept_multiplier / 100) + performance_bonus;
    
    std::println("员工: " + employee_name);
    std::println("  职位: " + role + " -> 等级: " + job_grade);
    std::println("  级别: " + lang::to_string(level) + ", 经验: " + lang::to_string(years) + "年");
    std::println("  绩效: " + lang::to_string(performance) + "分");
    std::println("  部门: " + department + " (倍数: " + lang::to_string(dept_multiplier) + "%)");
    std::println("  薪资构成: 基础" + lang::to_string(base_pay) + " + 级别" + lang::to_string(level_bonus) + " + 绩效" + lang::to_string(performance_bonus));
    std::println("  总薪资: " + lang::to_string(total_salary));
    std::println("");
}

// 复杂的产品推荐系统
fn product_recommendation_system() {
    std::println("🔥 产品推荐系统");
    std::println("==============");
    
    var user_age : int = 28;
    var income : int = 60000;
    var purchase_history : int = 12;
    var last_category : string = "electronics";
    var season : string = "winter";
    var membership : string = "gold";
    var location : string = "city";
    
    // 用户分类
    var user_type : string = when { income >= 80000 && purchase_history >= 15 => "premium", income >= 50000 && purchase_history >= 8 => "regular", purchase_history >= 5 => "casual", else => "new" };
    
    // 推荐类别
    var recommended_category : string = when { last_category == "electronics" && season == "winter" => "home_appliances", last_category == "clothing" && season == "winter" => "winter_wear", user_type == "premium" => "luxury", season == "winter" => "seasonal", else => "general" };
    
    // 折扣计算
    var base_discount : int = when { user_type == "premium" => 25, user_type == "regular" => 20, user_type == "casual" => 15, else => 10 };
    var membership_bonus : int = when { membership == "platinum" => 10, membership == "gold" => 7, membership == "silver" => 5, else => 0 };
    var location_bonus : int = when { location == "city" => 3, else => 0 };
    
    var total_discount : int = base_discount + membership_bonus + location_bonus;
    var max_discount : int = when { user_type == "premium" => 45, else => 35 };
    var final_discount : int = total_discount > max_discount ? max_discount : total_discount;
    
    std::println("用户分析:");
    std::println("  年龄: " + lang::to_string(user_age) + ", 收入: " + lang::to_string(income));
    std::println("  购买历史: " + lang::to_string(purchase_history) + "次");
    std::println("  用户类型: " + user_type);
    std::println("  会员等级: " + membership);
    std::println("  推荐类别: " + recommended_category);
    std::println("  折扣计算: 基础" + lang::to_string(base_discount) + "% + 会员" + lang::to_string(membership_bonus) + "% + 地区" + lang::to_string(location_bonus) + "%");
    std::println("  最终折扣: " + lang::to_string(final_discount) + "%");
    std::println("");
}

// 复杂的库存管理系统
fn inventory_management_system() {
    std::println("🔥 库存管理系统");
    std::println("==============");
    
    var current_stock : int = 1200;
    var daily_sales : int = 150;
    var lead_time : int = 7;
    var safety_stock : int = 300;
    var supplier_rating : int = 85;
    var season_factor : int = 120; // 120% = 20% increase
    var storage_cost : int = 5;
    
    // 库存状态评估
    var reorder_level : int = (daily_sales * lead_time) + safety_stock;
    var stock_status : string = when { current_stock <= safety_stock => "critical", current_stock <= reorder_level => "low", current_stock <= reorder_level * 2 => "normal", else => "high" };
    
    // 需求预测
    var adjusted_demand : int = (daily_sales * season_factor) / 100;
    var forecast_demand : int = adjusted_demand * lead_time;
    
    // 订购决策
    var order_quantity : int = when { stock_status == "critical" => forecast_demand * 2, stock_status == "low" => forecast_demand + safety_stock, stock_status == "normal" => forecast_demand, else => forecast_demand / 2 };
    
    // 供应商选择
    var supplier_choice : string = when { stock_status == "critical" && supplier_rating >= 80 => "express_supplier", supplier_rating >= 85 => "primary_supplier", supplier_rating >= 70 => "backup_supplier", else => "emergency_supplier" };
    
    // 成本计算
    var unit_cost : int = when { supplier_choice == "express_supplier" => 35, supplier_choice == "primary_supplier" => 30, supplier_choice == "backup_supplier" => 32, else => 40 };
    var total_cost : int = (order_quantity * unit_cost) + (current_stock * storage_cost);
    
    std::println("库存分析:");
    std::println("  当前库存: " + lang::to_string(current_stock) + " (状态: " + stock_status + ")");
    std::println("  重订货点: " + lang::to_string(reorder_level));
    std::println("  日销量: " + lang::to_string(daily_sales) + " -> 调整后: " + lang::to_string(adjusted_demand));
    std::println("  预测需求: " + lang::to_string(forecast_demand));
    std::println("  建议订购: " + lang::to_string(order_quantity) + " 单位");
    std::println("  供应商: " + supplier_choice + " (评级: " + lang::to_string(supplier_rating) + "%)");
    std::println("  单位成本: " + lang::to_string(unit_cost));
    std::println("  总成本: " + lang::to_string(total_cost));
    std::println("");
}

// 复杂的客户服务系统
fn customer_service_system() {
    std::println("🔥 客户服务系统");
    std::println("==============");
    
    var ticket_type : string = "technical";
    var priority_level : int = 3; // 1-5 scale
    var customer_tier : string = "gold";
    var response_time : int = 45; // minutes
    var agent_experience : int = 8; // years
    var complexity_score : int = 7; // 1-10 scale
    var escalation_needed : string = "";
    
    // 处理优先级
    var handling_priority : string = escalation_needed ?? when { customer_tier == "platinum" && priority_level >= 4 => "urgent", customer_tier == "gold" && priority_level >= 3 => "high", priority_level >= 4 => "high", priority_level >= 2 => "medium", else => "low" };
    
    // 分配策略
    var agent_assignment : string = when { handling_priority == "urgent" && agent_experience >= 5 => "senior_agent", handling_priority == "high" && agent_experience >= 3 => "experienced_agent", complexity_score >= 8 => "specialist", else => "standard_agent" };
    
    // SLA目标
    var sla_target : int = when { handling_priority == "urgent" => 30, handling_priority == "high" => 60, handling_priority == "medium" => 120, else => 240 }; // minutes
    
    // 满意度预测
    var satisfaction_score : int = when { response_time <= sla_target && agent_assignment == "senior_agent" => 95, response_time <= sla_target => 85, response_time <= sla_target * 2 => 70, else => 50 };
    
    // 成本计算
    var handling_cost : int = when { agent_assignment == "senior_agent" => 50, agent_assignment == "experienced_agent" => 35, agent_assignment == "specialist" => 45, else => 25 };
    var escalation_cost : int = when { complexity_score >= 8 => 30, complexity_score >= 6 => 20, else => 0 };
    var total_cost : int = handling_cost + escalation_cost;
    
    std::println("客服工单分析:");
    std::println("  工单类型: " + ticket_type + " (复杂度: " + lang::to_string(complexity_score) + "/10)");
    std::println("  客户等级: " + customer_tier + " (优先级: " + lang::to_string(priority_level) + "/5)");
    std::println("  处理优先级: " + handling_priority);
    std::println("  分配策略: " + agent_assignment);
    std::println("  SLA目标: " + lang::to_string(sla_target) + "分钟");
    std::println("  响应时间: " + lang::to_string(response_time) + "分钟");
    std::println("  预期满意度: " + lang::to_string(satisfaction_score) + "%");
    std::println("  处理成本: " + lang::to_string(total_cost));
    std::println("");
}

fn main() : int {
    std::println("🔥 CodeNothing 稳定复杂语法糖测试套件");
    std::println("=================================");
    std::println("");
    
    employee_management_system();
    product_recommendation_system();
    inventory_management_system();
    customer_service_system();
    
    std::println("🎉 所有稳定复杂测试完美完成!");
