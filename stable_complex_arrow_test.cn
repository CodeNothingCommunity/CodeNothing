// 🔥 CodeNothing 稳定复杂箭头函数测试
// 展示箭头函数在复杂但稳定场景中的应用

lib <io>;

// 复杂的金融计算系统
fn complex_financial_calculations() {
    std::println("🔥 复杂金融计算系统");
    std::println("==================");
    
    // 复杂的信用评分计算
    var calculate_credit_score = (income: int, debt: int, age: int, employment_years: int) => {
        var debt_ratio = debt * 100 / income;
        var age_factor = when { age >= 65 => 95, age >= 45 => 100, age >= 25 => 105, else => 90 };
        var employment_factor = when { employment_years >= 10 => 120, employment_years >= 5 => 110, employment_years >= 2 => 100, else => 85 };
        var debt_penalty = when { debt_ratio >= 80 => -200, debt_ratio >= 60 => -150, debt_ratio >= 40 => -100, debt_ratio >= 20 => -50, else => 0 };
        var base_score = 600;
        return base_score + (age_factor * employment_factor / 100) + debt_penalty;
    };
    
    // 复杂的投资回报计算
    var calculate_investment_return = (principal: int, rate: int, years: int, risk_level: int) => {
        var risk_adjustment = when { risk_level >= 80 => 150, risk_level >= 60 => 120, risk_level >= 40 => 100, risk_level >= 20 => 80, else => 60 };
        var time_bonus = when { years >= 20 => 130, years >= 10 => 115, years >= 5 => 105, else => 100 };
        var adjusted_rate = (rate * risk_adjustment * time_bonus) / 10000;
        return principal + (principal * adjusted_rate * years / 100);
    };
    
    // 复杂的贷款利率计算
    var calculate_loan_rate = (credit_score: int, loan_amount: int, loan_term: int) => {
        var base_rate = 500; // 5.00%
        var credit_adjustment = when { credit_score >= 800 => -100, credit_score >= 750 => -50, credit_score >= 700 => 0, credit_score >= 650 => 50, else => 100 };
        var amount_adjustment = when { loan_amount >= 1000000 => -25, loan_amount >= 500000 => -10, loan_amount >= 200000 => 0, else => 25 };
        var term_adjustment = when { loan_term >= 30 => 75, loan_term >= 20 => 50, loan_term >= 15 => 25, else => 0 };
        return base_rate + credit_adjustment + amount_adjustment + term_adjustment;
    };
    
    std::println("信用评分算法: " + lang::to_string(calculate_credit_score));
    std::println("投资回报计算: " + lang::to_string(calculate_investment_return));
    std::println("贷款利率计算: " + lang::to_string(calculate_loan_rate));
    std::println("");
}

// 复杂的业务决策系统
fn complex_business_decisions() {
    std::println("🔥 复杂业务决策系统");
    std::println("==================");
    
    // 复杂的定价策略
    var calculate_dynamic_pricing = (base_price: int, demand_level: int, competition_price: int, inventory_level: int) => {
        var demand_multiplier = when { demand_level >= 90 => 130, demand_level >= 70 => 115, demand_level >= 50 => 100, demand_level >= 30 => 90, else => 80 };
        var competition_adjustment = when { competition_price > base_price * 110 / 100 => 105, competition_price > base_price * 105 / 100 => 102, competition_price < base_price * 95 / 100 => 98, competition_price < base_price * 90 / 100 => 95, else => 100 };
        var inventory_pressure = when { inventory_level >= 90 => 85, inventory_level >= 70 => 95, inventory_level >= 30 => 100, inventory_level >= 10 => 110, else => 120 };
        return (base_price * demand_multiplier * competition_adjustment * inventory_pressure) / 1000000;
    };
    
    // 复杂的员工绩效评估
    var evaluate_employee_performance = (sales_target: int, sales_achieved: int, customer_satisfaction: int, team_collaboration: int, innovation_score: int) => {
        var sales_performance = (sales_achieved * 100) / sales_target;
        var sales_score = when { sales_performance >= 120 => 100, sales_performance >= 100 => 90, sales_performance >= 80 => 75, sales_performance >= 60 => 60, else => 40 };
        var satisfaction_score = when { customer_satisfaction >= 95 => 100, customer_satisfaction >= 85 => 90, customer_satisfaction >= 75 => 80, customer_satisfaction >= 65 => 70, else => 50 };
        var collaboration_score = when { team_collaboration >= 90 => 100, team_collaboration >= 80 => 90, team_collaboration >= 70 => 80, team_collaboration >= 60 => 70, else => 60 };
        var innovation_bonus = when { innovation_score >= 80 => 20, innovation_score >= 60 => 15, innovation_score >= 40 => 10, innovation_score >= 20 => 5, else => 0 };
        return (sales_score * 40 + satisfaction_score * 30 + collaboration_score * 20) / 100 + innovation_bonus;
    };
    
    // 复杂的市场进入策略
    var assess_market_entry_viability = (market_size: int, competition_intensity: int, regulatory_barriers: int, capital_required: int, expected_roi: int) => {
        var market_attractiveness = when { market_size >= 1000000 => 100, market_size >= 500000 => 80, market_size >= 100000 => 60, market_size >= 50000 => 40, else => 20 };
        var competition_threat = when { competition_intensity >= 90 => -50, competition_intensity >= 70 => -30, competition_intensity >= 50 => -15, competition_intensity >= 30 => -5, else => 0 };
        var regulatory_risk = when { regulatory_barriers >= 80 => -40, regulatory_barriers >= 60 => -25, regulatory_barriers >= 40 => -15, regulatory_barriers >= 20 => -5, else => 0 };
        var capital_efficiency = when { capital_required <= 100000 => 20, capital_required <= 500000 => 10, capital_required <= 1000000 => 0, capital_required <= 5000000 => -10, else => -20 };
        var roi_bonus = when { expected_roi >= 30 => 30, expected_roi >= 20 => 20, expected_roi >= 15 => 15, expected_roi >= 10 => 10, else => 0 };
        return market_attractiveness + competition_threat + regulatory_risk + capital_efficiency + roi_bonus;
    };
    
    std::println("动态定价策略: " + lang::to_string(calculate_dynamic_pricing));
    std::println("员工绩效评估: " + lang::to_string(evaluate_employee_performance));
    std::println("市场进入评估: " + lang::to_string(assess_market_entry_viability));
    std::println("");
}

// 复杂的运营优化系统
fn complex_operations_optimization() {
    std::println("🔥 复杂运营优化系统");
    std::println("==================");
    
    // 复杂的库存优化
    var optimize_inventory = (current_stock: int, daily_demand: int, lead_time: int, storage_cost: int, stockout_cost: int) => {
        var safety_stock = daily_demand * lead_time / 2;
        var reorder_point = daily_demand * lead_time + safety_stock;
        var storage_efficiency = when { storage_cost <= 5 => 120, storage_cost <= 10 => 110, storage_cost <= 20 => 100, storage_cost <= 50 => 90, else => 80 };
        var stockout_risk = when { stockout_cost >= 1000 => 150, stockout_cost >= 500 => 130, stockout_cost >= 200 => 110, stockout_cost >= 100 => 100, else => 90 };
        var optimal_order_quantity = (reorder_point * storage_efficiency * stockout_risk) / 10000;
        return when { optimal_order_quantity > current_stock * 3 => current_stock * 3, optimal_order_quantity < daily_demand => daily_demand, else => optimal_order_quantity };
    };
    
    // 复杂的生产调度
    var optimize_production_schedule = (machine_capacity: int, order_urgency: int, material_availability: int, labor_efficiency: int, quality_requirements: int) => {
        var capacity_utilization = when { machine_capacity >= 95 => 100, machine_capacity >= 85 => 95, machine_capacity >= 75 => 90, machine_capacity >= 60 => 85, else => 80 };
        var urgency_multiplier = when { order_urgency >= 90 => 150, order_urgency >= 70 => 130, order_urgency >= 50 => 110, order_urgency >= 30 => 100, else => 90 };
        var material_constraint = when { material_availability >= 95 => 100, material_availability >= 80 => 90, material_availability >= 60 => 75, material_availability >= 40 => 60, else => 40 };
        var labor_factor = when { labor_efficiency >= 90 => 110, labor_efficiency >= 80 => 105, labor_efficiency >= 70 => 100, labor_efficiency >= 60 => 95, else => 90 };
        var quality_adjustment = when { quality_requirements >= 95 => 80, quality_requirements >= 85 => 90, quality_requirements >= 75 => 95, quality_requirements >= 65 => 100, else => 105 };
        return (capacity_utilization * urgency_multiplier * material_constraint * labor_factor * quality_adjustment) / 100000000;
    };
    
    // 复杂的供应商选择
    var select_optimal_supplier = (price_score: int, quality_score: int, delivery_reliability: int, financial_stability: int, innovation_capability: int) => {
        var price_weight = price_score * 30; // 30% 权重
        var quality_weight = quality_score * 35; // 35% 权重
        var delivery_weight = delivery_reliability * 20; // 20% 权重
        var stability_weight = financial_stability * 10; // 10% 权重
        var innovation_weight = innovation_capability * 5; // 5% 权重
        var total_score = (price_weight + quality_weight + delivery_weight + stability_weight + innovation_weight) / 100;
        var risk_adjustment = when { financial_stability <= 30 => -20, financial_stability <= 50 => -10, financial_stability <= 70 => -5, else => 0 };
        var strategic_bonus = when { innovation_capability >= 80 && quality_score >= 85 => 15, innovation_capability >= 60 || quality_score >= 80 => 8, else => 0 };
        return total_score + risk_adjustment + strategic_bonus;
    };
    
    std::println("库存优化算法: " + lang::to_string(optimize_inventory));
    std::println("生产调度优化: " + lang::to_string(optimize_production_schedule));
    std::println("供应商选择: " + lang::to_string(select_optimal_supplier));
    std::println("");
}

// 复杂的客户关系管理
fn complex_customer_relationship_management() {
    std::println("🔥 复杂客户关系管理");
    std::println("==================");
    
    // 复杂的客户价值评估
    var assess_customer_lifetime_value = (annual_revenue: int, retention_rate: int, acquisition_cost: int, service_cost: int, years_relationship: int) => {
        var revenue_trend = when { years_relationship >= 5 => 110, years_relationship >= 3 => 105, years_relationship >= 1 => 100, else => 95 };
        var retention_multiplier = when { retention_rate >= 95 => 150, retention_rate >= 85 => 130, retention_rate >= 75 => 110, retention_rate >= 60 => 100, else => 80 };
        var cost_efficiency = (annual_revenue * 100) / (acquisition_cost + service_cost + 1);
        var efficiency_bonus = when { cost_efficiency >= 500 => 20, cost_efficiency >= 300 => 15, cost_efficiency >= 200 => 10, cost_efficiency >= 100 => 5, else => 0 };
        var projected_value = (annual_revenue * revenue_trend * retention_multiplier) / 10000;
        return projected_value + efficiency_bonus;
    };
    
    // 复杂的客户满意度预测
    var predict_customer_satisfaction = (product_quality: int, service_quality: int, price_competitiveness: int, response_time: int, problem_resolution: int) => {
        var quality_impact = (product_quality * 25 + service_quality * 25) / 100; // 50% 权重
        var value_perception = price_competitiveness * 20; // 20% 权重
        var service_efficiency = (response_time * 15 + problem_resolution * 15) / 100; // 30% 权重
        var base_satisfaction = quality_impact + value_perception + service_efficiency;
        var excellence_bonus = when { product_quality >= 90 && service_quality >= 90 => 10, product_quality >= 85 || service_quality >= 85 => 5, else => 0 };
        var service_penalty = when { response_time <= 50 || problem_resolution <= 60 => -15, response_time <= 70 || problem_resolution <= 75 => -8, else => 0 };
        return base_satisfaction + excellence_bonus + service_penalty;
    };
    
    // 复杂的客户流失风险评估
    var assess_churn_risk = (usage_frequency: int, support_tickets: int, payment_delays: int, competitor_activity: int, satisfaction_trend: int) => {
        var usage_risk = when { usage_frequency <= 20 => 40, usage_frequency <= 40 => 25, usage_frequency <= 60 => 15, usage_frequency <= 80 => 5, else => 0 };
        var support_risk = when { support_tickets >= 10 => 35, support_tickets >= 5 => 20, support_tickets >= 2 => 10, support_tickets >= 1 => 5, else => 0 };
        var payment_risk = when { payment_delays >= 3 => 50, payment_delays >= 2 => 30, payment_delays >= 1 => 15, else => 0 };
        var competition_risk = when { competitor_activity >= 80 => 25, competitor_activity >= 60 => 15, competitor_activity >= 40 => 8, competitor_activity >= 20 => 3, else => 0 };
        var satisfaction_risk = when { satisfaction_trend <= 30 => 60, satisfaction_trend <= 50 => 40, satisfaction_trend <= 70 => 20, satisfaction_trend <= 85 => 10, else => 0 };
        return usage_risk + support_risk + payment_risk + competition_risk + satisfaction_risk;
    };
    
    std::println("客户价值评估: " + lang::to_string(assess_customer_lifetime_value));
    std::println("满意度预测: " + lang::to_string(predict_customer_satisfaction));
    std::println("流失风险评估: " + lang::to_string(assess_churn_risk));
    std::println("");
}

