// 修复版本的斐波那契程序（暂时不使用记忆化）

lib <io>;

fn main() {
    std::println("斐波那契第10项");
    std::println("================================");
    var result := fibonacci(10);
    std::println("F(10) = " + lang::to_string(result));
}

fn fibonacci(n: int): int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}
