// 🔥 CodeNothing 最终复杂语法糖测试
// 展示高级语法糖在复杂实际场景中的强大应用

lib <io>;

// 复杂的企业管理系统
fn enterprise_management_system() {
    std::println("🔥 企业管理系统");
    std::println("==============");
    
    var employee_role : string = "senior_engineer";
    var years_experience : int = 8;
    var performance_rating : int = 92;
    var department : string = "technology";
    var is_manager : bool = false;
    var special_project : string = "";
    
    // 复杂的职级评定系统
    var job_level : string = special_project ?? when { is_manager && years_experience >= 10 => "director", is_manager && years_experience >= 5 => "manager", employee_role == "senior_engineer" && performance_rating >= 90 => "tech_lead", employee_role == "senior_engineer" => "senior", employee_role == "engineer" && years_experience >= 3 => "mid_level", else => "junior" };
    
    // 薪资计算系统
    var base_salary : int = 60000;
    var performance_bonus : int = when { performance_rating >= 95 => 15000, performance_rating >= 90 => 12000, performance_rating >= 85 => 8000, performance_rating >= 80 => 5000, else => 2000 };
    var department_multiplier : int = when { department == "technology" => 120, department == "sales" => 115, department == "marketing" => 110, else => 100 };
    var experience_bonus : int = years_experience * 1000;
    
    var total_compensation : int = ((base_salary * department_multiplier) / 100) + performance_bonus + experience_bonus;
    
    std::println("员工薪酬分析:");
    std::println("  角色: " + employee_role + " -> 职级: " + job_level);
    std::println("  经验: " + lang::to_string(years_experience) + "年, 绩效: " + lang::to_string(performance_rating) + "分");
    std::println("  部门: " + department + " (倍数: " + lang::to_string(department_multiplier) + "%)");
    std::println("  基础薪资: " + lang::to_string(base_salary));
    std::println("  绩效奖金: " + lang::to_string(performance_bonus));
    std::println("  经验奖金: " + lang::to_string(experience_bonus));
    std::println("  总薪酬: " + lang::to_string(total_compensation));
    std::println("");
}

// 复杂的智能推荐引擎
fn intelligent_recommendation_engine() {
    std::println("🔥 智能推荐引擎");
    std::println("==============");
    
    var user_age : int = 32;
    var user_income : int = 75000;
    var browsing_history : int = 25; // 浏览次数
    var purchase_count : int = 8;
    var last_purchase_category : string = "electronics";
    var current_season : string = "winter";
    var has_premium : bool = true;
    var location : string = "urban";
    
    // 用户画像分析
    var user_profile : string = when { user_income >= 100000 && purchase_count >= 15 => "vip_customer", user_income >= 60000 && purchase_count >= 8 => "premium_customer", user_income >= 40000 && purchase_count >= 5 => "regular_customer", purchase_count >= 3 => "occasional_buyer", else => "new_visitor" };
    
    // 推荐类别决策
    var recommended_items : string = when { last_purchase_category == "electronics" && current_season == "winter" => "smart_home_devices", last_purchase_category == "clothing" && current_season == "winter" => "winter_fashion", user_profile == "vip_customer" => "luxury_collection", user_profile == "premium_customer" && has_premium => "exclusive_items", location == "urban" && user_age >= 25 => "lifestyle_products", else => "trending_items" };
    
    // 个性化折扣计算
    var base_discount : int = when { user_profile == "vip_customer" => 25, user_profile == "premium_customer" => 20, user_profile == "regular_customer" => 15, user_profile == "occasional_buyer" => 10, else => 5 };
    var loyalty_bonus : int = when { purchase_count >= 20 => 10, purchase_count >= 10 => 7, purchase_count >= 5 => 5, else => 0 };
    var seasonal_discount : int = when { current_season == "winter" && recommended_items == "winter_fashion" => 15, current_season == "winter" => 8, else => 0 };
    
    var total_discount : int = base_discount + loyalty_bonus + seasonal_discount;
    var max_allowed_discount : int = when { user_profile == "vip_customer" => 50, user_profile == "premium_customer" => 40, else => 30 };
    var final_discount : int = total_discount > max_allowed_discount ? max_allowed_discount : total_discount;
    
    // 推荐优先级
    var recommendation_score : int = (browsing_history * 2) + (purchase_count * 5) + final_discount;
    var priority_level : string = when { recommendation_score >= 100 => "high_priority", recommendation_score >= 60 => "medium_priority", recommendation_score >= 30 => "low_priority", else => "standard" };
    
    std::println("推荐引擎分析:");
    std::println("  用户画像: " + user_profile);
    std::println("  年龄: " + lang::to_string(user_age) + ", 收入: " + lang::to_string(user_income));
    std::println("  购买历史: " + lang::to_string(purchase_count) + "次, 浏览: " + lang::to_string(browsing_history) + "次");
    std::println("  推荐类别: " + recommended_items);
    std::println("  折扣构成: 基础" + lang::to_string(base_discount) + "% + 忠诚度" + lang::to_string(loyalty_bonus) + "% + 季节性" + lang::to_string(seasonal_discount) + "%");
    std::println("  最终折扣: " + lang::to_string(final_discount) + "%");
    std::println("  推荐分数: " + lang::to_string(recommendation_score));
    std::println("  优先级: " + priority_level);
    std::println("");
}

// 复杂的风险评估系统
fn risk_assessment_system() {
    std::println("🔥 风险评估系统");
    std::println("==============");
    
    var credit_score : int = 750;
    var annual_income : int = 85000;
    var debt_ratio : int = 30; // 负债收入比 %
    var employment_duration : int = 6; // 年
    var loan_amount : int = 300000;
    var property_value : int = 400000;
    var down_payment : int = 80000;
    var market_conditions : string = "stable";
    
    // 信用风险评级
    var credit_risk : string = when { credit_score >= 800 && debt_ratio <= 20 => "excellent", credit_score >= 750 && debt_ratio <= 30 => "very_good", credit_score >= 700 && debt_ratio <= 40 => "good", credit_score >= 650 => "fair", else => "poor" };
    
    // 收入稳定性评估
    var income_stability : string = when { employment_duration >= 10 && annual_income >= 100000 => "very_stable", employment_duration >= 5 && annual_income >= 60000 => "stable", employment_duration >= 3 => "moderate", employment_duration >= 1 => "unstable", else => "very_unstable" };
    
    // 贷款价值比计算
    var loan_to_value : int = (loan_amount * 100) / property_value;
    var ltv_risk : string = when { loan_to_value <= 60 => "low", loan_to_value <= 80 => "moderate", loan_to_value <= 90 => "high", else => "very_high" };
    
    // 综合风险评估
    var overall_risk : string = when { credit_risk == "excellent" && income_stability == "very_stable" && ltv_risk == "low" => "minimal", credit_risk == "very_good" && income_stability == "stable" && ltv_risk == "moderate" => "low", credit_risk == "good" && ltv_risk == "high" => "medium", credit_risk == "fair" || income_stability == "unstable" => "high", else => "very_high" };
    
    // 利率定价
    var base_rate : int = 350; // 3.50% (以基点表示)
    var risk_premium : int = when { overall_risk == "minimal" => 0, overall_risk == "low" => 25, overall_risk == "medium" => 50, overall_risk == "high" => 100, else => 200 };
    var market_adjustment : int = when { market_conditions == "favorable" => -25, market_conditions == "stable" => 0, market_conditions == "volatile" => 25, else => 50 };
    
    var final_rate : int = base_rate + risk_premium + market_adjustment;
    
    // 审批决策
    var approval_decision : string = when { overall_risk == "minimal" || overall_risk == "low" => "approved", overall_risk == "medium" && credit_score >= 700 => "conditional_approval", overall_risk == "high" && down_payment >= 100000 => "manual_review", else => "declined" };
    
    std::println("风险评估报告:");
    std::println("  申请人: 信用分" + lang::to_string(credit_score) + ", 年收入" + lang::to_string(annual_income) + ", 负债比" + lang::to_string(debt_ratio) + "%");
    std::println("  贷款信息: 金额" + lang::to_string(loan_amount) + ", 房产价值" + lang::to_string(property_value) + ", 首付" + lang::to_string(down_payment));
    std::println("  风险评级:");
    std::println("    信用风险: " + credit_risk);
    std::println("    收入稳定性: " + income_stability);
    std::println("    贷款价值比: " + lang::to_string(loan_to_value) + "% (" + ltv_risk + ")");
    std::println("    综合风险: " + overall_risk);
    std::println("  定价: 基准" + lang::to_string(base_rate) + "bp + 风险溢价" + lang::to_string(risk_premium) + "bp + 市场调整" + lang::to_string(market_adjustment) + "bp");
    std::println("  最终利率: " + lang::to_string(final_rate / 100) + "." + lang::to_string(final_rate % 100) + "%");
    std::println("  审批决策: " + approval_decision);
    std::println("");
}

// 复杂的供应链优化
fn supply_chain_optimization() {
    std::println("🔥 供应链优化系统");
    std::println("================");
    
    var current_inventory : int = 2500;
    var daily_demand : int = 300;
    var lead_time : int = 5; // 天
    var safety_stock : int = 800;
    var supplier_reliability : int = 88; // %
    var transportation_cost : int = 150; // 每批次
    var storage_cost_per_unit : int = 2; // 每天每单位
    var season : string = "peak";
    var market_trend : string = "growing";
    
    // 库存状态评估
    var reorder_point : int = (daily_demand * lead_time) + safety_stock;
    var inventory_status : string = when { current_inventory <= safety_stock => "critical", current_inventory <= reorder_point => "low", current_inventory <= reorder_point * 2 => "normal", else => "high" };
    
    // 需求预测调整
    var demand_multiplier : int = when { season == "peak" && market_trend == "growing" => 130, season == "peak" => 120, market_trend == "growing" => 110, season == "low" => 80, else => 100 };
    var adjusted_daily_demand : int = (daily_demand * demand_multiplier) / 100;
    
    // 订购策略
    var base_order_quantity : int = adjusted_daily_demand * lead_time * 2;
    var order_quantity : int = when { inventory_status == "critical" => base_order_quantity * 2, inventory_status == "low" && supplier_reliability >= 90 => base_order_quantity, inventory_status == "low" => base_order_quantity + safety_stock, inventory_status == "normal" => base_order_quantity, else => base_order_quantity / 2 };
    
    // 供应商选择
    var supplier_choice : string = when { inventory_status == "critical" && supplier_reliability >= 85 => "premium_supplier", inventory_status == "low" && supplier_reliability >= 80 => "primary_supplier", supplier_reliability >= 75 => "primary_supplier", else => "backup_supplier" };
    
    // 成本计算
    var unit_cost : int = when { supplier_choice == "premium_supplier" => 28, supplier_choice == "primary_supplier" => 25, else => 30 };
    var total_procurement_cost : int = order_quantity * unit_cost + transportation_cost;
    var storage_cost : int = (current_inventory + order_quantity) * storage_cost_per_unit * lead_time;
    var total_cost : int = total_procurement_cost + storage_cost;
    
    // 风险评估
    var supply_risk : string = when { supplier_reliability >= 95 => "low", supplier_reliability >= 85 => "medium", supplier_reliability >= 70 => "high", else => "very_high" };
    var inventory_risk : string = when { inventory_status == "critical" => "high", inventory_status == "low" => "medium", else => "low" };
    
    std::println("供应链优化分析:");
    std::println("  库存状态: " + inventory_status + " (当前" + lang::to_string(current_inventory) + ", 重订货点" + lang::to_string(reorder_point) + ")");
    std::println("  需求预测: 基础" + lang::to_string(daily_demand) + " -> 调整后" + lang::to_string(adjusted_daily_demand) + " (倍数" + lang::to_string(demand_multiplier) + "%)");
    std::println("  订购策略: " + supplier_choice + ", 数量" + lang::to_string(order_quantity) + "单位");
    std::println("  成本分析: 采购" + lang::to_string(total_procurement_cost) + " + 仓储" + lang::to_string(storage_cost) + " = " + lang::to_string(total_cost));
    std::println("  风险评估: 供应" + supply_risk + ", 库存" + inventory_risk);
    std::println("");
}

