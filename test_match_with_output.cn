// 带输出的模式匹配测试

lib <io>;

fn main() : int {
    std::println("🚀 CodeNothing 模式匹配功能测试");
    std::println("================================");
    
    // 测试整数匹配
    var x : int = 42;
    var result1 : string = match x {
        42 => "找到答案!",
        0 => "零",
        _ => "其他数字",
    };
    std::println("整数匹配测试: x = 42, 结果 = " + result1);
    
    // 测试字符串匹配
    var name : string = "Alice";
    var result2 : string = match name {
        "Alice" => "你好, Alice!",
        "Bob" => "嗨, Bob!",
        _ => "你好, 陌生人!",
    };
    std::println("字符串匹配测试: name = Alice, 结果 = " + result2);
    
    // 测试布尔值匹配
    var flag : bool = true;
    var result3 : string = match flag {
        true => "开启",
        false => "关闭",
    };
    std::println("布尔值匹配测试: flag = true, 结果 = " + result3);
    
    // 测试通配符匹配
    var unknown : int = 999;
    var result4 : string = match unknown {
        1 => "一",
        2 => "二",
        3 => "三",
        _ => "未知数字",
    };
    std::println("通配符匹配测试: unknown = 999, 结果 = " + result4);
    
    std::println("");
    std::println("✅ 所有模式匹配测试通过!");
    std::println("🎉 CodeNothing 现在支持模式匹配功能!");
    
    return 0;
}
