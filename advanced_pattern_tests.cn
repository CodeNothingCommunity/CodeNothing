// 🎯 CodeNothing 高级模式匹配测试
// 测试复杂场景和性能

lib <io>;

// 测试1: 深度嵌套模式匹配
fn test_deep_nesting() {
    std::println("🔸 测试1: 深度嵌套模式匹配");
    std::println("========================");
    
    var level1 : int = 1;
    var level2 : int = 2;
    var level3 : int = 3;
    var level4 : int = 4;
    
    var result : string = match level1 {
        1 => match level2 {
            1 => "路径: 1-1",
            2 => match level3 {
                1 => "路径: 1-2-1",
                2 => "路径: 1-2-2", 
                3 => match level4 {
                    1 => "路径: 1-2-3-1",
                    2 => "路径: 1-2-3-2",
                    3 => "路径: 1-2-3-3",
                    4 => "路径: 1-2-3-4 (最深层)",
                    _ => "路径: 1-2-3-其他",
                },
                _ => "路径: 1-2-其他",
            },
            _ => "路径: 1-其他",
        },
        2 => "路径: 第二层",
        _ => "路径: 其他层",
    };
    
    std::println("四层嵌套结果: " + result);
    std::println("");
}

// 测试2: 大量模式匹配性能
fn test_many_patterns() {
    std::println("🔸 测试2: 大量模式性能测试");
    std::println("========================");
    
    var test_value : int = 42;
    
    var result : string = match test_value {
        1 => "一", 2 => "二", 3 => "三", 4 => "四", 5 => "五",
        6 => "六", 7 => "七", 8 => "八", 9 => "九", 10 => "十",
        11 => "十一", 12 => "十二", 13 => "十三", 14 => "十四", 15 => "十五",
        16 => "十六", 17 => "十七", 18 => "十八", 19 => "十九", 20 => "二十",
        21 => "二十一", 22 => "二十二", 23 => "二十三", 24 => "二十四", 25 => "二十五",
        26 => "二十六", 27 => "二十七", 28 => "二十八", 29 => "二十九", 30 => "三十",
        31 => "三十一", 32 => "三十二", 33 => "三十三", 34 => "三十四", 35 => "三十五",
        36 => "三十六", 37 => "三十七", 38 => "三十八", 39 => "三十九", 40 => "四十",
        41 => "四十一", 42 => "四十二", 43 => "四十三", 44 => "四十四", 45 => "四十五",
        _ => "超出范围",
    };
    
    std::println("在45个模式中匹配值42: " + result);
    std::println("");
}

// 测试3: 复杂字符串模式
fn test_complex_strings() {
    std::println("🔸 测试3: 复杂字符串模式");
    std::println("======================");
    
    var command : string = "save_file";
    
    var action : string = match command {
        "new_file" => "创建新文件",
        "open_file" => "打开文件",
        "save_file" => "保存文件",
        "save_as" => "另存为",
        "close_file" => "关闭文件",
        "exit_app" => "退出应用",
        "copy_text" => "复制文本",
        "paste_text" => "粘贴文本",
        "cut_text" => "剪切文本",
        "undo_action" => "撤销操作",
        "redo_action" => "重做操作",
        "find_text" => "查找文本",
        "replace_text" => "替换文本",
        "print_doc" => "打印文档",
        "export_data" => "导出数据",
        "import_data" => "导入数据",
        _ => "未知命令",
    };
    
    std::println("命令 '" + command + "' 执行: " + action);
    std::println("");
}

// 测试4: 布尔逻辑组合
fn test_boolean_combinations() {
    std::println("🔸 测试4: 复杂布尔逻辑");
    std::println("====================");
    
    var is_admin : bool = true;
    var is_logged_in : bool = true;
    var has_permission : bool = false;
    
    var access : string = match is_admin {
        true => match is_logged_in {
            true => match has_permission {
                true => "完全访问权限",
                false => "管理员权限但无特殊许可",
            },
            false => "管理员未登录",
        },
        false => match is_logged_in {
            true => match has_permission {
                true => "普通用户有权限",
                false => "普通用户无权限",
            },
            false => "用户未登录",
        },
    };
    
    std::println("访问控制结果: " + access);
    std::println("");
}

// 测试5: HTTP状态码处理
fn test_http_status() {
    std::println("🔸 测试5: HTTP状态码处理");
    std::println("======================");
    
    var status : int = 404;
    
    var message : string = match status {
        200 => "OK - 请求成功",
        201 => "Created - 已创建",
        204 => "No Content - 无内容",
        301 => "Moved Permanently - 永久移动",
        302 => "Found - 临时移动",
        400 => "Bad Request - 请求错误",
        401 => "Unauthorized - 未授权",
        403 => "Forbidden - 禁止访问",
        404 => "Not Found - 未找到",
        405 => "Method Not Allowed - 方法不允许",
        500 => "Internal Server Error - 服务器内部错误",
        502 => "Bad Gateway - 网关错误",
        503 => "Service Unavailable - 服务不可用",
        _ => "Unknown Status Code - 未知状态码",
    };
    
    std::println("HTTP " + lang::to_string(status) + ": " + message);
    std::println("");
}

// 测试6: 游戏状态机
fn test_game_state() {
    std::println("🔸 测试6: 游戏状态机");
    std::println("==================");
    
    var state : string = "playing";
    var health : int = 75;
    var has_key : bool = true;
    
    var action : string = match state {
        "menu" => "显示主菜单",
        "loading" => "加载游戏",
        "playing" => match health {
            0 => "游戏结束",
            _ => match has_key {
                true => "可以开门前进",
                false => "需要寻找钥匙",
            },
        },
        "paused" => "游戏暂停",
        "gameover" => "显示结束画面",
        "victory" => "显示胜利画面",
        _ => "未知状态",
    };
    
    std::println("游戏状态: " + state);
    std::println("玩家血量: " + lang::to_string(health));
    std::println("下一步: " + action);
    std::println("");
}

fn main() : int {
    std::println("🚀 CodeNothing 高级模式匹配测试套件");
    std::println("===================================");
    std::println("");
    
    test_deep_nesting();
    test_many_patterns();
    test_complex_strings();
    test_boolean_combinations();
    test_http_status();
    test_game_state();
    
    std::println("🎉 所有高级测试完成!");
    std::println("");
    std::println("测试统计:");
    std::println("✅ 4层深度嵌套匹配");
    std::println("✅ 45个模式的大规模匹配");
    std::println("✅ 16个字符串模式匹配");
    std::println("✅ 3层布尔逻辑组合");
    std::println("✅ 13个HTTP状态码匹配");
    std::println("✅ 复杂游戏状态机逻辑");
    std::println("");
    std::println("🔥 CodeNothing 模式匹配功能强大且稳定!");
    
    return 0;
}
