// Comprehensive Include System Test
using ns lang;

// Test 1: Basic include - includes all functions and variables
include "include_test_utils.cn";

fn main() : int {
    lang::println("=== Comprehensive Include System Test ===");
    
    // Test basic include - all functions should be available
    lang::println("\n--- Test 1: Basic Include ---");
    var result1 : int = add_numbers(10, 20);
    lang::print("add_numbers(10, 20) = ");
    lang::println(lang::to_string(result1));
    
    var result2 : int = multiply_numbers(5, 6);
    lang::print("multiply_numbers(5, 6) = ");
    lang::println(lang::to_string(result2));
    
    var greeting : string = greet("Include System");
    lang::print("greet(\"Include System\") = ");
    lang::println(greeting);
    
    var area : int = calculate_area(8, 12);
    lang::print("calculate_area(8, 12) = ");
    lang::println(lang::to_string(area));
    
    // Test global variables
    lang::println("\n--- Test 2: Global Variables ---");
    lang::print("MAX_VALUE = ");
    lang::println(lang::to_string(MAX_VALUE));
    
    lang::print("MIN_VALUE = ");
    lang::println(lang::to_string(MIN_VALUE));
    
    // Test that all functions work correctly
    lang::println("\n--- Test 3: Function Verification ---");
    var result3 : int = multiply_numbers(7, 8);
    lang::print("multiply_numbers(7, 8) = ");
    lang::println(lang::to_string(result3));

    lang::print("MIN_VALUE = ");
    lang::println(lang::to_string(MIN_VALUE));
    
    lang::println("\n=== All Include Tests Passed! ===");
    return 0;
}
