// Math package for testing package system
package math version "1.0.0" author "CodeNothing Team";

// Export a simple function
export fn add(a: int, b: int) : int {
    return a + b;
}

// Export a constant
export const PI: float = 3.14159;

// Export a more complex function
export fn factorial(n: int) : int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Private function (not exported)
fn internal_helper(x: int) : int {
    return x * 2;
}

// Export a function that uses the private helper
export fn double_value(x: int) : int {
    return internal_helper(x);
}
