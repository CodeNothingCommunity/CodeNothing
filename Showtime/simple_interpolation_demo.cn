// CodeNothing String Interpolation Demo
// Simple demonstration of string interpolation features

using ns lang;

fn main() : int {
    lang::println("CodeNothing String Interpolation Demo");
    lang::println("====================================");
    
    // Basic variable interpolation
    var name : string = "CodeNothing";
    var version : string = "2.0";
    var year : int = 2024;
    
    var greeting : string = "Welcome to ${name} version ${version}!";
    lang::println(greeting);
    
    var info : string = "Released in ${year}";
    lang::println(info);
    
    // Empty expression handling
    var empty_test : string = "Before${}After";
    lang::println(empty_test);
    
    // Arithmetic expressions
    var a : int = 10;
    var b : int = 20;
    
    var sum_result : string = "Sum: ${a} + ${b} = ${a + b}";
    lang::println(sum_result);
    
    var product_result : string = "Product: ${a} * ${b} = ${a * b}";
    lang::println(product_result);
    
    // Boolean expressions
    var x : int = 15;
    var y : int = 25;
    
    var comparison : string = "Is ${x} less than ${y}? ${x < y}";
    lang::println(comparison);
    
    // Multiple interpolations in one string
    var multi : string = "Values: ${a}, ${b}, ${x}, ${y} - Sum: ${a + b + x + y}";
    lang::println(multi);
    
    // Function calls
    var factorial_5 : string = "5 factorial is ${factorial(5)}";
    lang::println(factorial_5);
    
    var max_result : string = "Max of ${a} and ${b} is ${max_value(a, b)}";
    lang::println(max_result);
    
    // Complex expressions
    var complex : string = "Complex: (${a} + ${b}) * 2 = ${(a + b) * 2}";
    lang::println(complex);
    
    lang::println("");
    lang::println("String interpolation demo completed successfully!");
    
    return 0;
}

// Helper function for factorial
fn factorial(n : int) : int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Helper function for max value
fn max_value(a : int, b : int) : int {
    if (a > b) {
        return a;
    }
    return b;
}
