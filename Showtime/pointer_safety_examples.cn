// 指针安全特性示例
// Pointer Safety Features Examples

fn safe_example_1_borrow_checking() {
    println("=== 安全示例1: 借用检查 ===");
    
    var data : int = 42;
    
    // 正确：可以有多个不可变引用
    var ref1 : &int = &data;
    var ref2 : &int = &data;
    var ref3 : &int = &data;
    
    println("通过ref1读取: " + *ref1);
    println("通过ref2读取: " + *ref2);
    println("通过ref3读取: " + *ref3);
    
    // 正确：不可变引用结束后，可以创建可变引用
    {
        var mut_ref : &mut int = &mut data;
        *mut_ref = 100;
        println("通过可变引用修改: " + *mut_ref);
    } // mut_ref 在这里结束作用域
    
    // 现在又可以创建不可变引用了
    var final_ref : &int = &data;
    println("最终值: " + *final_ref);
}

fn safe_example_2_lifetime_safety() {
    println("\n=== 安全示例2: 生命周期安全 ===");
    
    var outer_value : int = 123;
    var outer_ref : &int;
    
    {
        var inner_value : int = 456;
        // 注意：在真实的借用检查器中，这会被阻止
        // 因为inner_value的生命周期比outer_ref短
        // 这里我们演示概念
        
        println("内部作用域值: " + inner_value);
        
        // 安全的做法：只在同一作用域内使用引用
        var inner_ref : &int = &inner_value;
        println("通过内部引用: " + *inner_ref);
    } // inner_value 在这里被销毁
    
    // 安全：引用外部作用域的值
    outer_ref = &outer_value;
    println("通过外部引用: " + *outer_ref);
}

fn safe_example_3_null_pointer_safety() {
    println("\n=== 安全示例3: 空指针安全 ===");
    
    // 引用永远不能为空（编译时保证）
    var value : int = 42;
    var safe_ref : &int = &value; // 总是有效的
    
    // 原始指针可能为空，需要检查
    var maybe_null : *const int = null as *const int;
    
    // 安全的空指针检查
    if (maybe_null != null) {
        println("指针有效，值为: " + *maybe_null);
    } else {
        println("指针为空，无法解引用");
    }
    
    // 将引用转换为指针（总是安全的）
    var from_ref : *const int = safe_ref as *const int;
    if (from_ref != null) {
        println("从引用转换的指针值: " + *from_ref);
    }
}

fn safe_example_4_type_safety() {
    println("\n=== 安全示例4: 类型安全 ===");
    
    var int_value : int = 42;
    var float_value : float = 3.14;
    var string_value : string = "Hello";
    
    // 类型安全的引用
    var int_ref : &int = &int_value;
    var float_ref : &float = &float_value;
    var string_ref : &string = &string_value;
    
    println("整数引用: " + *int_ref);
    println("浮点引用: " + *float_ref);
    println("字符串引用: " + *string_ref);
    
    // 编译时类型检查防止错误的类型转换
    // 以下代码在编译时会被拒绝：
    // var wrong_ref : &string = &int_value; // 错误！类型不匹配
    
    // 安全的类型转换（如果支持）
    var int_as_float : float = int_value as float;
    var float_ref2 : &float = &int_as_float;
    println("转换后的浮点引用: " + *float_ref2);
}

fn safe_example_5_memory_safety() {
    println("\n=== 安全示例5: 内存安全 ===");
    
    // 栈分配的安全性
    var stack_value : int = 100;
    var stack_ref : &int = &stack_value;
    
    println("栈值通过引用: " + *stack_ref);
    
    // 数组边界安全
    var safe_array : array<int> = [1, 2, 3, 4, 5];
    var valid_index : int = 2;
    
    if (valid_index >= 0 && valid_index < 5) {
        var safe_element_ref : &int = &safe_array[valid_index];
        println("安全的数组元素访问: " + *safe_element_ref);
    }
    
    // 结构体字段的安全访问
    struct SafeStruct {
        field1: int,
        field2: string,
    }
    
    var safe_struct : SafeStruct = SafeStruct {
        field1: 42,
        field2: "Safe",
    };
    
    var field_ref : &int = &safe_struct.field1;
    println("结构体字段安全访问: " + *field_ref);
}

fn safe_example_6_reference_coercion() {
    println("\n=== 安全示例6: 引用强制转换 ===");
    
    var mutable_value : int = 42;
    
    // 可变引用可以自动转换为不可变引用
    var mut_ref : &mut int = &mut mutable_value;
    
    // 安全的强制转换：&mut T -> &T
    var immut_ref : &int = mut_ref as &int;
    
    println("通过可变引用: " + *mut_ref);
    println("通过不可变引用: " + *immut_ref);
    
    // 修改原始值
    *mut_ref = 100;
    println("修改后通过不可变引用: " + *immut_ref);
}

fn safe_example_7_function_safety(ref_param: &int, mut_ref_param: &mut int) {
    println("\n=== 安全示例7: 函数参数安全 ===");
    
    // 安全地读取不可变引用参数
    println("函数接收的不可变引用值: " + *ref_param);
    
    // 安全地修改可变引用参数
    *mut_ref_param = *ref_param * 2;
    println("函数修改可变引用后: " + *mut_ref_param);
}

fn safe_example_8_scope_safety() {
    println("\n=== 安全示例8: 作用域安全 ===");
    
    var outer : int = 1;
    
    {
        var inner : int = 2;
        var inner_ref : &int = &inner;
        
        println("内部作用域: " + *inner_ref);
        
        // 可以引用外部作用域的变量
        var outer_ref : &int = &outer;
        println("引用外部变量: " + *outer_ref);
        
    } // inner 和 inner_ref 在这里被销毁
    
    // outer 仍然有效
    println("外部作用域仍然有效: " + outer);
}

fn safe_example_9_iterator_safety() {
    println("\n=== 安全示例9: 迭代器安全 ===");
    
    var numbers : array<int> = [10, 20, 30, 40, 50];
    
    // 安全的迭代访问
    var i : int = 0;
    while (i < 5) {
        var element_ref : &int = &numbers[i];
        println("安全迭代元素 " + i + ": " + *element_ref);
        i += 1;
    }
    
    // 安全的可变迭代
    i = 0;
    while (i < 5) {
        var mut_element_ref : &mut int = &mut numbers[i];
        *mut_element_ref *= 2;
        i += 1;
    }
    
    println("修改后的数组: " + numbers);
}

fn safe_example_10_error_prevention() {
    println("\n=== 安全示例10: 错误预防 ===");
    
    // 防止悬空指针
    var valid_data : int = 42;
    var safe_pointer : *const int = &valid_data as *const int;
    
    // 总是检查指针有效性
    if (safe_pointer != null) {
        println("安全解引用: " + *safe_pointer);
    }
    
    // 防止双重释放（通过引用计数）
    struct RefCounted {
        data: int,
        count: int,
    }
    
    var rc_data : RefCounted = RefCounted { data: 123, count: 1 };
    println("引用计数数据: " + rc_data.data + ", 计数: " + rc_data.count);
    
    // 防止缓冲区溢出
    var buffer : array<int> = [1, 2, 3];
    var safe_index : int = 1;
    
    if (safe_index >= 0 && safe_index < 3) {
        var buffer_ref : &int = &buffer[safe_index];
        println("安全缓冲区访问: " + *buffer_ref);
    }
}

fn main() {
    println("CodeNothing 指针安全特性演示");
    println("============================");
    
    safe_example_1_borrow_checking();
    safe_example_2_lifetime_safety();
    safe_example_3_null_pointer_safety();
    safe_example_4_type_safety();
    safe_example_5_memory_safety();
    safe_example_6_reference_coercion();
    
    // 测试函数参数安全
    var test_value : int = 50;
    var test_mut_value : int = 25;
    safe_example_7_function_safety(&test_value, &mut test_mut_value);
    println("函数调用后test_mut_value: " + test_mut_value);
    
    safe_example_8_scope_safety();
    safe_example_9_iterator_safety();
    safe_example_10_error_prevention();
    
    println("\n所有安全特性演示完成！");
    println("指针系统提供了强大的内存安全保证。");
}
