// 🚀 CodeNothing 管道操作符 (|>) 完整展示
// 这个文件展示了 CodeNothing 语言中管道操作符的强大功能

// 基础数学函数
fn double(x: int) : int {
    return x * 2;
}

fn triple(x: int) : int {
    return x * 3;
}

fn square(x: int) : int {
    return x * x;
}

fn add_five(x: int) : int {
    return x + 5;
}

fn subtract_one(x: int) : int {
    return x - 1;
}

// 更复杂的函数
fn fibonacci_step(x: int) : int {
    if (x <= 1) {
        return x;
    }
    return x + (x - 1);  // 简化的斐波那契步骤
}

fn is_even_to_int(x: int) : int {
    if (x % 2 == 0) {
        return 1;  // true
    } else {
        return 0;  // false
    }
}

fn main() : int {
    // ========================================
    // 🎯 基础管道操作演示
    // ========================================
    
    // 1. 简单的单步管道
    var basic_pipe = 10 |> double;  // 10 * 2 = 20
    
    // 2. 两步管道链
    var two_step = 5 |> double |> add_five;  // 5 * 2 = 10, 10 + 5 = 15
    
    // 3. 三步管道链
    var three_step = 3 |> double |> square |> add_five;  // 3 * 2 = 6, 6 * 6 = 36, 36 + 5 = 41
    
    // ========================================
    // 🔥 复杂管道操作演示
    // ========================================
    
    // 4. 长链式管道操作
    var long_chain = 2 |> double |> triple |> subtract_one |> square;
    // 步骤: 2 * 2 = 4, 4 * 3 = 12, 12 - 1 = 11, 11 * 11 = 121
    
    // 5. 嵌套管道操作
    var nested_base = 4 |> double |> add_five;  // 4 * 2 = 8, 8 + 5 = 13
    var nested_result = nested_base |> square |> subtract_one;  // 13 * 13 = 169, 169 - 1 = 168
    
    // ========================================
    // 🧮 数学计算管道演示
    // ========================================
    
    // 6. 数学表达式管道化
    var math_expr = 7 |> double |> square |> subtract_one |> double;
    // 步骤: 7 * 2 = 14, 14 * 14 = 196, 196 - 1 = 195, 195 * 2 = 390
    
    // 7. 条件逻辑管道
    var condition_pipe = 8 |> is_even_to_int |> triple |> add_five;
    // 步骤: 8 是偶数 = 1, 1 * 3 = 3, 3 + 5 = 8
    
    // ========================================
    // 🎪 创意管道操作演示
    // ========================================
    
    // 8. 回文式管道（对称操作）
    var palindrome = 6 |> add_five |> double |> subtract_one |> subtract_one |> double;
    // 步骤: 6 + 5 = 11, 11 * 2 = 22, 22 - 1 = 21, 21 - 1 = 20, 20 * 2 = 40
    
    // 9. 斐波那契风格管道
    var fib_style = 5 |> fibonacci_step |> fibonacci_step |> add_five;
    // 步骤: fib(5) = 9, fib(9) = 17, 17 + 5 = 22
    
    // 10. 极限测试：超长管道链
    var extreme_chain = 1 |> double |> double |> double |> add_five |> square |> subtract_one |> triple;
    // 步骤: 1*2=2, 2*2=4, 4*2=8, 8+5=13, 13*13=169, 169-1=168, 168*3=504
    
    // ========================================
    // 📊 结果验证和返回
    // ========================================
    
    // 验证所有计算结果：
    // basic_pipe = 20
    // two_step = 15  
    // three_step = 41
    // long_chain = 121
    // nested_result = 168
    // math_expr = 390
    // condition_pipe = 8
    // palindrome = 40
    // fib_style = 22
    // extreme_chain = 504
    
    // 返回最复杂的计算结果作为程序输出
    return extreme_chain;  // 应该返回 504
}
