// 🚀 CodeNothing 语言复杂综合测试
// 展示多种高级特性的组合使用：OOP + 链式调用 + 管道操作符 + 复杂逻辑

// ========================================
// 🎯 复杂数据处理引擎
// ========================================

class DataProcessor {
    public data: int;
    public multiplier: int;
    public offset: int;
    public is_active: bool;
    
    DataProcessor(initial_data: int) {
        self.data = initial_data;
        self.multiplier = 1;
        self.offset = 0;
        self.is_active = true;
    }
    
    // 设置乘数 - 支持链式调用
    public fn set_multiplier(self: DataProcessor, mult: int): DataProcessor {
        self.multiplier = mult;
        return self;
    }
    
    // 设置偏移量 - 支持链式调用
    public fn set_offset(self: DataProcessor, off: int): DataProcessor {
        self.offset = off;
        return self;
    }
    
    // 激活/停用处理器 - 支持链式调用
    public fn set_active(self: DataProcessor, active: bool): DataProcessor {
        self.is_active = active;
        return self;
    }
    
    // 处理数据 - 支持链式调用
    public fn process(self: DataProcessor): DataProcessor {
        if (self.is_active) {
            self.data = (self.data * self.multiplier) + self.offset;
        }
        return self;
    }
    
    // 重置数据 - 支持链式调用
    public fn reset(self: DataProcessor, new_data: int): DataProcessor {
        self.data = new_data;
        return self;
    }
    
    // 获取处理后的数据
    public fn get_data(self: DataProcessor): int {
        return self.data;
    }
    
    // 复制处理器状态
    public fn clone_state(self: DataProcessor): DataProcessor {
        var new_processor = DataProcessor(self.data);
        return new_processor.set_multiplier(self.multiplier).set_offset(self.offset).set_active(self.is_active);
    }
}

// ========================================
// 🧮 高级数学运算器
// ========================================

class AdvancedCalculator {
    public value: int;
    public history_count: int;
    
    AdvancedCalculator(initial: int) {
        self.value = initial;
        self.history_count = 0;
    }
    
    // 复杂加法运算
    public fn complex_add(self: AdvancedCalculator, a: int, b: int): AdvancedCalculator {
        self.value = self.value + (a * b) + (a + b);
        self.history_count = self.history_count + 1;
        return self;
    }
    
    // 条件乘法
    public fn conditional_multiply(self: AdvancedCalculator, factor: int): AdvancedCalculator {
        if (self.value > 10) {
            self.value = self.value * factor;
        } else {
            self.value = self.value + factor;
        }
        self.history_count = self.history_count + 1;
        return self;
    }
    
    // 平方根近似（简化实现）
    public fn sqrt_approx(self: AdvancedCalculator): AdvancedCalculator {
        if (self.value >= 16) {
            self.value = 4;
        } else if (self.value >= 9) {
            self.value = 3;
        } else if (self.value >= 4) {
            self.value = 2;
        } else if (self.value >= 1) {
            self.value = 1;
        } else {
            self.value = 0;
        }
        self.history_count = self.history_count + 1;
        return self;
    }
    
    // 获取结果
    public fn get_result(self: AdvancedCalculator): int {
        return self.value;
    }
    
    // 获取操作历史数量
    public fn get_history_count(self: AdvancedCalculator): int {
        return self.history_count;
    }
}

// ========================================
// 🎮 游戏状态管理器
// ========================================

class GameStateManager {
    public player_level: int;
    public player_exp: int;
    public player_health: int;
    public game_score: int;
    public is_game_active: bool;
    
    GameStateManager() {
        self.player_level = 1;
        self.player_exp = 0;
        self.player_health = 100;
        self.game_score = 0;
        self.is_game_active = true;
    }
    
    // 获得经验值
    public fn gain_exp(self: GameStateManager, exp: int): GameStateManager {
        self.player_exp = self.player_exp + exp;
        // 简化的升级逻辑
        if (self.player_exp >= 100) {
            self.player_level = self.player_level + 1;
            self.player_exp = self.player_exp - 100;
            self.player_health = self.player_health + 20;
        }
        return self;
    }
    
    // 受到伤害
    public fn take_damage(self: GameStateManager, damage: int): GameStateManager {
        self.player_health = self.player_health - damage;
        if (self.player_health <= 0) {
            self.player_health = 0;
            self.is_game_active = false;
        }
        return self;
    }
    
    // 治疗
    public fn heal(self: GameStateManager, amount: int): GameStateManager {
        if (self.is_game_active) {
            self.player_health = self.player_health + amount;
            if (self.player_health > 150) {
                self.player_health = 150;  // 最大血量限制
            }
        }
        return self;
    }
    
    // 增加分数
    public fn add_score(self: GameStateManager, points: int): GameStateManager {
        if (self.is_game_active) {
            self.game_score = self.game_score + (points * self.player_level);
        }
        return self;
    }
    
    // 获取总评分
    public fn get_total_rating(self: GameStateManager): int {
        return (self.player_level * 10) + (self.player_health / 2) + (self.game_score / 5);
    }
}

// ========================================
// 🔧 管道操作符辅助函数
// ========================================

fn double(x: int): int {
    return x * 2;
}

fn add_ten(x: int): int {
    return x + 10;
}

fn square(x: int): int {
    return x * x;
}

fn clamp_to_hundred(x: int): int {
    if (x > 100) {
        return 100;
    }
    return x;
}

// ========================================
// 🚀 复杂综合测试主程序
// ========================================

fn main(): int {
    // ========================================
    // 测试1: 数据处理器复杂链式调用
    // ========================================
    
    var processor = DataProcessor(5);
    var processed_data = processor
        .set_multiplier(3)
        .set_offset(7)
        .process()                    // 5 * 3 + 7 = 22
        .set_multiplier(2)
        .process()                    // 22 * 2 + 7 = 51
        .reset(10)
        .set_offset(5)
        .process()                    // 10 * 2 + 5 = 25
        .get_data();
    
    // ========================================
    // 测试2: 高级计算器与管道操作符结合
    // ========================================
    
    var calc = AdvancedCalculator(3);
    var calc_result = calc
        .complex_add(2, 4)           // 3 + (2*4) + (2+4) = 3 + 8 + 6 = 17
        .conditional_multiply(2)      // 17 > 10, so 17 * 2 = 34
        .sqrt_approx()               // sqrt(34) ≈ sqrt(25) = 5 (简化)
        .get_result();
    
    // 使用管道操作符进一步处理计算结果
    var piped_calc_result = calc_result |> double |> add_ten |> square;
    // 5 * 2 = 10, 10 + 10 = 20, 20 * 20 = 400
    
    // ========================================
    // 测试3: 游戏状态管理复杂场景
    // ========================================
    
    var game = GameStateManager();
    var final_rating = game
        .gain_exp(80)                // 获得80经验
        .add_score(50)               // 增加50分 (50 * 1 = 50)
        .gain_exp(30)                // 再获得30经验，总计110，升级！
        .take_damage(25)             // 受到25伤害
        .heal(15)                    // 治疗15血
        .add_score(100)              // 增加100分 (100 * 2 = 200，因为升级了)
        .get_total_rating();
    
    // ========================================
    // 测试4: 复杂的数据处理链与管道结合
    // ========================================
    
    var complex_processor = DataProcessor(2);
    var complex_result = complex_processor
        .set_multiplier(3)
        .set_offset(1)
        .process()                   // 2 * 3 + 1 = 7
        .clone_state()               // 克隆状态
        .reset(5)
        .process()                   // 5 * 3 + 1 = 16
        .get_data();
    
    // 使用管道操作符处理复杂结果
    var final_complex = complex_result |> square |> clamp_to_hundred;
    // 16 * 16 = 256, clamp to 100
    
    // ========================================
    // 测试5: 多重嵌套和条件逻辑
    // ========================================
    
    var nested_calc = AdvancedCalculator(1);
    var nested_result = nested_calc
        .complex_add(1, 1)           // 1 + (1*1) + (1+1) = 1 + 1 + 2 = 4
        .conditional_multiply(5)     // 4 <= 10, so 4 + 5 = 9
        .complex_add(2, 3)           // 9 + (2*3) + (2+3) = 9 + 6 + 5 = 20
        .conditional_multiply(2)     // 20 > 10, so 20 * 2 = 40
        .get_result();
    
    // ========================================
    // 结果汇总和验证
    // ========================================

    // 验证各个测试结果：
    // processed_data = 25
    // piped_calc_result = 400
    // final_complex = 100 (clamped)
    // nested_result = 40

    // 简化计算以避免复杂的除法和大数运算
    var simplified_total = processed_data + final_complex + nested_result;
    // 25 + 100 + 40 = 165

    return simplified_total;
}
