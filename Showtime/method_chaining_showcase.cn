// 🔗 CodeNothing 链式调用 (Method Chaining) 完整展示
// 展示面向对象编程中的流畅接口 (Fluent Interface) 设计模式

// ========================================
// 🧮 数学计算器 - 基础链式调用
// ========================================

class Calculator {
    public value: int;
    
    Calculator(initial_value: int) {
        self.value = initial_value;
    }
    
    // 加法 - 返回自身支持链式调用
    public fn add(self: Calculator, amount: int): Calculator {
        self.value = self.value + amount;
        return self;
    }
    
    // 乘法 - 返回自身支持链式调用
    public fn multiply(self: Calculator, factor: int): Calculator {
        self.value = self.value * factor;
        return self;
    }
    
    // 减法 - 返回自身支持链式调用
    public fn subtract(self: Calculator, amount: int): Calculator {
        self.value = self.value - amount;
        return self;
    }
    
    // 除法 - 返回自身支持链式调用
    public fn divide(self: Calculator, divisor: int): Calculator {
        if (divisor != 0) {
            self.value = self.value / divisor;
        }
        return self;
    }
    
    // 平方 - 返回自身支持链式调用
    public fn square(self: Calculator): Calculator {
        self.value = self.value * self.value;
        return self;
    }
    
    // 获取结果 - 终止链式调用
    public fn get_result(self: Calculator): int {
        return self.value;
    }
    
    // 重置值 - 返回自身支持链式调用
    public fn reset(self: Calculator, new_value: int): Calculator {
        self.value = new_value;
        return self;
    }
}

// ========================================
// 🎨 字符串构建器 - 高级链式调用
// ========================================

class StringBuilder {
    public content: string;
    
    StringBuilder() {
        self.content = "";
    }
    
    // 追加文本
    public fn append(self: StringBuilder, text: string): StringBuilder {
        self.content = self.content + text;
        return self;
    }
    
    // 追加数字
    public fn append_number(self: StringBuilder, number: int): StringBuilder {
        // 简化的数字转字符串（仅支持小数字）
        if (number == 0) {
            self.content = self.content + "0";
        } else if (number == 1) {
            self.content = self.content + "1";
        } else if (number == 2) {
            self.content = self.content + "2";
        } else if (number == 3) {
            self.content = self.content + "3";
        } else if (number == 4) {
            self.content = self.content + "4";
        } else if (number == 5) {
            self.content = self.content + "5";
        } else {
            self.content = self.content + "N";  // 其他数字用N表示
        }
        return self;
    }
    
    // 追加换行
    public fn append_line(self: StringBuilder, text: string): StringBuilder {
        self.content = self.content + text + "\n";
        return self;
    }
    
    // 清空内容
    public fn clear(self: StringBuilder): StringBuilder {
        self.content = "";
        return self;
    }
    
    // 获取长度（简化实现）
    public fn get_length(self: StringBuilder): int {
        // 简化的长度计算
        if (self.content == "") {
            return 0;
        } else {
            return 1;  // 简化：非空就返回1
        }
    }
    
    // 获取最终字符串
    public fn to_string(self: StringBuilder): string {
        return self.content;
    }
}

// ========================================
// 🎯 游戏角色 - 复杂链式调用
// ========================================

class GameCharacter {
    public health: int;
    public attack: int;
    public defense: int;
    public level: int;
    
    GameCharacter(name: string) {
        self.health = 100;
        self.attack = 10;
        self.defense = 5;
        self.level = 1;
    }
    
    // 升级
    public fn level_up(self: GameCharacter): GameCharacter {
        self.level = self.level + 1;
        self.health = self.health + 20;
        self.attack = self.attack + 5;
        self.defense = self.defense + 2;
        return self;
    }
    
    // 装备武器
    public fn equip_weapon(self: GameCharacter, attack_bonus: int): GameCharacter {
        self.attack = self.attack + attack_bonus;
        return self;
    }
    
    // 装备护甲
    public fn equip_armor(self: GameCharacter, defense_bonus: int): GameCharacter {
        self.defense = self.defense + defense_bonus;
        return self;
    }
    
    // 治疗
    public fn heal(self: GameCharacter, amount: int): GameCharacter {
        self.health = self.health + amount;
        return self;
    }
    
    // 受伤
    public fn take_damage(self: GameCharacter, damage: int): GameCharacter {
        var actual_damage = damage - self.defense;
        if (actual_damage > 0) {
            self.health = self.health - actual_damage;
        }
        return self;
    }
    
    // 获取总战力
    public fn get_power(self: GameCharacter): int {
        return self.health + self.attack + self.defense + (self.level * 10);
    }
}

// ========================================
// 🚀 主程序 - 展示各种链式调用
// ========================================

fn main(): int {
    // ========================================
    // 🧮 数学计算链式调用演示
    // ========================================
    
    // 基础数学运算链
    var calc1 = Calculator(10);
    var math_result1 = calc1.add(5).multiply(2).subtract(3).get_result();
    // 计算: 10 + 5 = 15, 15 * 2 = 30, 30 - 3 = 27
    
    // 复杂数学运算链
    var calc2 = Calculator(2);
    var math_result2 = calc2.square().add(1).multiply(3).divide(5).get_result();
    // 计算: 2² = 4, 4 + 1 = 5, 5 * 3 = 15, 15 / 5 = 3
    
    // 重置和重新计算
    var calc3 = Calculator(1);
    var math_result3 = calc3.add(2).reset(10).multiply(2).get_result();
    // 计算: 1 + 2 = 3, 重置为10, 10 * 2 = 20
    
    // ========================================
    // 🎯 游戏角色链式调用演示
    // ========================================
    
    // 角色成长链
    var hero = GameCharacter("Hero");
    var final_power = hero.level_up().level_up().equip_weapon(15).equip_armor(10).heal(50).get_power();
    // 升级2次，装备武器(+15攻击)，装备护甲(+10防御)，治疗50血，计算总战力
    
    // 战斗模拟链
    var warrior = GameCharacter("Warrior");
    var battle_result = warrior.equip_weapon(20).take_damage(30).heal(25).take_damage(15).get_power();
    // 装备武器，受伤30，治疗25，再受伤15，计算剩余战力
    
    // ========================================
    // 📊 结果验证和返回
    // ========================================
    
    // 验证计算结果：
    // math_result1 = 27 (10+5)*2-3 = 30-3 = 27
    // math_result2 = 3  (2²+1)*3/5 = 5*3/5 = 15/5 = 3  
    // math_result3 = 20 重置为10后*2 = 20
    
    // 返回第一个数学计算结果作为程序输出
    return math_result1;  // 应该返回 27
}
