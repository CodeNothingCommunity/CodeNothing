// 🔥 CodeNothing 稳定复杂度测试
// 展示多种高级特性的稳定组合：OOP + 链式调用 + 管道操作符 + 复杂逻辑

// ========================================
// 🎯 智能计算器系统
// ========================================

class SmartCalculator {
    public value: int;
    public operation_count: int;
    public max_value: int;
    
    SmartCalculator(initial: int) {
        self.value = initial;
        self.operation_count = 0;
        self.max_value = 1000;
    }
    
    // 智能加法 - 带溢出保护
    public fn smart_add(self: SmartCalculator, amount: int): SmartCalculator {
        var new_value = self.value + amount;
        if (new_value > self.max_value) {
            self.value = self.max_value;
        } else {
            self.value = new_value;
        }
        self.operation_count = self.operation_count + 1;
        return self;
    }
    
    // 智能乘法 - 带溢出保护
    public fn smart_multiply(self: SmartCalculator, factor: int): SmartCalculator {
        var new_value = self.value * factor;
        if (new_value > self.max_value) {
            self.value = self.max_value;
        } else {
            self.value = new_value;
        }
        self.operation_count = self.operation_count + 1;
        return self;
    }
    
    // 条件运算
    public fn conditional_operation(self: SmartCalculator, threshold: int, add_val: int, mult_val: int): SmartCalculator {
        if (self.value > threshold) {
            return self.smart_multiply(mult_val);
        } else {
            return self.smart_add(add_val);
        }
    }
    
    // 重置计算器
    public fn reset(self: SmartCalculator, new_value: int): SmartCalculator {
        self.value = new_value;
        self.operation_count = 0;
        return self;
    }
    
    // 获取结果
    public fn get_result(self: SmartCalculator): int {
        return self.value;
    }
    
    // 获取操作次数
    public fn get_operations(self: SmartCalculator): int {
        return self.operation_count;
    }
}

// ========================================
// 🎮 游戏角色管理系统
// ========================================

class GameCharacter {
    public health: int;
    public attack: int;
    public level: int;
    public experience: int;
    public is_alive: bool;
    
    GameCharacter(name: string) {
        self.health = 100;
        self.attack = 15;
        self.level = 1;
        self.experience = 0;
        self.is_alive = true;
    }
    
    // 升级系统
    public fn level_up(self: GameCharacter): GameCharacter {
        self.level = self.level + 1;
        self.health = self.health + 25;
        self.attack = self.attack + 8;
        self.experience = 0;  // 重置经验
        return self;
    }
    
    // 获得经验
    public fn gain_exp(self: GameCharacter, exp: int): GameCharacter {
        self.experience = self.experience + exp;
        // 简化的升级逻辑：每100经验升一级
        if (self.experience >= 100) {
            return self.level_up();
        }
        return self;
    }
    
    // 装备强化
    public fn enhance_equipment(self: GameCharacter, attack_bonus: int, health_bonus: int): GameCharacter {
        self.attack = self.attack + attack_bonus;
        self.health = self.health + health_bonus;
        return self;
    }
    
    // 战斗模拟
    public fn battle_simulation(self: GameCharacter, enemy_attack: int): GameCharacter {
        if (self.is_alive) {
            self.health = self.health - enemy_attack;
            if (self.health <= 0) {
                self.health = 0;
                self.is_alive = false;
            } else {
                // 战斗获得经验
                self.experience = self.experience + 20;
            }
        }
        return self;
    }
    
    // 治疗
    public fn heal(self: GameCharacter, amount: int): GameCharacter {
        if (self.is_alive) {
            self.health = self.health + amount;
            if (self.health > 200) {
                self.health = 200;  // 最大血量限制
            }
        }
        return self;
    }
    
    // 获取战力评分
    public fn get_power_rating(self: GameCharacter): int {
        if (self.is_alive) {
            return (self.health / 2) + (self.attack * 3) + (self.level * 10);
        } else {
            return 0;
        }
    }
}

// ========================================
// 🔧 数据处理管道系统
// ========================================

class DataPipeline {
    public data: int;
    public processed_count: int;
    public is_active: bool;
    
    DataPipeline(initial_data: int) {
        self.data = initial_data;
        self.processed_count = 0;
        self.is_active = true;
    }
    
    // 数据变换
    public fn transform(self: DataPipeline, multiplier: int, offset: int): DataPipeline {
        if (self.is_active) {
            self.data = (self.data * multiplier) + offset;
            self.processed_count = self.processed_count + 1;
        }
        return self;
    }
    
    // 数据过滤
    public fn filter(self: DataPipeline, min_val: int, max_val: int): DataPipeline {
        if (self.is_active) {
            if (self.data < min_val) {
                self.data = min_val;
            } else if (self.data > max_val) {
                self.data = max_val;
            }
            self.processed_count = self.processed_count + 1;
        }
        return self;
    }
    
    // 条件处理
    public fn conditional_process(self: DataPipeline, condition_val: int): DataPipeline {
        if (self.is_active) {
            if (self.data > condition_val) {
                self.data = self.data + 10;
            } else {
                self.data = self.data * 2;
            }
            self.processed_count = self.processed_count + 1;
        }
        return self;
    }
    
    // 获取处理结果
    public fn get_result(self: DataPipeline): int {
        return self.data;
    }
}

// ========================================
// 🔧 管道操作符函数
// ========================================

fn enhance_value(x: int): int {
    return x + (x / 5) + 3;
}

fn stabilize(x: int): int {
    if (x > 500) {
        return 500;
    } else if (x < 10) {
        return 10;
    }
    return x;
}

fn double_plus_five(x: int): int {
    return (x * 2) + 5;
}

// ========================================
// 🚀 稳定复杂度测试主程序
// ========================================

fn main(): int {
    // ========================================
    // 测试1: 智能计算器复杂链式调用
    // ========================================
    
    var calc = SmartCalculator(10);
    var calc_result = calc
        .smart_add(15)                    // 10 + 15 = 25
        .smart_multiply(3)                // 25 * 3 = 75
        .conditional_operation(50, 20, 4) // 75 > 50, so 75 * 4 = 300
        .smart_add(100)                   // 300 + 100 = 400
        .get_result();
    
    // ========================================
    // 测试2: 游戏角色复杂成长系统
    // ========================================
    
    var hero = GameCharacter("Hero");
    var hero_power = hero
        .gain_exp(80)                     // 获得80经验
        .enhance_equipment(12, 30)        // 装备强化：+12攻击，+30血量
        .gain_exp(25)                     // 再获得25经验，总计105，升级！
        .battle_simulation(40)            // 模拟战斗，受到40伤害
        .heal(35)                         // 治疗35血量
        .enhance_equipment(8, 15)         // 再次装备强化
        .get_power_rating();
    
    // ========================================
    // 测试3: 数据处理管道系统
    // ========================================
    
    var pipeline = DataPipeline(5);
    var pipeline_result = pipeline
        .transform(4, 10)                 // 5 * 4 + 10 = 30
        .filter(20, 100)                  // 30在范围内，保持30
        .conditional_process(25)          // 30 > 25, so 30 + 10 = 40
        .transform(2, 5)                  // 40 * 2 + 5 = 85
        .get_result();
    
    // ========================================
    // 测试4: 管道操作符与复杂函数组合
    // ========================================
    
    var piped_calc = calc_result |> enhance_value |> double_plus_five |> stabilize;
    // 400 -> enhance_value(400) = 400 + 80 + 3 = 483
    // 483 -> double_plus_five(483) = 966 + 5 = 971  
    // 971 -> stabilize(971) = 500 (clamped)
    
    var piped_pipeline = pipeline_result |> enhance_value |> stabilize;
    // 85 -> enhance_value(85) = 85 + 17 + 3 = 105
    // 105 -> stabilize(105) = 105 (within range)
    
    // ========================================
    // 测试5: 多重嵌套复杂计算
    // ========================================
    
    var nested_calc = SmartCalculator(3);
    var nested_result = nested_calc
        .smart_add(7)                     // 3 + 7 = 10
        .conditional_operation(5, 15, 6)  // 10 > 5, so 10 * 6 = 60
        .smart_add(40)                    // 60 + 40 = 100
        .conditional_operation(80, 25, 3) // 100 > 80, so 100 * 3 = 300
        .get_result();
    
    // ========================================
    // 最终结果汇总
    // ========================================
    
    // 计算综合结果
    var total_result = calc_result + (hero_power / 10) + pipeline_result + (piped_calc / 10) + (nested_result / 5);
    // 400 + (hero_power/10) + 85 + 50 + 60 = 595 + (hero_power/10)
    
    return total_result;
}
