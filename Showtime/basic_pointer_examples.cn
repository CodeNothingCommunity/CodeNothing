// 基础指针操作示例
// Basic Pointer Operations Examples

fn example_1_basic_references() {
    println("=== 示例1: 基础引用操作 ===");
    
    // 创建变量
    var x : int = 42;
    var y : string = "Hello";
    
    // 创建不可变引用
    var ref_x : &int = &x;
    var ref_y : &string = &y;
    
    // 通过引用读取值
    println("x的值: " + *ref_x);
    println("y的值: " + *ref_y);
    
    // 引用的地址
    println("ref_x指向的地址: " + ref_x);
    println("ref_y指向的地址: " + ref_y);
}

fn example_2_mutable_references() {
    println("\n=== 示例2: 可变引用操作 ===");
    
    var counter : int = 0;
    var name : string = "World";
    
    // 创建可变引用
    var mut_counter : &mut int = &mut counter;
    var mut_name : &mut string = &mut name;
    
    // 通过可变引用修改值
    *mut_counter = 100;
    *mut_name = "CodeNothing";
    
    println("修改后的counter: " + counter);
    println("修改后的name: " + name);
    
    // 继续修改
    *mut_counter += 50;
    println("再次修改后的counter: " + counter);
}

fn example_3_raw_pointers() {
    println("\n=== 示例3: 原始指针操作 ===");
    
    var data : int = 999;
    
    // 创建原始指针
    var const_ptr : *const int = &data as *const int;
    var mut_ptr : *mut int = &mut data as *mut int;
    
    println("通过const指针读取: " + *const_ptr);
    
    // 通过可变原始指针修改
    *mut_ptr = 1337;
    println("通过mut指针修改后: " + data);
    
    // 指针比较
    if (const_ptr == mut_ptr as *const int) {
        println("两个指针指向同一地址");
    }
}

fn example_4_struct_pointers() {
    println("\n=== 示例4: 结构体指针 ===");
    
    struct Point {
        x: int,
        y: int,
    }
    
    var point : Point = Point { x: 10, y: 20 };
    
    // 指向整个结构体的引用
    var point_ref : &Point = &point;
    println("Point: (" + (*point_ref).x + ", " + (*point_ref).y + ")");
    
    // 指向字段的引用
    var x_ref : &int = &point.x;
    var y_ref : &mut int = &mut point.y;
    
    println("x字段值: " + *x_ref);
    
    // 修改y字段
    *y_ref = 30;
    println("修改后的Point: (" + point.x + ", " + point.y + ")");
}

fn example_5_array_pointers() {
    println("\n=== 示例5: 数组指针 ===");
    
    var numbers : array<int> = [1, 2, 3, 4, 5];
    
    // 指向数组元素的引用
    var first_ref : &int = &numbers[0];
    var last_ref : &mut int = &mut numbers[4];
    
    println("第一个元素: " + *first_ref);
    println("最后一个元素: " + *last_ref);
    
    // 修改最后一个元素
    *last_ref = 99;
    println("修改后的数组: " + numbers);
    
    // 遍历数组并创建引用
    var i : int = 0;
    while (i < 5) {
        var elem_ref : &int = &numbers[i];
        print("元素" + i + ": " + *elem_ref + " ");
        i += 1;
    }
    println("");
}

fn modify_through_pointer(ptr: &mut int, new_value: int) {
    *ptr = new_value;
}

fn get_value_through_pointer(ptr: &int) -> int {
    return *ptr;
}

fn example_6_function_parameters() {
    println("\n=== 示例6: 函数参数中的指针 ===");
    
    var value : int = 42;
    
    // 通过引用传递给函数
    var original : int = get_value_through_pointer(&value);
    println("原始值: " + original);
    
    // 通过可变引用修改
    modify_through_pointer(&mut value, 100);
    println("修改后的值: " + value);
    
    // 再次修改
    modify_through_pointer(&mut value, value * 2);
    println("再次修改后的值: " + value);
}

fn example_7_pointer_chains() {
    println("\n=== 示例7: 指针链 ===");
    
    var x : int = 42;
    var ref_x : &int = &x;
    var ref_ref_x : &(&int) = &ref_x;
    
    // 多层解引用
    println("x的值: " + x);
    println("通过ref_x: " + *ref_x);
    println("通过ref_ref_x: " + *(*ref_ref_x));
    
    // 修改原始值
    x = 100;
    println("修改x后，通过引用链读取: " + *(*ref_ref_x));
}

fn example_8_null_pointers() {
    println("\n=== 示例8: 空指针处理 ===");
    
    // 创建空指针
    var null_ptr : *const int = null as *const int;
    var null_mut_ptr : *mut string = null as *mut string;
    
    // 检查空指针
    if (null_ptr == null) {
        println("null_ptr 是空指针");
    }
    
    if (null_mut_ptr == null) {
        println("null_mut_ptr 是空指针");
    }
    
    // 安全的指针使用
    var data : int = 123;
    var safe_ptr : *const int = &data as *const int;
    
    if (safe_ptr != null) {
        println("安全指针的值: " + *safe_ptr);
    }
}

fn example_9_pointer_arithmetic() {
    println("\n=== 示例9: 指针运算 ===");
    
    var arr : array<int> = [10, 20, 30, 40, 50];
    
    // 获取数组首元素指针
    var ptr : *const int = &arr[0] as *const int;
    
    // 模拟指针运算（注意：这里简化了实现）
    var i : int = 0;
    while (i < 5) {
        // 在真实实现中，这里会是 *(ptr + i)
        var current_ptr : *const int = &arr[i] as *const int;
        println("arr[" + i + "] = " + *current_ptr);
        i += 1;
    }
}

fn example_10_smart_pointer_basics() {
    println("\n=== 示例10: 智能指针基础 ===");
    
    // 简单的智能指针概念演示
    struct SmartInt {
        value: int,
        ref_count: int,
    }
    
    var smart : SmartInt = SmartInt { value: 42, ref_count: 1 };
    var smart_ref : &SmartInt = &smart;
    
    println("智能指针值: " + (*smart_ref).value);
    println("引用计数: " + (*smart_ref).ref_count);
    
    // 模拟增加引用计数
    smart.ref_count += 1;
    println("增加引用后计数: " + smart.ref_count);
}

fn main() {
    println("CodeNothing 指针操作示例集合");
    println("================================");
    
    example_1_basic_references();
    example_2_mutable_references();
    example_3_raw_pointers();
    example_4_struct_pointers();
    example_5_array_pointers();
    example_6_function_parameters();
    example_7_pointer_chains();
    example_8_null_pointers();
    example_9_pointer_arithmetic();
    example_10_smart_pointer_basics();
    
    println("\n所有示例执行完成！");
}
