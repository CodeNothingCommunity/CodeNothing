// ===================================================================
// CodeNothing 高级指针系统演示
// 展示引用、可变引用、指针算术和内存管理的完整功能
// ===================================================================

fn main() {
    println("🚀 CodeNothing 高级指针系统演示");
    println("=====================================");
    
    // 1. 基本引用操作
    basic_reference_demo();
    
    // 2. 可变引用操作
    mutable_reference_demo();
    
    // 3. 多级指针操作
    multi_level_pointer_demo();
    
    // 4. 数组指针操作
    array_pointer_demo();
    
    // 5. 函数指针传递
    function_pointer_demo();
    
    // 6. 指针安全性演示
    pointer_safety_demo();
    
    println("✅ 所有指针操作演示完成！");
}

// 基本引用操作演示
fn basic_reference_demo() {
    println("\n📌 1. 基本引用操作");
    println("------------------");
    
    let x = 100;
    let y = 200;
    
    // 创建不可变引用
    let ref_x = &x;
    let ref_y = &y;
    
    println("原始值: x = " + x + ", y = " + y);
    println("引用值: *ref_x = " + *ref_x + ", *ref_y = " + *ref_y);
    
    // 引用比较
    if *ref_x < *ref_y {
        println("✓ 引用比较正常工作");
    }
    
    // 引用算术
    let sum_via_refs = *ref_x + *ref_y;
    println("通过引用计算和: " + sum_via_refs);
}

// 可变引用操作演示
fn mutable_reference_demo() {
    println("\n📌 2. 可变引用操作");
    println("------------------");
    
    let mut counter = 0;
    let mut value = 42;
    
    // 创建可变引用
    let mut_ref_counter = &mut counter;
    let mut_ref_value = &mut value;
    
    println("初始值: counter = " + counter + ", value = " + value);
    
    // 通过可变引用修改值
    *mut_ref_counter = 10;
    *mut_ref_value = *mut_ref_value * 2;
    
    println("修改后: counter = " + counter + ", value = " + value);
    
    // 连续修改
    *mut_ref_counter = *mut_ref_counter + 5;
    *mut_ref_value = *mut_ref_value + 8;
    
    println("再次修改: counter = " + counter + ", value = " + value);
}

// 多级指针操作演示
fn multi_level_pointer_demo() {
    println("\n📌 3. 多级指针操作");
    println("------------------");
    
    let mut original = 999;
    println("原始值: " + original);
    
    // 第一级指针
    let mut ptr1 = &mut original;
    println("通过一级指针访问: " + *ptr1);
    
    // 第二级指针
    let mut ptr2 = &mut ptr1;
    println("通过二级指针访问: " + **ptr2);
    
    // 通过二级指针修改原始值
    **ptr2 = 777;
    println("通过二级指针修改后: " + original);
    
    // 修改一级指针指向
    *ptr1 = 555;
    println("通过一级指针修改后: " + original);
}

// 数组指针操作演示
fn array_pointer_demo() {
    println("\n📌 4. 数组指针操作");
    println("------------------");
    
    let mut numbers = [10, 20, 30, 40, 50];
    println("原始数组: [10, 20, 30, 40, 50]");
    
    // 获取数组元素的引用
    let mut ref_first = &mut numbers[0];
    let mut ref_third = &mut numbers[2];
    let mut ref_last = &mut numbers[4];
    
    println("通过引用访问: first=" + *ref_first + ", third=" + *ref_third + ", last=" + *ref_last);
    
    // 通过引用修改数组元素
    *ref_first = 100;
    *ref_third = 300;
    *ref_last = 500;
    
    println("修改后数组: [" + numbers[0] + ", " + numbers[1] + ", " + numbers[2] + ", " + numbers[3] + ", " + numbers[4] + "]");
    
    // 数组元素交换
    let temp = *ref_first;
    *ref_first = *ref_last;
    *ref_last = temp;
    
    println("交换后数组: [" + numbers[0] + ", " + numbers[1] + ", " + numbers[2] + ", " + numbers[3] + ", " + numbers[4] + "]");
}

// 函数指针传递演示
fn function_pointer_demo() {
    println("\n📌 5. 函数指针传递");
    println("------------------");
    
    let mut data1 = 15;
    let mut data2 = 25;
    
    println("传递前: data1=" + data1 + ", data2=" + data2);
    
    // 传递可变引用到函数
    modify_via_reference(&mut data1, &mut data2);
    
    println("传递后: data1=" + data1 + ", data2=" + data2);
    
    // 使用引用进行复杂计算
    let result = complex_calculation(&data1, &data2);
    println("复杂计算结果: " + result);
}

// 通过引用修改值的辅助函数
fn modify_via_reference(ref1: &mut int, ref2: &mut int) {
    *ref1 = *ref1 * 3;
    *ref2 = *ref2 * 2;
    
    // 交换值
    let temp = *ref1;
    *ref1 = *ref2;
    *ref2 = temp;
}

// 通过引用进行复杂计算的辅助函数
fn complex_calculation(ref1: &int, ref2: &int) -> int {
    let sum = *ref1 + *ref2;
    let product = *ref1 * *ref2;
    let difference = if *ref1 > *ref2 { *ref1 - *ref2 } else { *ref2 - *ref1 };
    
    return sum + product + difference;
}

// 指针安全性演示
fn pointer_safety_demo() {
    println("\n📌 6. 指针安全性演示");
    println("--------------------");
    
    let mut safe_value = 888;
    println("安全值: " + safe_value);
    
    // 创建安全的可变引用
    let safe_ref = &mut safe_value;
    
    // 安全的指针操作
    *safe_ref = *safe_ref + 111;
    println("安全修改后: " + safe_value);
    
    // 演示引用的生命周期管理
    {
        let mut local_value = 666;
        let local_ref = &mut local_value;
        *local_ref = 777;
        println("局部作用域中的值: " + local_value);
    } // local_ref 在这里自动失效
    
    println("✓ 指针安全性检查通过");
}

// 额外的指针工具函数
fn swap_values(a: &mut int, b: &mut int) {
    let temp = *a;
    *a = *b;
    *b = temp;
}

fn increment_all(values: &mut [int]) {
    let mut i = 0;
    while i < values.length() {
        let mut ref_val = &mut values[i];
        *ref_val = *ref_val + 1;
        i = i + 1;
    }
}

fn find_max_via_refs(a: &int, b: &int, c: &int) -> int {
    let max_ab = if *a > *b { *a } else { *b };
    return if max_ab > *c { max_ab } else { *c };
}

// 指针链式操作演示
fn pointer_chain_demo() {
    println("\n📌 7. 指针链式操作");
    println("------------------");
    
    let mut base = 1;
    let mut step1 = &mut base;
    let mut step2 = &mut step1;
    let mut step3 = &mut step2;
    
    // 通过三级指针修改基础值
    ***step3 = 42;
    println("通过三级指针设置的值: " + base);
    
    // 链式计算
    ***step3 = ***step3 * 2 + 8;
    println("链式计算后的值: " + base);
}
