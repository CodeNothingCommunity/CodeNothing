using ns lang;

fn main() : int {
    println("🚀 Advanced Closure Demonstration - CodeNothing Language");
    println("========================================================");
    
    // ===== PART 1: Variable Capture Closures =====
    println("\n📦 Part 1: Variable Capture Closures");
    println("-------------------------------------");
    
    // Basic variable capture
    let base_multiplier = 10;
    let power_factor = 2;
    
    let power_calculator = |x: int| x * base_multiplier * power_factor;
    
    let result1 = power_calculator(5);
    println("Power calculator: 5 * " + to_string(base_multiplier) + " * " + to_string(power_factor) + " = " + to_string(result1));
    
    // Multiple variable capture with different scopes
    let global_offset = 100;
    let scaling_factor = 3;
    
    let complex_transformer = |input: int| input * scaling_factor + global_offset;
    
    let result2 = complex_transformer(15);
    println("Complex transformer: (15 * " + to_string(scaling_factor) + ") + " + to_string(global_offset) + " = " + to_string(result2));
    
    // ===== PART 2: Higher-Order Functions =====
    println("\n🔧 Part 2: Higher-Order Functions");
    println("----------------------------------");
    
    // Create a closure that captures a multiplier
    let double_multiplier = 2;
    let doubler = |x: int| x * double_multiplier;
    
    let doubled_once = doubler(7);
    let twice_doubled = doubler(doubled_once);
    println("Apply doubler twice to 7: " + to_string(twice_doubled));
    
    // ===== PART 3: Multiple Variable Capture =====
    println("\n🏭 Part 3: Multiple Variable Capture");
    println("------------------------------------");

    // Closure that captures multiple variables
    let start_value = 10;
    let increment_step = 5;
    let multiplier_step = 2;

    let multi_capture_calculator = |input: int| (input + start_value) * increment_step + multiplier_step;

    let count1 = multi_capture_calculator(5);
    let count2 = multi_capture_calculator(3);

    println("Multi-variable capture calculator:");
    println("  Formula: (input + " + to_string(start_value) + ") * " + to_string(increment_step) + " + " + to_string(multiplier_step));
    println("  Input 5: " + to_string(count1));
    println("  Input 3: " + to_string(count2));
    
    // ===== PART 4: Mathematical Function Composition =====
    println("\n🧮 Part 4: Mathematical Function Composition");
    println("---------------------------------------------");

    // Mathematical functions using closures with captured coefficients
    let coefficient_a = 3;
    let coefficient_b = 5;
    let constant_c = 7;

    let linear_function = |x: int| x * coefficient_a + coefficient_b;
    let quadratic_part = |x: int| x * x + constant_c;

    let input_value = 4;
    let quadratic_result = quadratic_part(input_value);
    let composed_result = linear_function(quadratic_result);

    println("Manual composition f(g(4)) where:");
    println("  g(x) = x² + " + to_string(constant_c) + " = " + to_string(quadratic_result));
    println("  f(x) = " + to_string(coefficient_a) + "x + " + to_string(coefficient_b));
    println("  Result: " + to_string(composed_result));
    
    // ===== PART 5: Advanced Closure Chaining =====
    println("\n⛓️  Part 5: Advanced Closure Chaining");
    println("--------------------------------------");

    // Chain multiple operations using closures manually
    let multiplier_factor = 4;
    let addition_factor = 10;
    let division_factor = 2;

    let multiply_op = |x: int| x * multiplier_factor;
    let add_op = |x: int| x + addition_factor;
    let divide_op = |x: int| x / division_factor;

    let input_val = 5;
    let step1 = multiply_op(input_val);
    let step2 = add_op(step1);
    let chained_result = divide_op(step2);

    println("Chaining operations on 5:");
    println("  Step 1: 5 * " + to_string(multiplier_factor) + " = " + to_string(step1));
    println("  Step 2: " + to_string(step1) + " + " + to_string(addition_factor) + " = " + to_string(step2));
    println("  Step 3: " + to_string(step2) + " / " + to_string(division_factor) + " = " + to_string(chained_result));
    
    // ===== PART 6: Conditional Closure Usage =====
    println("\n🔀 Part 6: Conditional Closure Usage");
    println("------------------------------------");

    let threshold = 50;
    let low_multiplier = 2;
    let high_multiplier = 5;

    let low_operation = |x: int| x * low_multiplier;
    let high_operation = |x: int| x * high_multiplier;

    let test_value_1 = 30;
    let test_value_2 = 70;

    let conditional_result_1 = low_operation(test_value_1);  // 30 < 50, use low multiplier
    let conditional_result_2 = high_operation(test_value_2); // 70 >= 50, use high multiplier

    println("Conditional operations (threshold = " + to_string(threshold) + "):");
    println("  Value " + to_string(test_value_1) + " < " + to_string(threshold) + " → multiply by " + to_string(low_multiplier) + " = " + to_string(conditional_result_1));
    println("  Value " + to_string(test_value_2) + " ≥ " + to_string(threshold) + " → multiply by " + to_string(high_multiplier) + " = " + to_string(conditional_result_2));
    
    println("\n✅ Advanced Closure Demonstration Complete!");
    println("All closure features working perfectly: Variable Capture ✓ Higher-Order Functions ✓");
    
    return 0;
}
