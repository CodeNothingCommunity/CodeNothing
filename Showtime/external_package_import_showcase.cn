// 外部包导入功能展示 - 复杂多命名空间示例
// 展示带别名的外部包导入和复杂函数调用

import math_utils as MathEngine;
import math_utils as GeometryEngine;

fn main(): int {
    // === 数学计算引擎测试 ===
    let base_num = MathEngine::math::add(10, 15);           // 25
    let squared = MathEngine::math::power(base_num, 2);     // 625
    let multiplied = MathEngine::math::multiply(squared, 3); // 1875
    
    // === 几何计算引擎测试 ===
    let rect_area = GeometryEngine::geometry::area_rectangle(12, 8);      // 96
    let triangle_area = GeometryEngine::geometry::area_triangle(15, 10);  // 75
    let perimeter = GeometryEngine::geometry::perimeter_rectangle(6, 4);  // 20
    
    // === 复杂嵌套计算 ===
    // 计算复合面积：矩形面积 + 三角形面积的平方
    let composite_area = MathEngine::math::add(
        rect_area,
        MathEngine::math::power(triangle_area, 2)  // 75^2 = 5625
    ); // 96 + 5625 = 5721
    
    // === 最终复杂计算 ===
    // 将所有结果组合：(数学结果 + 复合面积) * 周长
    let final_calculation = MathEngine::math::multiply(
        MathEngine::math::add(multiplied, composite_area), // 1875 + 5721 = 7596
        perimeter  // 20
    ); // 7596 * 20 = 151920
    
    // === 验证计算 ===
    // 使用不同的引擎别名进行验证计算
    let verification = GeometryEngine::math::power(
        MathEngine::math::add(final_calculation, 80), // 151920 + 80 = 152000
        2  // 152000^2 = 23104000000
    );
    
    return verification;
}

// 预期计算过程:
// 1. base_num = 10 + 15 = 25
// 2. squared = 25^2 = 625
// 3. multiplied = 625 * 3 = 1875
// 4. rect_area = 12 * 8 = 96
// 5. triangle_area = (15 * 10) / 2 = 75
// 6. perimeter = 2 * (6 + 4) = 20
// 7. composite_area = 96 + 75^2 = 96 + 5625 = 5721
// 8. final_calculation = (1875 + 5721) * 20 = 7596 * 20 = 151920
// 9. verification = (151920 + 80)^2 = 152000^2 = 23104000000
//
// 最终结果: 23104000000
