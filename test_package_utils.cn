// Utils package for testing package system
package utils version "0.5.0" author "CodeNothing Team";

// Import from math package
import math { add, PI };

// Export a string utility function
export fn concat_strings(a: string, b: string) : string {
    return a + b;
}

// Export a function that uses imported math functions
export fn calculate_circle_area(radius: float) : float {
    return PI * radius * radius;
}

// Export a function that uses imported add function
export fn add_ten(x: int) : int {
    return add(x, 10);
}

// Export a simple max function
export fn max(a: int, b: int) : int {
    if (a > b) {
        return a;
    }
    return b;
}
