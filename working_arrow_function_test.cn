// 🚀 CodeNothing 可工作的箭头函数测试
// 展示箭头函数的基础功能

lib <io>;

fn test_basic_arrow_functions() {
    std::println("🔥 基础箭头函数测试");
    std::println("==================");
    
    // 单参数箭头函数
    var square = (x: int) => x * x;
    std::println("平方函数: " + lang::to_string(square));
    
    // 多参数箭头函数
    var add = (a: int, b: int) => a + b;
    std::println("加法函数: " + lang::to_string(add));
    
    var multiply = (x: int, y: int) => x * y;
    std::println("乘法函数: " + lang::to_string(multiply));
    
    std::println("");
}

fn test_string_arrow_functions() {
    std::println("🔥 字符串处理箭头函数测试");
    std::println("========================");
    
    // 字符串处理函数
    var greet = (name: string) => "Hello, " + name + "!";
    std::println("问候函数: " + lang::to_string(greet));
    
    var format_name = (first: string, last: string) => first + " " + last;
    std::println("姓名格式化函数: " + lang::to_string(format_name));
    
    std::println("");
}

fn test_conditional_arrow_functions() {
    std::println("🔥 条件逻辑箭头函数测试");
    std::println("======================");
    
    // 使用 when 表达式的箭头函数
    var get_grade = (score: int) => when { score >= 90 => "A", score >= 80 => "B", score >= 70 => "C", else => "F" };
    std::println("成绩评定函数: " + lang::to_string(get_grade));
    
    var get_discount = (amount: int) => when { amount >= 1000 => amount * 90 / 100, amount >= 500 => amount * 95 / 100, else => amount };
    std::println("折扣计算函数: " + lang::to_string(get_discount));
    
    std::println("");
}

fn test_mathematical_arrow_functions() {
    std::println("🔥 数学计算箭头函数测试");
    std::println("======================");
    
    // 数学计算函数
    var calculate_area = (width: int, height: int) => width * height;
    std::println("面积计算函数: " + lang::to_string(calculate_area));
    
    var calculate_perimeter = (width: int, height: int) => 2 * (width + height);
    std::println("周长计算函数: " + lang::to_string(calculate_perimeter));
    
    std::println("");
}

fn test_business_logic_arrow_functions() {
    std::println("🔥 业务逻辑箭头函数测试");
    std::println("======================");
    
    // 业务逻辑函数
    var calculate_tax = (income: int) => when { income <= 50000 => income * 10 / 100, income <= 100000 => income * 15 / 100, else => income * 20 / 100 };
    std::println("税收计算函数: " + lang::to_string(calculate_tax));
    
    var determine_shipping = (weight: int, distance: int) => when { weight <= 1 && distance <= 10 => 5, weight <= 5 && distance <= 50 => 15, weight <= 10 => 25, else => 50 };
    std::println("运费计算函数: " + lang::to_string(determine_shipping));
    
    std::println("");
}

fn main() : int {
    std::println("🚀 CodeNothing 可工作的箭头函数测试");
    std::println("=================================");
    std::println("");
    
    test_basic_arrow_functions();
    test_string_arrow_functions();
    test_conditional_arrow_functions();
    test_mathematical_arrow_functions();
    test_business_logic_arrow_functions();
    
    std::println("🎉 所有箭头函数测试完成!");
    std::println("");
    std::println("🔥 箭头函数功能总结:");
    std::println("✅ 单参数语法 - (x: type) => expression");
    std::println("✅ 多参数语法 - (x: type, y: type) => expression");
    std::println("✅ 表达式体 - 简洁的单行表达式");
    std::println("✅ 类型注解支持 - 完整的类型系统集成");
    std::println("✅ 与其他语法糖结合 - when表达式完美配合");
    std::println("✅ 实际应用场景 - 数学计算、业务逻辑、字符串处理");
    std::println("");
    std::println("💪 CodeNothing 箭头函数功能强大且实用!");
    std::println("🚀 现代化函数式编程特性完美实现!");
    
    return 0;
}
