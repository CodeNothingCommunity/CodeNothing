// CodeNothing 猜数字小游戏 - 现代语法糖终极版
// 使用 math 库的随机数生成功能和 io 库的输入输出功能
// 展示最新的语法糖：链式调用、管道操作符、类型推断等

lib <math>;
lib <io>;

// ========================================
// 🎮 游戏状态管理类 - 支持链式调用
// ========================================

class GameState {
    public attempts: int;
    public max_attempts: int;
    public target_number: int;
    public is_guessed: bool;
    public last_guess: int;

    GameState(target: int, max_tries: int) {
        self.attempts = 0;
        self.max_attempts = max_tries;
        self.target_number = target;
        self.is_guessed = false;
        self.last_guess = 0;
    }

    // 链式调用：增加尝试次数
    public fn increment_attempts(self: GameState): GameState {
        self.attempts = self.attempts + 1;
        return self;
    }

    // 链式调用：减少尝试次数（无效输入时）
    public fn decrement_attempts(self: GameState): GameState {
        self.attempts = self.attempts - 1;
        return self;
    }

    // 链式调用：设置猜测值
    public fn set_guess(self: GameState, guess: int): GameState {
        self.last_guess = guess;
        return self;
    }

    // 链式调用：标记为已猜中
    public fn mark_guessed(self: GameState): GameState {
        self.is_guessed = true;
        return self;
    }

    // 获取剩余尝试次数
    public fn get_remaining_attempts(self: GameState): int {
        return self.max_attempts - self.attempts;
    }

    // 检查是否游戏结束
    public fn is_game_over(self: GameState): bool {
        return self.is_guessed || self.attempts >= self.max_attempts;
    }

    // 检查猜测是否正确
    public fn check_guess(self: GameState): int {
        if (self.last_guess == self.target_number) {
            return 0;  // 正确
        } else if (self.last_guess < self.target_number) {
            return -1; // 太小
        } else {
            return 1;  // 太大
        }
    }
}

// ========================================
// 🔧 管道操作符辅助函数
// ========================================

// 字符串处理管道函数 - 带错误处理
fn to_int_safe(input: string): int {
    try {
        return lang::to_int(input);
    } catch {
        return -999;  // 返回特殊值表示转换失败
    }
}

// 调试辅助函数 - 带目标数字参数
fn to_int_safe_with_debug(input: string, target: int): int {
    try {
        if (input == "debug") {
            lang::println("[DEBUG] 答案：" + lang::to_string(target));
            return -999;  // 返回特殊值，不作为有效猜测
        }
        return lang::to_int(input);
    } catch {
        return -999;  // 返回特殊值表示转换失败
    }
}

fn validate_range(value: int): int {
    if (value == -999) {
        return -1;  // 转换失败
    }
    if (value < 1 || value > 100) {
        return -1;  // 无效范围
    }
    return value;
}

fn format_attempts_message(attempts: int): string {
    return "你用了 " + lang::to_string(attempts) + " 次就猜中了！";
}

fn format_remaining_message(remaining: int): string {
    return "还有 " + lang::to_string(remaining) + " 次机会";
}

// 性能评价管道函数
fn evaluate_performance(attempts: int): string {
    return attempts == 1 ? "🌟 神级！一次就猜中了！你是天才吗？" :
           attempts <= 3 ? "🔥 优秀！你的直觉很准！" :
           attempts <= 5 ? "👍 不错！你很快就找到了答案！" :
           attempts <= 7 ? "😊 还可以！继续努力！" :
           "🤔 需要多练习！下次试试二分法？";
}

fn main() {
    // 🎮 游戏欢迎界面 - 使用管道操作符优化字符串处理
    var welcome_title := "欢迎来到 CodeNothing 猜数字游戏！" |> display_with_border;
    std::println(welcome_title);

    // 游戏规则展示
    show_game_rules();

    // 🚀 初始化随机数种子并开始游戏
    random::seed();

    // 使用现代化的游戏循环
    play_modern_game();

    // 🎯 游戏结束后的交互 - 使用链式调用和管道操作符
    std::println("");
    var continue_game = "" |> prompt_continue_game;

    if (continue_game) {
        main(); // 递归调用重新开始游戏
    }

    "谢谢游玩！再见" |> display_farewell;
}

// 🎨 辅助显示函数 - 支持管道操作符
fn display_with_border(text: string): string {
    std::println("=====================================");
    std::println(text);
    std::println("=====================================");
    return text;
}

fn display_farewell(message: string): string {
    std::println(message);
    return message;
}

fn prompt_continue_game(dummy: string): bool {
    std::println("<?> 想再玩一局吗？(y/n): ");
    var answer := std::input();
    return answer == "y" || answer == "Y" || answer == "yes" || answer == "Yes";
}

fn show_game_rules() {
    std::println("游戏规则：");
    std::println("1. 系统会生成一个 1-100 之间的随机数");
    std::println("2. 你需要猜出这个数字");
    std::println("3. 系统会提示你猜的数字是大了还是小了");
    std::println("4. 看看你能用几次猜中！");
    std::println("");
}

// 🚀 现代化游戏主逻辑 - 使用链式调用和管道操作符
fn play_modern_game() {
    // 🎲 生成随机数 - 使用管道操作符优化
    var target_number := random::randint("1", "100") |> to_int_safe;

    std::println("我已经想好了一个 1-100 之间的数字！");
    std::println("");

    // 🎮 创建游戏状态对象 - 支持链式调用
    var game_state := GameState(target_number, 10);

    // 🔄 现代化游戏循环
    while (!game_state.is_game_over()) {
        // 链式调用：增加尝试次数并获取用户输入
        game_state = game_state.increment_attempts();

        // 🎯 获取用户输入 - 使用管道操作符处理
        var prompt := "<?> 第 " + lang::to_string(game_state.attempts) + " 次猜测，请输入你的数字 (1-100): ";
        std::print(prompt);

        var input := std::input();

        // 🔍 输入验证和处理 - 使用管道操作符链（带调试支持）
        var parsed_input := to_int_safe_with_debug(input, target_number);
        var guess := parsed_input |> validate_range;

        if (guess == -1) {
            std::println("[!] 请输入 1-100 之间的有效数字！");
            game_state = game_state.decrement_attempts(); // 链式调用：不计入无效尝试
            continue;
        }

        // 🎯 设置猜测值并检查结果 - 使用链式调用
        game_state = game_state.set_guess(guess);
        var result := game_state.check_guess();

        if (result == 0) {
            // 🎉 猜中了！使用链式调用和管道操作符
            game_state = game_state.mark_guessed();

            std::println("[V] 恭喜你！猜对了！");
            std::println("答案就是：" + lang::to_string(target_number));

            // 使用管道操作符格式化消息
            var success_msg := game_state.attempts |> format_attempts_message;
            std::println(success_msg);

            // 使用管道操作符获取性能评价
            var feedback := game_state.attempts |> evaluate_performance;
            display_performance_feedback(feedback);

        } else {
            // 🎯 提供提示 - 使用三元条件操作符和管道操作符
            var hint := result == -1 ? "[-] 太小了！再试试更大的数字" : "[+] 太大了！再试试更小的数字";
            std::println(hint);

            // 显示剩余机会 - 使用链式调用和管道操作符
            var remaining := game_state.get_remaining_attempts();
            if (remaining > 0) {
                var remaining_msg := remaining |> format_remaining_message;
                std::println(remaining_msg);
            }
        }

        std::println("");
    }

    // 🎭 游戏结束处理
    if (!game_state.is_guessed) {
        std::println("{:(} 很遗憾，你用完了所有 10 次机会！");
        std::println("答案就是：" + lang::to_string(target_number));
        std::println("下次再来挑战吧！");
    }
}

// 🎯 现代化性能反馈系统 - 使用管道操作符和链式调用
fn display_performance_feedback(feedback: string) {
    std::println("");
    std::println("评价：");
    std::println(feedback);
}

// 🚀 保留原有的性能反馈函数（向后兼容）
fn give_performance_feedback(attempts: int) {
    // 使用管道操作符简化反馈流程
    var feedback := attempts |> evaluate_performance;
    display_performance_feedback(feedback);

    // 根据尝试次数给出建议 - 使用现代化的条件处理
    if (attempts > 7) {
        show_strategy_tips();
    } else {
        std::println("💡 提示：使用二分法最多只需要 7 次就能猜中 1-100 的数字！");
    }
}

// 🧠 策略提示系统
fn show_strategy_tips() {
    std::println("");
    std::println("💡 小贴士：");
    std::println("   - 可以尝试二分法：先猜 50，然后根据提示猜 25 或 75");
    std::println("   - 每次都选择剩余范围的中间值");
    std::println("   - 这样最多 7 次就能猜中任何数字！");
    std::println("   - 🚀 现在你可以使用链式调用让代码更优雅！");
}