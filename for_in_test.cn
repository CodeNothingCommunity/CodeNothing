// For-in loop test
using ns lang;

fn main() : int {
    lang::println("Testing for-in loop");
    
    var numbers : array<int> = [10, 20, 30];
    for (num in numbers) {
        lang::print("Value: ");
        lang::println(lang::to_string(num));
    }
    
    lang::println("For-in completed");
    return 0;
}
