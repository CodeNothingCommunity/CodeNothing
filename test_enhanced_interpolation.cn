// 测试增强的字符串插值功能

using ns lang;

fn main() : int {
    lang::println("🧪 测试增强的字符串插值功能");
    lang::println("================================");
    
    // 1. 测试嵌套字符串字面量
    lang::println("1. 嵌套字符串字面量测试：");
    var condition : bool = true;
    var ternary_with_strings : string = "结果：${condition ? \"真值\" : \"假值\"}";
    lang::println(ternary_with_strings);
    
    // 2. 测试空表达式
    lang::println("2. 空表达式测试：");
    var empty_expr : string = "前缀${}后缀";
    lang::println(empty_expr);
    
    // 3. 测试只有空格的表达式
    lang::println("3. 空格表达式测试：");
    var space_expr : string = "前缀${   }后缀";
    lang::println(space_expr);
    
    // 4. 测试复杂的嵌套字符串
    lang::println("4. 复杂嵌套字符串测试：");
    var name : string = "Alice";
    var age : int = 25;
    var complex : string = "用户信息：${age > 18 ? \"成年人 \" + name : \"未成年人 \" + name}";
    lang::println(complex);
    
    // 5. 测试转义字符
    lang::println("5. 转义字符测试：");
    var escaped : string = "引号测试：${\"包含\\\"引号\\\"的字符串\"}";
    lang::println(escaped);
    
    return 0;
}
