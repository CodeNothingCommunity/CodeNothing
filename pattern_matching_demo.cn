// 🎯 CodeNothing 模式匹配功能演示
// 展示 CodeNothing 编程语言的模式匹配能力

lib <io>;

fn demo_basic_patterns() {
    std::println("🔹 基本模式匹配");
    std::println("================");
    
    // 整数模式匹配
    var number : int = 42;
    var result : string = match number {
        0 => "零",
        1 => "一",
        42 => "生命的答案",
        100 => "一百",
        _ => "其他数字",
    };
    std::println("数字 " + to_string(number) + " 匹配结果: " + result);
    
    // 字符串模式匹配
    var language : string = "CodeNothing";
    var description : string = match language {
        "Rust" => "系统编程语言",
        "Python" => "脚本语言",
        "JavaScript" => "Web语言",
        "CodeNothing" => "我们自己的语言!",
        _ => "未知语言",
    };
    std::println("语言 " + language + " 描述: " + description);
    
    // 布尔值模式匹配
    var is_awesome : bool = true;
    var status : string = match is_awesome {
        true => "太棒了!",
        false => "还需要改进",
    };
    std::println("CodeNothing 很棒吗? " + status);
}

fn demo_nested_patterns() {
    std::println("");
    std::println("🔹 嵌套模式匹配");
    std::println("================");
    
    var user_type : int = 1;
    var is_logged_in : bool = true;
    
    var access_message : string = match user_type {
        1 => match is_logged_in {
            true => "管理员已登录 - 完全访问权限",
            false => "管理员未登录 - 请先登录",
        },
        2 => match is_logged_in {
            true => "普通用户已登录 - 基本访问权限",
            false => "普通用户未登录 - 请先登录",
        },
        _ => "未知用户类型",
    };
    std::println("访问控制: " + access_message);
}

fn demo_match_expressions() {
    std::println("");
    std::println("🔹 Match 作为表达式");
    std::println("==================");
    
    var day_of_week : int = 5;
    
    // 直接在函数调用中使用 match
    std::println("今天是 " + match day_of_week {
        1 => "星期一",
        2 => "星期二",
        3 => "星期三", 
        4 => "星期四",
        5 => "星期五",
        6 => "星期六",
        7 => "星期日",
        _ => "无效日期",
    } + "!");
    
    // 在算术表达式中使用 match
    var base_score : int = 85;
    var bonus : int = match base_score {
        90 => 10,
        80 => 5,
        70 => 2,
        _ => 0,
    };
    var final_score : int = base_score + bonus;
    std::println("基础分数: " + to_string(base_score) + ", 奖励分数: " + to_string(bonus) + ", 最终分数: " + to_string(final_score));
}

fn demo_complex_scenarios() {
    std::println("");
    std::println("🔹 复杂场景演示");
    std::println("================");
    
    // 模拟一个简单的状态机
    var state : string = "processing";
    var next_action : string = match state {
        "idle" => "开始处理",
        "processing" => "继续处理",
        "completed" => "清理资源",
        "error" => "重试或报告错误",
        _ => "未知状态",
    };
    std::println("当前状态: " + state + " -> 下一步动作: " + next_action);
    
    // 模拟 HTTP 状态码处理
    var status_code : int = 404;
    var response : string = match status_code {
        200 => "请求成功",
        201 => "资源已创建",
        400 => "请求错误",
        401 => "未授权",
        403 => "禁止访问",
        404 => "资源未找到",
        500 => "服务器内部错误",
        _ => "未知状态码",
    };
    std::println("HTTP " + to_string(status_code) + ": " + response);
    
    // 模拟游戏等级系统
    var experience_points : int = 2500;
    var level : string = match experience_points {
        0 => "新手",
        1000 => "初级",
        2000 => "中级",
        3000 => "高级",
        5000 => "专家",
        _ => "根据经验值确定等级",
    };
    std::println("经验值: " + to_string(experience_points) + " -> 等级: " + level);
}

fn demo_wildcard_power() {
    std::println("");
    std::println("🔹 通配符的威力");
    std::println("================");
    
    var mystery_number : int = 12345;
    var category : string = match mystery_number {
        1 => "第一个",
        2 => "第二个",
        3 => "第三个",
        _ => "所有其他数字都在这里处理!",
    };
    std::println("神秘数字 " + to_string(mystery_number) + " 分类: " + category);
    
    var unknown_string : string = "Hello World";
    var greeting_type : string = match unknown_string {
        "Hi" => "非正式问候",
        "Hello" => "正式问候",
        "Hey" => "随意问候",
        _ => "其他类型的文本",
    };
    std::println("文本 '" + unknown_string + "' 类型: " + greeting_type);
}

fn main() : int {
    std::println("🚀 CodeNothing 模式匹配功能演示");
    std::println("===================================");
    std::println("");
    
    demo_basic_patterns();
    demo_nested_patterns();
    demo_match_expressions();
    demo_complex_scenarios();
    demo_wildcard_power();
    
    std::println("");
    std::println("🎉 演示完成!");
    std::println("");
    std::println("CodeNothing 模式匹配功能特性:");
    std::println("✅ 支持整数、字符串、布尔值字面量模式");
    std::println("✅ 支持通配符模式 (_)");
    std::println("✅ 支持嵌套模式匹配");
    std::println("✅ Match 表达式可以用在任何需要值的地方");
    std::println("✅ 编译时模式完整性检查");
    std::println("✅ 高效的运行时模式匹配");
    std::println("");
    std::println("🔥 CodeNothing: 让模式匹配变得简单而强大!");
    
    return 0;
}
