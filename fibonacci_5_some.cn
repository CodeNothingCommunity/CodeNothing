using ns lang;

fn main() : int {
    // 计算斐波那契第5项
    println("斐波那契第5项");
    println("================================");
    let memo_result : int = 斐波那契(5);
    println("F(5) = " + to_string(memo_result));

    return memo_result;
}

memo{
fn 斐波那契(n: int) : int {
    if (n <= 1) {
        return n;
    }
    return 斐波那契(n - 1) + 斐波那契(n - 2);
}
}

