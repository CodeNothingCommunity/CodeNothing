// Do-while loop test
using ns lang;

fn main() : int {
    lang::println("Testing do-while loop");
    
    var counter : int = 1;
    do {
        lang::print("Do-while: ");
        lang::println(lang::to_string(counter));
        counter = counter + 1;
    } while (counter <= 3);
    
    lang::println("Do-while completed");
    return 0;
}
