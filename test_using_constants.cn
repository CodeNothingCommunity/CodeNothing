// 测试 using ns constants 功能

lib <math>;
lib <io>;
using ns constants;

fn main() {
    std::println("测试数学常数命名空间");
    
    var pi_val := pi();
    var e_val := e();
    var phi_val := phi();
    var sqrt2_val := sqrt2();
    
    std::println("π = " + pi_val);
    std::println("e = " + e_val);
    std::println("φ (黄金比例) = " + phi_val);
    std::println("√2 = " + sqrt2_val);
}
