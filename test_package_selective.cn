// Test selective imports and aliases
package selective_test version "1.0.0";

// Selective import with aliases
import math { add as plus, factorial as fact, PI };
import utils { max as maximum, concat_strings };

fn test_selective_imports() {
    // Use aliased functions
    var result1 = plus(10, 20);
    var result2 = fact(4);
    var result3 = maximum(result1, result2);
    
    // Use non-aliased imports
    var text = concat_strings("Result: ", result3);
    var circle_calc = PI * 2.0;
    
    print(text);
    print("Circle calculation: " + circle_calc);
}

fn main() {
    test_selective_imports();
}
