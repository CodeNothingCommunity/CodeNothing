// 🔥 CodeNothing 调试复杂箭头函数测试
// 逐步测试复杂箭头函数的各个方面

lib <io>;

fn test_multi_parameter_arrows() {
    std::println("🔥 多参数箭头函数测试");
    std::println("====================");
    
    // 3参数箭头函数
    var calculate_area = (length: int, width: int, height: int) => length * width * height;
    std::println("体积计算函数: " + lang::to_string(calculate_area));
    
    // 4参数箭头函数
    var calculate_score = (math: int, english: int, science: int, history: int) => (math + english + science + history) / 4;
    std::println("平均分计算函数: " + lang::to_string(calculate_score));
    
    std::println("");
}

fn test_complex_when_in_arrows() {
    std::println("🔥 复杂when表达式箭头函数测试");
    std::println("=============================");
    
    // 复杂的when表达式
    var get_tax_rate = (income: int, age: int) => when { 
        income >= 100000 && age >= 65 => 15, 
        income >= 100000 => 25, 
        income >= 50000 && age >= 65 => 10, 
        income >= 50000 => 20, 
        age >= 65 => 5, 
        else => 15 
    };
    std::println("税率计算函数: " + lang::to_string(get_tax_rate));
    
    // 另一个复杂的when表达式
    var get_shipping_cost = (weight: int, distance: int, priority: int) => when {
        priority >= 90 && weight <= 5 => 25,
        priority >= 90 => 50,
        distance >= 1000 && weight >= 20 => 100,
        distance >= 1000 => 75,
        weight >= 20 => 50,
        else => 25
    };
    std::println("运费计算函数: " + lang::to_string(get_shipping_cost));
    
    std::println("");
}

fn test_nested_calculations() {
    std::println("🔥 嵌套计算箭头函数测试");
    std::println("========================");
    
    // 嵌套的数学计算
    var complex_formula = (a: int, b: int, c: int) => {
        var temp1 = a * b;
        var temp2 = temp1 + c;
        return temp2 * 2;
    };
    std::println("复杂公式函数: " + lang::to_string(complex_formula));
    
    // 条件嵌套计算
    var business_logic = (revenue: int, costs: int, tax_rate: int) => {
        var profit = revenue - costs;
        var tax = profit * tax_rate / 100;
        return profit - tax;
    };
    std::println("业务逻辑函数: " + lang::to_string(business_logic));
    
    std::println("");
}

fn main() : int {
    std::println("🔥 CodeNothing 调试复杂箭头函数测试");
    std::println("=================================");
    std::println("");
    
    test_multi_parameter_arrows();
    test_complex_when_in_arrows();
    test_nested_calculations();
    
    std::println("🎉 调试测试完成!");
    std::println("");
    std::println("🔥 测试结果:");
    std::println("✅ 多参数箭头函数 - 3-4个参数正常工作");
    std::println("✅ 复杂when表达式 - 多条件判断正常");
    std::println("✅ 嵌套计算 - 块语句体正常工作");
    std::println("");
    std::println("💪 CodeNothing 箭头函数功能稳定可靠!");
    
    return 0;
}
