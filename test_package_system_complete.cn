// Complete package system test
import math;
import utils;

fn main() : int {
    // Test math package functions
    var a: int = 10;
    var b: int = 5;
    
    var sum: int = math.add(a, b);
    var diff: int = math.subtract(a, b);
    var prod: int = math.multiply(a, b);
    var quot: int = math.divide(a, b);
    
    // Test utils package functions
    var is_a_even: int = utils.is_even(a);
    var max_val: int = utils.max(a, b);
    var min_val: int = utils.min(a, b);
    
    // Test mathematical functions
    var fact5: int = math.factorial(5);
    var pow23: int = math.power(2, 3);
    var gcd_result: int = math.gcd(12, 8);
    
    return 0;
}
