// 🚀 CodeNothing 箭头函数测试
// 测试新实现的箭头函数语法糖

lib <io>;

fn test_basic_arrow_functions() {
    std::println("🔥 基础箭头函数测试");
    std::println("==================");
    
    // 单参数箭头函数
    var double = x => x * 2;
    std::println("单参数箭头函数: " + lang::to_string(double));
    
    // 多参数箭头函数
    var add = (x, y) => x + y;
    std::println("多参数箭头函数: " + lang::to_string(add));
    
    // 带类型注解的箭头函数
    var multiply = (x: int, y: int) => x * y;
    std::println("带类型注解的箭头函数: " + lang::to_string(multiply));
    
    std::println("");
}

fn test_arrow_function_with_blocks() {
    std::println("🔥 块语句箭头函数测试");
    std::println("====================");
    
    // 块语句箭头函数
    var complex_calc = (x, y) => {
        var temp = x + y;
        return temp * 2;
    };
    std::println("块语句箭头函数: " + lang::to_string(complex_calc));
    
    // 条件逻辑的箭头函数
    var max_value = (a, b) => {
        if (a > b) {
            return a;
        } else {
            return b;
        }
    };
    std::println("条件逻辑箭头函数: " + lang::to_string(max_value));
    
    std::println("");
}

fn test_arrow_functions_in_expressions() {
    std::println("🔥 表达式中的箭头函数测试");
    std::println("========================");
    
    // 在变量声明中使用箭头函数
    var square = x => x * x;
    var cube = x => x * x * x;
    
    std::println("平方函数: " + lang::to_string(square));
    std::println("立方函数: " + lang::to_string(cube));
    
    // 字符串处理的箭头函数
    var greet = name => "Hello, " + name + "!";
    std::println("问候函数: " + lang::to_string(greet));
    
    // 布尔逻辑的箭头函数
    var is_even = n => n % 2 == 0;
    var is_positive = n => n > 0;
    
    std::println("偶数判断函数: " + lang::to_string(is_even));
    std::println("正数判断函数: " + lang::to_string(is_positive));
    
    std::println("");
}

fn test_complex_arrow_functions() {
    std::println("🔥 复杂箭头函数测试");
    std::println("==================");
    
    // 数学计算的箭头函数
    var calculate_area = (width, height) => width * height;
    var calculate_perimeter = (width, height) => 2 * (width + height);
    
    std::println("面积计算函数: " + lang::to_string(calculate_area));
    std::println("周长计算函数: " + lang::to_string(calculate_perimeter));
    
    // 字符串操作的箭头函数
    var format_name = (first, last) => first + " " + last;
    var create_email = (name, domain) => name + "@" + domain;
    
    std::println("姓名格式化函数: " + lang::to_string(format_name));
    std::println("邮箱创建函数: " + lang::to_string(create_email));
    
    // 条件表达式的箭头函数
    var get_grade = score => when { score >= 90 => "A", score >= 80 => "B", score >= 70 => "C", else => "F" };
    var get_status = age => when { age >= 18 => "成年人", age >= 13 => "青少年", else => "儿童" };
    
    std::println("成绩评定函数: " + lang::to_string(get_grade));
    std::println("年龄状态函数: " + lang::to_string(get_status));
    
    std::println("");
}

fn test_arrow_functions_with_advanced_features() {
    std::println("🔥 高级特性箭头函数测试");
    std::println("======================");
    
    // 与空值合并操作符结合
    var safe_divide = (a, b) => b != 0 ? a / b : 0;
    var get_name = (user, default_name) => user ?? default_name;
    
    std::println("安全除法函数: " + lang::to_string(safe_divide));
    std::println("获取姓名函数: " + lang::to_string(get_name));
    
    // 与字符串插值结合
    var create_message = (name, age) => "用户 ${name} 今年 ${age} 岁";
    var format_price = (price, currency) => "${currency} ${price}";
    
    std::println("创建消息函数: " + lang::to_string(create_message));
    std::println("价格格式化函数: " + lang::to_string(format_price));
    
    // 复杂的业务逻辑箭头函数
    var calculate_discount = (price, customer_type) => when {
        customer_type == "vip" => price * 0.8,
        customer_type == "member" => price * 0.9,
        price > 100 => price * 0.95,
        else => price
    };
    
    var determine_shipping = (weight, distance) => when {
        weight <= 1 && distance <= 10 => 5,
        weight <= 5 && distance <= 50 => 15,
        weight <= 10 => 25,
        else => 50
    };
    
    std::println("折扣计算函数: " + lang::to_string(calculate_discount));
    std::println("运费计算函数: " + lang::to_string(determine_shipping));
    
    std::println("");
}

fn test_practical_arrow_function_scenarios() {
    std::println("🔥 实际应用场景箭头函数测试");
    std::println("==========================");
    
    // 数据处理函数
    var normalize_score = score => when { score > 100 => 100, score < 0 => 0, else => score };
    var calculate_tax = income => when { income <= 50000 => income * 0.1, income <= 100000 => income * 0.15, else => income * 0.2 };
    
    std::println("分数标准化函数: " + lang::to_string(normalize_score));
    std::println("税收计算函数: " + lang::to_string(calculate_tax));
    
    // 验证函数
    var is_valid_email = email => email != "" && email.contains("@");
    var is_strong_password = password => password.length() >= 8;
    
    std::println("邮箱验证函数: " + lang::to_string(is_valid_email));
    std::println("密码强度验证函数: " + lang::to_string(is_strong_password));
    
    // 格式化函数
    var format_currency = amount => "$" + lang::to_string(amount);
    var format_percentage = ratio => lang::to_string(ratio * 100) + "%";
    
    std::println("货币格式化函数: " + lang::to_string(format_currency));
    std::println("百分比格式化函数: " + lang::to_string(format_percentage));
    
    // 业务规则函数
    var can_vote = age => age >= 18;
    var can_drive = age => age >= 16;
    var can_drink = age => age >= 21;
    
    std::println("投票资格函数: " + lang::to_string(can_vote));
    std::println("驾驶资格函数: " + lang::to_string(can_drive));
    std::println("饮酒资格函数: " + lang::to_string(can_drink));
    
    std::println("");
}

fn main() : int {
    std::println("🚀 CodeNothing 箭头函数完整测试套件");
    std::println("=================================");
    std::println("");
    
    test_basic_arrow_functions();
    test_arrow_function_with_blocks();
    test_arrow_functions_in_expressions();
    test_complex_arrow_functions();
    test_arrow_functions_with_advanced_features();
    test_practical_arrow_function_scenarios();
    
    std::println("🎉 所有箭头函数测试完成!");
    std::println("");
    std::println("🔥 箭头函数功能总结:");
    std::println("✅ 单参数简洁语法 - x => expression");
    std::println("✅ 多参数语法 - (x, y) => expression");
    std::println("✅ 类型注解支持 - (x: int, y: int) => expression");
    std::println("✅ 表达式体 - 简洁的单行表达式");
    std::println("✅ 块语句体 - 复杂的多行逻辑");
    std::println("✅ 与其他语法糖结合 - when表达式、空值合并、字符串插值");
    std::println("✅ 实际应用场景 - 数据处理、验证、格式化、业务规则");
    std::println("");
    std::println("💪 CodeNothing 箭头函数功能强大且实用!");
    std::println("🚀 现代化函数式编程特性完美支持!");
    
    return 0;
}
