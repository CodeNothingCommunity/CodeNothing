// 🚀 CodeNothing 箭头函数最终综合测试
// 验证所有修复的功能和复杂应用场景

lib <io>;

fn test_all_syntax_variations() {
    std::println("🎯 所有语法变体测试");
    std::println("==================");
    
    // ✅ 1. 带括号的单参数
    var single_with_parens = (x: int) => x * 2;
    std::println("✅ 带括号单参数: " + lang::to_string(single_with_parens));
    
    // ✅ 2. 无括号的单参数 (新修复)
    var single_no_parens = x: int => x * 3;
    std::println("✅ 无括号单参数: " + lang::to_string(single_no_parens));
    
    // ✅ 3. 多参数
    var multi_params = (a: int, b: int, c: int) => a + b + c;
    std::println("✅ 多参数: " + lang::to_string(multi_params));
    
    // ✅ 4. 空参数
    var no_params = () => 42;
    std::println("✅ 空参数: " + lang::to_string(no_params));
    
    // ✅ 5. 嵌套箭头函数 (新修复)
    var nested_arrow = (x: int) => (y: int) => x + y;
    std::println("✅ 嵌套箭头函数: " + lang::to_string(nested_arrow));
    
    // ✅ 6. 带括号的嵌套箭头函数
    var nested_with_parens = (x: int) => ((y: int) => x * y);
    std::println("✅ 带括号嵌套: " + lang::to_string(nested_with_parens));
    
    std::println("");
}

fn test_complex_expressions() {
    std::println("🔥 复杂表达式测试");
    std::println("================");
    
    // 复杂数学表达式
    var complex_math = (a: int, b: int, c: int) => (a + b) * c - (a * b) / (c + 1);
    std::println("✅ 复杂数学: " + lang::to_string(complex_math));
    
    // 嵌套when表达式
    var nested_when = (score: int, bonus: int) => when {
        score >= 90 && bonus >= 10 => when { score >= 95 => "Perfect", else => "Excellent" },
        score >= 80 => when { bonus >= 5 => "Good+", else => "Good" },
        score >= 70 => "Average",
        else => "Poor"
    };
    std::println("✅ 嵌套when: " + lang::to_string(nested_when));
    
    // 字符串处理
    var string_processing = (first: string, last: string, title: string) => title + " " + first + " " + last;
    std::println("✅ 字符串处理: " + lang::to_string(string_processing));
    
    std::println("");
}

fn test_higher_order_patterns() {
    std::println("🚀 高阶函数模式测试");
    std::println("==================");
    
    // 函数工厂模式
    var create_adder = (increment: int) => (value: int) => value + increment;
    std::println("✅ 函数工厂: " + lang::to_string(create_adder));
    
    // 函数组合模式
    var create_transformer = (operation: string) => when {
        operation == "double" => (x: int) => x * 2,
        operation == "square" => (x: int) => x * x,
        operation == "negate" => (x: int) => -x,
        else => (x: int) => x
    };
    std::println("✅ 函数组合: " + lang::to_string(create_transformer));
    
    // 条件函数生成
    var create_validator = (min: int, max: int) => (value: int) => when {
        value < min => 0,
        value > max => 0,
        else => 1
    };
    std::println("✅ 条件函数生成: " + lang::to_string(create_validator));
    
    std::println("");
}

fn test_real_world_applications() {
    std::println("🌍 真实世界应用测试");
    std::println("==================");
    
    // 电商价格计算系统
    var create_price_calculator = (base_tax: int) => (price: int, discount: int, shipping: int) => {
        var discounted = price * (100 - discount) / 100;
        var taxed = discounted * (100 + base_tax) / 100;
        return taxed + shipping;
    };
    std::println("✅ 价格计算系统: " + lang::to_string(create_price_calculator));
    
    // 用户权限系统
    var create_permission_checker = (admin_level: int) => (user_level: int, resource: string, action: string) => when {
        user_level >= admin_level => 1,
        user_level >= 5 && action == "read" => 1,
        user_level >= 3 && action == "read" && resource == "public" => 1,
        else => 0
    };
    std::println("✅ 权限系统: " + lang::to_string(create_permission_checker));
    
    // 数据验证管道
    var create_data_validator = (strict_mode: int) => (name: string, email: string, age: int) => when {
        strict_mode == 1 && name.length() < 3 => "name_too_short",
        strict_mode == 1 && !email.contains("@") => "invalid_email",
        strict_mode == 1 && age < 13 => "too_young",
        name.length() < 1 => "name_required",
        age < 0 => "invalid_age",
        else => "valid"
    };
    std::println("✅ 数据验证管道: " + lang::to_string(create_data_validator));
    
    // 成绩计算系统
    var create_grade_calculator = (curve: int) => (scores: int, homework: int, participation: int) => {
        var weighted = scores * 70 / 100 + homework * 20 / 100 + participation * 10 / 100;
        var curved = weighted + curve;
        return when {
            curved >= 95 => "A+",
            curved >= 90 => "A",
            curved >= 85 => "B+",
            curved >= 80 => "B",
            curved >= 75 => "C+",
            curved >= 70 => "C",
            curved >= 65 => "D",
            else => "F"
        };
    };
    std::println("✅ 成绩计算系统: " + lang::to_string(create_grade_calculator));
    
    std::println("");
}

fn test_edge_cases_and_limits() {
    std::println("🔍 边界情况和极限测试");
    std::println("====================");
    
    // 多层嵌套
    var triple_nested = (a: int) => (b: int) => (c: int) => a + b + c;
    std::println("✅ 三层嵌套: " + lang::to_string(triple_nested));
    
    // 长参数列表
    var many_params = (a: int, b: int, c: int, d: int, e: int, f: int, g: int) => a + b + c + d + e + f + g;
    std::println("✅ 长参数列表: " + lang::to_string(many_params));
    
    // 复杂类型推断
    var type_inference_complex = (flag: int, mode: string) => when {
        flag == 1 && mode == "strict" => "strict_mode_1",
        flag == 2 && mode == "loose" => "loose_mode_2",
        flag >= 3 => "high_flag_" + mode,
        else => "default_" + mode
    };
    std::println("✅ 复杂类型推断: " + lang::to_string(type_inference_complex));
    
    // 混合语法糖
    var mixed_syntax = (base: int, factor: int) => when {
        factor > 0 => (multiplier: int) => base * factor * multiplier,
        factor < 0 => (divider: int) => when { divider != 0 => base / divider, else => 0 },
        else => (identity: int) => identity
    };
    std::println("✅ 混合语法糖: " + lang::to_string(mixed_syntax));
    
    std::println("");
}

