// 测试硬编码修复的脚本
// 这个脚本测试所有修复的硬编码功能

// 测试主函数
function main() : void {
    lang::println("=== 硬编码修复测试 ===");

    // 测试循环常量修复
    lang::println("1. 测试循环常量修复:");
    
    // 测试范围循环
    lang::println("   范围循环 (1..4):");
    for (i : 1..4) {
        lang::println("     i = " + lang::to_string(i));
    }
    
    // 测试包含范围循环
    lang::println("   包含范围循环 (1..=3):");
    for (i : 1..=3) {
        lang::println("     i = " + lang::to_string(i));
    }
    
    // 测试for-in循环
    lang::println("   For-in循环:");
    var numbers : array<int> = [100, 200, 300];
    for (value in numbers) {
        lang::println("     value = " + lang::to_string(value));
    }
    
    // 测试do-while循环
    lang::println("   Do-while循环:");
    var counter : int = 1;
    do {
        lang::println("     counter = " + lang::to_string(counter));
        counter = counter + 1;
    } while (counter <= 3);
    
    // 测试数组创建
    lang::println("2. 测试数组创建:");
    var test_array : array<string> = ["hello", "world", "test"];
    for (item in test_array) {
        lang::println("   数组项: " + item);
    }
    
    lang::println("=== 所有测试完成 ===");
}
