// 🎯 CodeNothing 模式匹配实际应用场景演示
// 展示模式匹配在真实世界中的强大应用

lib <io>;

// 应用场景1: 文件类型处理器
fn file_type_processor() {
    std::println("📁 应用场景1: 文件类型处理器");
    std::println("============================");
    
    var filename : string = "document.pdf";
    var file_extension : string = "pdf";
    
    var processor : string = match file_extension {
        "txt" => "文本编辑器",
        "doc" => "Microsoft Word",
        "docx" => "Microsoft Word",
        "pdf" => "PDF阅读器",
        "jpg" => "图像查看器",
        "jpeg" => "图像查看器", 
        "png" => "图像查看器",
        "gif" => "图像查看器",
        "mp3" => "音频播放器",
        "mp4" => "视频播放器",
        "avi" => "视频播放器",
        "zip" => "压缩工具",
        "rar" => "压缩工具",
        "exe" => "可执行程序",
        "html" => "网页浏览器",
        "css" => "代码编辑器",
        "js" => "代码编辑器",
        "py" => "Python IDE",
        "java" => "Java IDE",
        "cpp" => "C++ IDE",
        "rs" => "Rust IDE",
        _ => "默认程序",
    };
    
    std::println("文件: " + filename);
    std::println("推荐程序: " + processor);
    std::println("");
}

// 应用场景2: 网络请求路由器
fn network_router() {
    std::println("🌐 应用场景2: 网络请求路由器");
    std::println("============================");
    
    var request_method : string = "POST";
    var endpoint : string = "/api/users";
    var user_role : string = "admin";
    
    var handler : string = match request_method {
        "GET" => match endpoint {
            "/api/users" => "获取用户列表",
            "/api/posts" => "获取文章列表",
            "/api/comments" => "获取评论列表",
            "/health" => "健康检查",
            _ => "GET请求 - 未知端点",
        },
        "POST" => match endpoint {
            "/api/users" => match user_role {
                "admin" => "创建新用户 (管理员权限)",
                "user" => "注册新账户 (普通用户)",
                _ => "权限不足",
            },
            "/api/posts" => "创建新文章",
            "/api/login" => "用户登录",
            _ => "POST请求 - 未知端点",
        },
        "PUT" => match endpoint {
            "/api/users" => "更新用户信息",
            "/api/posts" => "更新文章",
            _ => "PUT请求 - 未知端点",
        },
        "DELETE" => match endpoint {
            "/api/users" => match user_role {
                "admin" => "删除用户 (管理员权限)",
                _ => "删除权限不足",
            },
            "/api/posts" => "删除文章",
            _ => "DELETE请求 - 未知端点",
        },
        _ => "不支持的HTTP方法",
    };
    
    std::println("请求: " + request_method + " " + endpoint);
    std::println("用户角色: " + user_role);
    std::println("处理器: " + handler);
    std::println("");
}

// 应用场景3: 游戏AI决策系统
fn game_ai_decision() {
    std::println("🎮 应用场景3: 游戏AI决策系统");
    std::println("============================");
    
    var enemy_type : string = "boss";
    var player_health : int = 30;
    var player_distance : int = 5;
    var has_special_weapon : bool = true;
    
    var ai_action : string = match enemy_type {
        "goblin" => match player_distance {
            1 => "近战攻击",
            2 => "近战攻击",
            3 => "移动靠近",
            _ => "巡逻",
        },
        "archer" => match player_distance {
            1 => "后退并射击",
            2 => "后退并射击",
            _ => "远程射击",
        },
        "mage" => match player_health {
            0 => "停止攻击",
            _ => match player_distance {
                1 => "传送逃跑",
                2 => "传送逃跑",
                _ => "施放魔法",
            },
        },
        "boss" => match player_health {
            0 => "胜利动画",
            _ => match has_special_weapon {
                true => match player_distance {
                    1 => "使用终极技能",
                    2 => "使用终极技能",
                    3 => "召唤小怪",
                    4 => "召唤小怪",
                    5 => "激光攻击",
                    _ => "移动到攻击位置",
                },
                false => match player_distance {
                    1 => "重击攻击",
                    2 => "重击攻击",
                    _ => "普通攻击",
                },
            },
        },
        _ => "默认AI行为",
    };
    
    std::println("敌人类型: " + enemy_type);
    std::println("玩家血量: " + lang::to_string(player_health));
    std::println("距离: " + lang::to_string(player_distance));
    std::println("特殊武器: " + lang::to_string(has_special_weapon));
    std::println("AI决策: " + ai_action);
    std::println("");
}

// 应用场景4: 金融风险评估系统
fn financial_risk_assessment() {
    std::println("💰 应用场景4: 金融风险评估系统");
    std::println("==============================");
    
    var credit_score : int = 750;
    var income_level : string = "high";
    var employment_status : string = "employed";
    var loan_amount : int = 50000;
    
    var risk_level : string = match credit_score {
        0 => "极高风险",
        _ => match credit_score {
            _ => match income_level {
                "low" => match employment_status {
                    "employed" => "中等风险",
                    "unemployed" => "高风险",
                    _ => "高风险",
                },
                "medium" => match employment_status {
                    "employed" => match loan_amount {
                        0 => "低风险",
                        _ => match loan_amount {
                            _ => "低风险",
                        },
                    },
                    _ => "中等风险",
                },
                "high" => match employment_status {
                    "employed" => match loan_amount {
                        0 => "极低风险",
                        _ => "低风险",
                    },
                    _ => "中等风险",
                },
                _ => "未知风险",
            },
        },
    };
    
    var approval_status : string = match risk_level {
        "极低风险" => "立即批准",
        "低风险" => "快速批准",
        "中等风险" => "需要审核",
        "高风险" => "需要额外担保",
        "极高风险" => "拒绝申请",
        _ => "需要人工审核",
    };
    
    std::println("信用评分: " + lang::to_string(credit_score));
    std::println("收入水平: " + income_level);
    std::println("就业状态: " + employment_status);
    std::println("贷款金额: " + lang::to_string(loan_amount));
    std::println("风险等级: " + risk_level);
    std::println("审批状态: " + approval_status);
    std::println("");
}

// 应用场景5: 智能家居控制系统
fn smart_home_controller() {
    std::println("🏠 应用场景5: 智能家居控制系统");
    std::println("==============================");
    
    var time_of_day : int = 20;
    var occupancy : string = "occupied";
    var weather : string = "rainy";
    var energy_mode : string = "eco";
    
    var home_action : string = match time_of_day {
        6 => "晨起模式",
        7 => "晨起模式",
        8 => "晨起模式",
        _ => match time_of_day {
            18 => "傍晚模式",
            19 => "傍晚模式",
            20 => match occupancy {
                "occupied" => match weather {
                    "sunny" => "舒适模式",
                    "rainy" => match energy_mode {
                        "eco" => "节能雨天模式",
                        "comfort" => "舒适雨天模式",
                        _ => "标准雨天模式",
                    },
                    "snowy" => "温暖模式",
                    _ => "标准晚间模式",
                },
                "empty" => "节能模式",
                _ => "待机模式",
            },
            21 => "夜间模式",
            22 => "夜间模式",
            23 => "深夜模式",
            _ => "自动模式",
        },
    };
    
    std::println("时间: " + lang::to_string(time_of_day) + ":00");
    std::println("占用状态: " + occupancy);
    std::println("天气: " + weather);
    std::println("能源模式: " + energy_mode);
    std::println("家居控制: " + home_action);
    std::println("");
}

fn main() : int {
    std::println("🚀 CodeNothing 模式匹配实际应用场景演示");
    std::println("=======================================");
    std::println("");
    
    file_type_processor();
    network_router();
    game_ai_decision();
    financial_risk_assessment();
    smart_home_controller();
    
    std::println("🎉 所有实际应用场景演示完成!");
    std::println("");
    std::println("应用场景总结:");
    std::println("✅ 文件类型处理器 - 20+种文件格式");
    std::println("✅ 网络请求路由器 - RESTful API路由");
    std::println("✅ 游戏AI决策系统 - 复杂游戏逻辑");
    std::println("✅ 金融风险评估 - 多维度风险分析");
    std::println("✅ 智能家居控制 - 环境感知自动化");
    std::println("");
    std::println("🔥 CodeNothing 模式匹配功能在实际应用中表现卓越!");
    std::println("💡 为复杂业务逻辑提供了简洁而强大的解决方案!");
    
    return 0;
}
