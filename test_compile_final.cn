// 最终编译测试

class TestClass {
    public value: int;
    
    TestClass(val: int) {
        self.value = val;
    }
    
    public fn add(self: TestClass, amount: int): TestClass {
        self.value = self.value + amount;
        return self;
    }
    
    public fn get_value(self: TestClass): int {
        return self.value;
    }
}

fn double(x: int): int {
    return x * 2;
}

fn main(): int {
    var obj := TestClass(10);
    var result := obj.add(5).add(3).get_value();
    var piped := result |> double;
    return piped;  // 应该返回 36 (10+5+3)*2
}
