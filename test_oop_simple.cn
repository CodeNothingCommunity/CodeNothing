// 简单的 OOP 测试 - 测试修复后的 CodeNothing OOP 功能

lib <io>;

// 简单的游戏类
class SimpleGame {
    public player_name: string;
    public score: int;

    SimpleGame(name: string) {
        self.player_name = name;
        self.score = 0;
    }
    
    public fn get_name(self: SimpleGame): string {
        return self.player_name;
    }
    
    public fn add_score(self: SimpleGame, points: int): void {
        self.score = self.score + points;
    }
    
    public fn get_score(self: SimpleGame): int {
        return self.score;
    }
    
    public fn show_info(self: SimpleGame): void {
        std::println("玩家: " + self.player_name);
        std::println("得分: " + lang::to_string(self.score));
    }
}

fn main() {
    std::println("=== CodeNothing OOP 测试 ===");
    
    // 创建游戏对象
    var game := SimpleGame("Alice");
    
    // 测试方法调用
    std::println("玩家名字: " + game.get_name());
    
    // 添加得分
    game.add_score(100);
    game.add_score(50);
    
    // 显示信息
    game.show_info();
    
    std::println("=== 测试完成 ===");
}
