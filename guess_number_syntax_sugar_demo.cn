// 🍭 CodeNothing 猜数字游戏 - 语法糖展示版
// 展示自增/自减、复合赋值、三元条件操作符的实际应用

lib <math>;
lib <io>;

// 模拟游戏逻辑，展示语法糖的使用
fn demo_game_logic() {
    std::println("🍭 CodeNothing 猜数字游戏 - 语法糖展示");
    std::println("=====================================");
    std::println("");
    
    // 模拟游戏数据
    var target_number : int = 42;
    var max_attempts : int = 10;
    var attempts : int = 0;
    var score : int = 1000;
    var bonus_multiplier : int = 1;
    
    // 模拟几次猜测来展示语法糖
    var guesses : array<int> = [25, 60, 35, 45, 40, 42];
    var guess_count : int = 6;
    
    std::println("目标数字: " + lang::to_string(target_number));
    std::println("最大尝试次数: " + lang::to_string(max_attempts));
    std::println("初始分数: " + lang::to_string(score));
    std::println("");
    
    var i : int = 0;
    var found : bool = false;
    
    while (i < guess_count && !found) {
        var guess : int = guesses[i];
        
        // 🍭 语法糖1: 使用前置自增操作符
        std::println("第 " + lang::to_string(++attempts) + " 次猜测: " + lang::to_string(guess));
        
        if (guess == target_number) {
            found = true;
            std::println("🎉 猜对了！");
            
            // 🍭 语法糖2: 使用复合赋值操作符计算奖励分数
            score += 500;
            score *= bonus_multiplier > 1 ? bonus_multiplier : 2;
            
            std::println("获得奖励分数！当前分数: " + lang::to_string(score));
            
        } else {
            // 🍭 语法糖3: 使用三元条件操作符简化提示逻辑
            var hint : string = guess < target_number ? "太小了！" : "太大了！";
            var direction : string = guess < target_number ? "更大" : "更小";
            
            std::println("❌ " + hint + " 试试" + direction + "的数字");
            
            // 🍭 语法糖4: 使用复合赋值操作符扣分
            score -= attempts > 5 ? 100 : 50;
            score = score < 0 ? 0 : score; // 确保分数不为负
            
            // 🍭 语法糖5: 使用后置自增更新奖励倍数
            if (attempts % 3 == 0) {
                bonus_multiplier++;
                std::println("连续猜测奖励倍数增加: " + lang::to_string(bonus_multiplier));
            }
            
            std::println("当前分数: " + lang::to_string(score));
        }
        
        // 显示剩余机会
        var remaining : int = max_attempts - attempts;
        // 🍭 语法糖6: 嵌套三元条件操作符
        var remaining_msg : string = remaining > 0 ? (remaining > 5 ? "还有很多机会" : remaining > 2 ? "还有几次机会" : "最后几次机会了") + " (" + lang::to_string(remaining) + ")" : "没有机会了！";
        
        if (!found) {
            std::println(remaining_msg);
        }
        
        std::println("");
        i++;
    }
    
    // 最终评价
    if (found) {
        // 🍭 语法糖7: 复杂的三元条件操作符评价系统
        var performance : string = attempts == 1 ? "🌟 完美！" : attempts <= 3 ? "🔥 优秀！" : attempts <= 5 ? "👍 不错！" : attempts <= 7 ? "😊 还行！" : "🤔 需要练习！";
        
        std::println("🏆 游戏结束！" + performance);
        std::println("最终分数: " + lang::to_string(score));
        std::println("用时: " + lang::to_string(attempts) + " 次");
        
        // 🍭 语法糖8: 复合赋值计算最终奖励
        var final_bonus : int = 0;
        final_bonus += attempts <= 3 ? 200 : 100;
        final_bonus *= score > 1500 ? 2 : 1;
        
        if (final_bonus > 0) {
            score += final_bonus;
            std::println("额外奖励: " + lang::to_string(final_bonus));
            std::println("最终总分: " + lang::to_string(score));
        }
        
    } else {
        std::println("💔 游戏失败！没有在规定次数内猜中。");
        std::println("答案是: " + lang::to_string(target_number));
        std::println("最终分数: " + lang::to_string(score));
    }
}

// 展示语法糖在统计分析中的应用
fn demo_statistics_analysis() {
    std::println("📊 游戏统计分析 - 语法糖应用");
    std::println("============================");
    
    // 模拟多局游戏数据
    var game_attempts : array<int> = [3, 7, 2, 5, 8, 1, 6, 4, 9, 3];
    var game_scores : array<int> = [1500, 800, 1800, 1200, 600, 2000, 1000, 1300, 400, 1600];
    var total_games : int = 10;
    
    var total_attempts : int = 0;
    var total_score : int = 0;
    var best_attempts : int = 100;
    var worst_attempts : int = 0;
    var perfect_games : int = 0;
    var excellent_games : int = 0;
    
    var i : int = 0;
    while (i < total_games) {
        var attempts : int = game_attempts[i];
        var score : int = game_scores[i];
        
        // 🍭 语法糖: 使用复合赋值操作符累计统计
        total_attempts += attempts;
        total_score += score;
        
        // 🍭 语法糖: 使用三元条件操作符更新最佳/最差记录
        best_attempts = attempts < best_attempts ? attempts : best_attempts;
        worst_attempts = attempts > worst_attempts ? attempts : worst_attempts;
        
        // 🍭 语法糖: 使用自增操作符统计特殊成就
        if (attempts == 1) {
            perfect_games++;
        } else if (attempts <= 3) {
            excellent_games++;
        }
        
        std::println("游戏 " + lang::to_string(++i) + ": " + lang::to_string(attempts) + " 次猜中, 得分 " + lang::to_string(score));
    }
    
    // 计算平均值
    var avg_attempts : int = total_attempts / total_games;
    var avg_score : int = total_score / total_games;
    
    std::println("");
    std::println("📈 统计结果:");
    std::println("总游戏数: " + lang::to_string(total_games));
    std::println("平均尝试次数: " + lang::to_string(avg_attempts));
    std::println("平均分数: " + lang::to_string(avg_score));
    std::println("最佳记录: " + lang::to_string(best_attempts) + " 次");
    std::println("最差记录: " + lang::to_string(worst_attempts) + " 次");
    std::println("完美游戏 (1次): " + lang::to_string(perfect_games) + " 局");
    std::println("优秀游戏 (≤3次): " + lang::to_string(excellent_games) + " 局");
    
    // 🍭 语法糖: 复杂的三元条件操作符评级系统
    var overall_rating : string = avg_attempts <= 3 ? "🌟 大师级" :
                                 avg_attempts <= 5 ? "🔥 专家级" :
                                 avg_attempts <= 7 ? "👍 熟练级" :
                                 "🤔 新手级";
    
    std::println("整体评级: " + overall_rating);
    std::println("");
}

// 展示语法糖在配置和设置中的应用
fn demo_game_settings() {
    std::println("⚙️ 游戏设置优化 - 语法糖应用");
    std::println("============================");
    
    var difficulty : int = 2; // 1=简单, 2=普通, 3=困难
    var player_level : int = 5;
    var experience_points : int = 1250;
    var achievements_unlocked : int = 8;
    
    // 🍭 语法糖: 使用三元条件操作符配置游戏参数
    var max_attempts : int = difficulty == 1 ? 15 : difficulty == 2 ? 10 : 7;
    var score_multiplier : int = difficulty == 1 ? 1 : difficulty == 2 ? 2 : 3;
    var range_max : int = difficulty == 1 ? 50 : difficulty == 2 ? 100 : 200;
    
    std::println("当前设置:");
    std::println("难度级别: " + (difficulty == 1 ? "简单" : difficulty == 2 ? "普通" : "困难"));
    std::println("最大尝试次数: " + lang::to_string(max_attempts));
    std::println("分数倍数: " + lang::to_string(score_multiplier));
    std::println("数字范围: 1-" + lang::to_string(range_max));
    
    // 🍭 语法糖: 使用复合赋值操作符升级系统
    std::println("");
    std::println("玩家状态:");
    std::println("当前等级: " + lang::to_string(player_level));
    std::println("经验值: " + lang::to_string(experience_points));
    
    // 模拟升级检查
    var exp_needed : int = player_level * 300;
    if (experience_points >= exp_needed) {
        experience_points -= exp_needed;
        player_level++;
        achievements_unlocked += player_level % 5 == 0 ? 2 : 1; // 每5级额外奖励
        
        std::println("🎉 升级了！新等级: " + lang::to_string(player_level));
        std::println("解锁成就: " + lang::to_string(achievements_unlocked));
        std::println("剩余经验: " + lang::to_string(experience_points));
    }
    
    // 🍭 语法糖: 三元条件操作符特权系统
    var has_premium : bool = player_level >= 10;
    var bonus_attempts : int = has_premium ? 3 : 0;
    var bonus_hints : bool = achievements_unlocked >= 10;
    
    std::println("");
    std::println("特权状态:");
    std::println("高级会员: " + (has_premium ? "是" : "否"));
    std::println("额外尝试次数: " + lang::to_string(bonus_attempts));
    std::println("提示功能: " + (bonus_hints ? "已解锁" : "未解锁"));
    
    std::println("");
}

fn main() : int {
    std::println("🍭 CodeNothing 语法糖在猜数字游戏中的应用展示");
    std::println("=============================================");
    std::println("");
    
    demo_game_logic();
    std::println("");
    demo_statistics_analysis();
    demo_game_settings();
    
    std::println("🎉 语法糖展示完成！");
    std::println("");
    std::println("🍭 本演示展示的语法糖功能:");
    std::println("✅ 前置自增: ++attempts");
    std::println("✅ 后置自增: bonus_multiplier++");
    std::println("✅ 后置自减: attempts--");
    std::println("✅ 复合赋值: score += 500, total_attempts += attempts");
    std::println("✅ 三元条件操作符: condition ? true_value : false_value");
    std::println("✅ 嵌套三元操作符: 多层条件判断");
    std::println("✅ 复杂表达式组合: 语法糖的自然融合使用");
    std::println("");
    std::println("💡 语法糖让代码更简洁、更易读、更现代化！");
    
    return 0;
}
