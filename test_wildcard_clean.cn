// Clean wildcard test
using ns lang;

include "wildcard_utils_*.cn";

fn main() : int {
    lang::println("=== Clean Wildcard Test ===");

    var result1 : int = func_a(5);
    lang::print("func_a(5) = ");
    lang::println(lang::to_string(result1));

    var result2 : int = func_b(7);
    lang::print("func_b(7) = ");
    lang::println(lang::to_string(result2));

    lang::print("CONST_A = ");
    lang::println(lang::to_string(CONST_A));

    lang::print("CONST_B = ");
    lang::println(lang::to_string(CONST_B));

    return 0;
}
