// 逐步测试模式匹配功能

fn test_integer_match() : int {
    var x : int = 42;
    var result : int = match x {
        42 => 1,
        _ => 0,
    };
    return result;
}

fn test_string_match() : int {
    var name : string = "Alice";
    var result : int = match name {
        "Alice" => 1,
        "Bob" => 2,
        _ => 0,
    };
    return result;
}

fn test_boolean_match() : int {
    var flag : bool = true;
    var result : int = match flag {
        true => 1,
        false => 0,
    };
    return result;
}

fn main() : int {
    var test1 : int = test_integer_match();
    var test2 : int = test_string_match();
    var test3 : int = test_boolean_match();
    
    // 如果所有测试都通过，返回 3
    return test1 + test2 + test3;
}
