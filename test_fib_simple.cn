// 简单的斐波那契测试（不使用记忆化）

lib <io>;

fn main() {
    std::println("测试斐波那契功能");
    std::println("================");
    
    var result := fib(5);
    std::println("fib(5) = " + lang::to_string(result));
}

fn fib(n: int): int {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
