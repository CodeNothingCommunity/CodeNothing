// 简单的记忆化测试

lib <io>;

fn main() {
    std::println("测试记忆化功能");
    std::println("================");
    
    var result := fib(5);
    std::println("fib(5) = " + lang::to_string(result));
}

memo {
    fn fib(n: int): int {
        if (n <= 1) {
            return n;
        }
        return fib(n - 1) + fib(n - 2);
    }
}
