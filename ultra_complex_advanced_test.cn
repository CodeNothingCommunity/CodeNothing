// 🔥 CodeNothing 超复杂高级语法糖测试
// 测试极端复杂的语法糖组合和嵌套使用场景

lib <io>;

// 复杂的企业级应用模拟
fn complex_enterprise_system() {
    std::println("🔥 复杂企业级系统模拟");
    std::println("=====================");
    
    // 用户权限系统
    var user_role : string = "manager";
    var user_level : int = 7;
    var department : string = "engineering";
    var is_admin : bool = false;
    var temp_access : string = "";
    
    // 超复杂的权限判断系统
    var access_level : string = temp_access ?? when { 
        is_admin => "full_access",
        user_role == "ceo" => "executive_access",
        user_role == "manager" && user_level >= 8 => "senior_management",
        user_role == "manager" && user_level >= 5 => "middle_management", 
        user_role == "engineer" && department == "security" => "security_clearance",
        user_role == "engineer" && user_level >= 6 => "senior_engineer",
        user_role == "engineer" => "standard_engineer",
        else => "basic_access"
    };
    
    // 复杂的薪资计算系统
    var base_salary : int = 5000;
    var experience_years : int = 8;
    var performance_score : int = 85;
    var overtime_hours : int = 15;
    
    var salary_multiplier : int = when {
        performance_score >= 95 && experience_years >= 10 => 3,
        performance_score >= 90 && experience_years >= 8 => 2,
        performance_score >= 85 && experience_years >= 5 => 2,
        performance_score >= 80 => 1,
        else => 1
    };
    
    var overtime_bonus : int = when {
        overtime_hours >= 20 => overtime_hours * 100,
        overtime_hours >= 10 => overtime_hours * 80,
        overtime_hours >= 5 => overtime_hours * 60,
        else => 0
    };
    
    var department_bonus : int = when {
        department == "engineering" && user_level >= 7 => 1000,
        department == "sales" && performance_score >= 90 => 1500,
        department == "marketing" => 800,
        else => 500
    };
    
    var final_salary : int = (base_salary * salary_multiplier) + overtime_bonus + department_bonus;
    
    std::println("员工信息分析:");
    std::println("  角色: " + user_role + " (等级 " + lang::to_string(user_level) + ")");
    std::println("  部门: " + department);
    std::println("  访问权限: " + access_level);
    std::println("  基础薪资: " + lang::to_string(base_salary));
    std::println("  薪资倍数: " + lang::to_string(salary_multiplier));
    std::println("  加班奖金: " + lang::to_string(overtime_bonus));
    std::println("  部门奖金: " + lang::to_string(department_bonus));
    std::println("  最终薪资: " + lang::to_string(final_salary));
    std::println("");
}

// 复杂的游戏AI决策系统
fn complex_game_ai_system() {
    std::println("🔥 复杂游戏AI决策系统");
    std::println("====================");
    
    // AI状态变量
    var ai_health : int = 65;
    var ai_mana : int = 40;
    var ai_level : int = 12;
    var enemy_distance : int = 8;
    var enemy_health : int = 30;
    var available_spells : int = 3;
    var terrain_type : string = "forest";
    var weather : string = "rain";
    
    // 超复杂的AI决策树
    var ai_action : string = when {
        ai_health <= 20 && ai_mana >= 30 => "cast_heal",
        ai_health <= 20 && available_spells > 0 => "use_health_potion",
        ai_health <= 20 => "retreat",
        enemy_distance <= 3 && ai_mana >= 50 && enemy_health > 50 => "cast_fireball",
        enemy_distance <= 3 && ai_health > 60 => "melee_attack",
        enemy_distance <= 5 && ai_mana >= 25 && terrain_type == "forest" => "cast_nature_spell",
        enemy_distance <= 5 && weather == "rain" && ai_mana >= 20 => "cast_lightning",
        enemy_distance <= 8 && ai_level >= 10 => "cast_long_range_spell",
        enemy_distance > 8 && enemy_health <= 30 => "pursue_enemy",
        enemy_distance > 8 => "patrol_area",
        else => "defensive_stance"
    };
    
    // 复杂的资源管理
    var mana_cost : int = when {
        ai_action == "cast_fireball" => 50,
        ai_action == "cast_heal" => 30,
        ai_action == "cast_nature_spell" => 25,
        ai_action == "cast_lightning" => 20,
        ai_action == "cast_long_range_spell" => 35,
        else => 0
    };
    
    var stamina_cost : int = when {
        ai_action == "melee_attack" => 15,
        ai_action == "pursue_enemy" => 20,
        ai_action == "retreat" => 25,
        ai_action == "patrol_area" => 10,
        else => 5
    };
    
    // 行动效果预测
    var predicted_damage : int = when {
        ai_action == "cast_fireball" => ai_level * 8,
        ai_action == "melee_attack" => ai_level * 5,
        ai_action == "cast_nature_spell" && terrain_type == "forest" => ai_level * 6,
        ai_action == "cast_lightning" && weather == "rain" => ai_level * 7,
        ai_action == "cast_long_range_spell" => ai_level * 4,
        else => 0
    };
    
    var success_probability : int = when {
        ai_action == "cast_heal" => 95,
        ai_action == "retreat" && ai_health <= 20 => 90,
        ai_action == "melee_attack" && enemy_distance <= 3 => 85,
        ai_action == "cast_fireball" && ai_mana >= 50 => 80,
        ai_action == "cast_nature_spell" && terrain_type == "forest" => 85,
        ai_action == "cast_lightning" && weather == "rain" => 90,
        ai_action == "pursue_enemy" && enemy_health <= 30 => 75,
        else => 70
    };
    
    std::println("AI决策分析:");
    std::println("  当前状态: 生命" + lang::to_string(ai_health) + ", 法力" + lang::to_string(ai_mana) + ", 等级" + lang::to_string(ai_level));
    std::println("  环境信息: " + terrain_type + ", " + weather + ", 敌人距离" + lang::to_string(enemy_distance));
    std::println("  选择行动: " + ai_action);
    std::println("  资源消耗: 法力" + lang::to_string(mana_cost) + ", 体力" + lang::to_string(stamina_cost));
    std::println("  预期伤害: " + lang::to_string(predicted_damage));
    std::println("  成功概率: " + lang::to_string(success_probability) + "%");
    std::println("");
}

// 复杂的金融风险评估系统
fn complex_financial_risk_system() {
    std::println("🔥 复杂金融风险评估系统");
    std::println("======================");
    
    // 客户财务数据
    var annual_income : int = 80000;
    var credit_score : int = 720;
    var debt_ratio : int = 35; // 负债比例 (%)
    var employment_years : int = 5;
    var age : int = 32;
    var loan_amount : int = 250000;
    var down_payment : int = 50000;
    var loan_term : int = 30; // 年
    
    // 市场环境因素
    var interest_rate : int = 4; // %
    var market_volatility : string = "medium";
    var economic_outlook : string = "stable";
    var property_type : string = "residential";
    
    // 超复杂的风险评级系统
    var credit_risk : string = when {
        credit_score >= 800 && debt_ratio <= 20 => "excellent",
        credit_score >= 750 && debt_ratio <= 30 => "very_good",
        credit_score >= 700 && debt_ratio <= 40 => "good",
        credit_score >= 650 && debt_ratio <= 50 => "fair",
        credit_score >= 600 => "poor",
        else => "very_poor"
    };
    
    var income_stability : string = when {
        employment_years >= 10 && annual_income >= 100000 => "very_stable",
        employment_years >= 5 && annual_income >= 60000 => "stable",
        employment_years >= 3 && annual_income >= 40000 => "moderate",
        employment_years >= 1 => "unstable",
        else => "very_unstable"
    };
    
    var loan_to_value : int = (loan_amount * 100) / (loan_amount + down_payment);
    
    var loan_risk : string = when {
        loan_to_value <= 60 && loan_term <= 15 => "low",
        loan_to_value <= 80 && loan_term <= 20 => "moderate",
        loan_to_value <= 90 && loan_term <= 30 => "high",
        loan_to_value > 90 => "very_high",
        else => "extreme"
    };
    
    // 综合风险评估
    var overall_risk : string = when {
        credit_risk == "excellent" && income_stability == "very_stable" && loan_risk == "low" => "minimal",
        credit_risk == "very_good" && income_stability == "stable" && loan_risk == "moderate" => "low",
        credit_risk == "good" && income_stability == "moderate" && loan_risk == "high" => "medium",
        credit_risk == "fair" || income_stability == "unstable" || loan_risk == "very_high" => "high",
        else => "extreme"
    };
    
    // 利率调整
    var risk_premium : int = when {
        overall_risk == "minimal" => 0,
        overall_risk == "low" => 25, // 0.25%
        overall_risk == "medium" => 50, // 0.50%
        overall_risk == "high" => 100, // 1.00%
        overall_risk == "extreme" => 200, // 2.00%
        else => 300
    };
    
    var final_rate : int = interest_rate * 100 + risk_premium; // 以基点计算
    
    // 审批决策
    var approval_status : string = when {
        overall_risk == "minimal" || overall_risk == "low" => "approved",
        overall_risk == "medium" && credit_score >= 680 => "conditional_approval",
        overall_risk == "high" && credit_score >= 650 && down_payment >= 60000 => "manual_review",
        else => "declined"
    };
    
    std::println("金融风险评估报告:");
    std::println("  客户信息: 年收入" + lang::to_string(annual_income) + ", 信用分" + lang::to_string(credit_score) + ", 负债比" + lang::to_string(debt_ratio) + "%");
    std::println("  贷款信息: 金额" + lang::to_string(loan_amount) + ", 首付" + lang::to_string(down_payment) + ", 期限" + lang::to_string(loan_term) + "年");
    std::println("  风险评级:");
    std::println("    信用风险: " + credit_risk);
    std::println("    收入稳定性: " + income_stability);
    std::println("    贷款风险: " + loan_risk);
    std::println("    综合风险: " + overall_risk);
    std::println("  贷款价值比: " + lang::to_string(loan_to_value) + "%");
    std::println("  风险溢价: " + lang::to_string(risk_premium) + " 基点");
    std::println("  最终利率: " + lang::to_string(final_rate / 100) + "." + lang::to_string(final_rate % 100) + "%");
    std::println("  审批状态: " + approval_status);
    std::println("");
}

// 复杂的供应链优化系统
fn complex_supply_chain_system() {
    std::println("🔥 复杂供应链优化系统");
    std::println("====================");
    
    // 供应商数据
    var supplier_count : int = 5;
    var primary_supplier_reliability : int = 85; // %
    var backup_supplier_reliability : int = 70; // %
    var emergency_supplier_reliability : int = 60; // %
    
    // 库存和需求数据
    var current_inventory : int = 1500;
    var daily_demand : int = 200;
    var lead_time_days : int = 7;
    var safety_stock : int = 500;
    var max_capacity : int = 5000;
    
    // 成本因素
    var primary_cost_per_unit : int = 25;
    var backup_cost_per_unit : int = 28;
    var emergency_cost_per_unit : int = 35;
    var storage_cost_per_day : int = 2;
    var shortage_penalty : int = 100;
    
    // 市场条件
    var market_demand_trend : string = "increasing";
    var seasonal_factor : int = 120; // % (120% = 20% increase)
    var economic_conditions : string = "uncertain";
    
    // 复杂的库存策略决策
    var reorder_point : int = (daily_demand * lead_time_days) + safety_stock;
    var adjusted_demand : int = (daily_demand * seasonal_factor) / 100;
    
    var inventory_status : string = when {
        current_inventory <= safety_stock => "critical",
        current_inventory <= reorder_point => "low",
        current_inventory <= max_capacity / 2 => "normal",
        current_inventory >= max_capacity * 80 / 100 => "high",
        else => "optimal"
    };
    
    // 供应商选择策略
    var preferred_supplier : string = when {
        inventory_status == "critical" && emergency_supplier_reliability >= 60 => "emergency",
        inventory_status == "low" && primary_supplier_reliability >= 80 => "primary",
        inventory_status == "low" && backup_supplier_reliability >= 70 => "backup",
        inventory_status == "normal" && primary_supplier_reliability >= 85 => "primary",
        primary_supplier_reliability < 70 => "backup",
        else => "primary"
    };
    
    // 订购数量优化
    var base_order_quantity : int = adjusted_demand * lead_time_days;
    
    var order_quantity : int = when {
        inventory_status == "critical" => base_order_quantity * 2,
        inventory_status == "low" && market_demand_trend == "increasing" => base_order_quantity + (base_order_quantity * 50 / 100),
        inventory_status == "normal" && economic_conditions == "uncertain" => base_order_quantity + safety_stock,
        inventory_status == "high" => base_order_quantity / 2,
        else => base_order_quantity
    };
    
    // 成本计算
    var unit_cost : int = when {
        preferred_supplier == "primary" => primary_cost_per_unit,
        preferred_supplier == "backup" => backup_cost_per_unit,
        preferred_supplier == "emergency" => emergency_cost_per_unit,
        else => primary_cost_per_unit
    };
    
    var total_order_cost : int = order_quantity * unit_cost;
    var estimated_storage_cost : int = (current_inventory + order_quantity) * storage_cost_per_day * lead_time_days;
    
    // 风险评估
    var supply_risk : string = when {
        preferred_supplier == "emergency" => "high",
        preferred_supplier == "backup" && primary_supplier_reliability < 70 => "medium",
        inventory_status == "critical" => "high",
        inventory_status == "low" && market_demand_trend == "increasing" => "medium",
        else => "low"
    };
    
    std::println("供应链优化分析:");
    std::println("  当前库存: " + lang::to_string(current_inventory) + " 单位");
    std::println("  库存状态: " + inventory_status);
    std::println("  调整后日需求: " + lang::to_string(adjusted_demand) + " 单位");
    std::println("  重订货点: " + lang::to_string(reorder_point) + " 单位");
    std::println("  推荐供应商: " + preferred_supplier);
    std::println("  建议订购量: " + lang::to_string(order_quantity) + " 单位");
    std::println("  单位成本: " + lang::to_string(unit_cost) + " 元");
    std::println("  总订购成本: " + lang::to_string(total_order_cost) + " 元");
    std::println("  预估仓储成本: " + lang::to_string(estimated_storage_cost) + " 元");
    std::println("  供应风险: " + supply_risk);
    std::println("");
}

