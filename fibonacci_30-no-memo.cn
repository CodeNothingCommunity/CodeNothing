using ns lang;

fn main() : int {
    // 计算斐波那契第35项
    println("斐波那契第35项");
    println("================================");
    let memo_result : int = fibonacci(35);
    println("F(35) = " + to_string(memo_result));

    return memo_result; // F(35) = 832040
}


fn fibonacci(n: int) : int {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}


