// 🔥 CodeNothing 复杂箭头函数测试
// 测试各种复杂场景和边界情况

lib <io>;

fn test_single_param_without_parentheses() {
    std::println("🔥 单参数无括号语法测试");
    std::println("======================");
    
    // 测试单参数不带括号的语法 - 这应该是箭头函数的标准特性
    var double = x: int => x * 2;
    std::println("单参数无括号: " + lang::to_string(double));
    
    var negate = n: int => -n;
    std::println("负数函数: " + lang::to_string(negate));
    
    std::println("");
}

fn test_complex_expressions() {
    std::println("🔥 复杂表达式测试");
    std::println("================");
    
    // 复杂的数学表达式
    var complex_calc = (x: int, y: int, z: int) => (x + y) * z - (x * y) / (z + 1);
    std::println("复杂计算: " + lang::to_string(complex_calc));
    
    // 嵌套的条件表达式
    var nested_conditions = (score: int, bonus: int) => when {
        score >= 90 && bonus >= 10 => when { score >= 95 => "Perfect", else => "Excellent" },
        score >= 80 => when { bonus >= 5 => "Good+", else => "Good" },
        score >= 70 => "Average",
        else => "Poor"
    };
    std::println("嵌套条件: " + lang::to_string(nested_conditions));
    
    std::println("");
}

fn test_arrow_functions_with_null_coalescing() {
    std::println("🔥 箭头函数与空值合并测试");
    std::println("==========================");
    
    // 箭头函数中使用空值合并
    var safe_divide = (a: int, b: int, default: int) => when { b != 0 => a / b, else => default ?? 0 };
    std::println("安全除法: " + lang::to_string(safe_divide));
    
    // 链式空值合并
    var get_value = (primary: string, secondary: string, fallback: string) => primary ?? secondary ?? fallback ?? "default";
    std::println("链式合并: " + lang::to_string(get_value));
    
    std::println("");
}

fn test_arrow_functions_with_string_interpolation() {
    std::println("🔥 箭头函数与字符串插值测试");
    std::println("============================");
    
    // 字符串插值在箭头函数中
    var create_greeting = (name: string, title: string) => "Hello, ${title} ${name}! Welcome to CodeNothing.";
    std::println("问候创建: " + lang::to_string(create_greeting));
    
    var format_report = (user: string, score: int, rank: int) => "User ${user} scored ${score} points and ranked #${rank}";
    std::println("报告格式化: " + lang::to_string(format_report));
    
    std::println("");
}

fn test_nested_arrow_functions() {
    std::println("🔥 嵌套箭头函数测试");
    std::println("==================");
    
    // 箭头函数返回箭头函数（高阶函数）
    var create_multiplier = (factor: int) => (x: int) => x * factor;
    std::println("乘数创建器: " + lang::to_string(create_multiplier));
    
    // 复杂的嵌套结构
    var create_calculator = (op: string) => when {
        op == "add" => (a: int, b: int) => a + b,
        op == "mul" => (a: int, b: int) => a * b,
        op == "sub" => (a: int, b: int) => a - b,
        else => (a: int, b: int) => 0
    };
    std::println("计算器创建器: " + lang::to_string(create_calculator));
    
    std::println("");
}

fn test_arrow_functions_with_blocks() {
    std::println("🔥 块语句箭头函数测试");
    std::println("====================");
    
    // 多行块语句
    var complex_validation = (email: string, password: string) => {
        var email_valid = email.length() > 5 && email.contains("@");
        var password_valid = password.length() >= 8;
        
        if (email_valid && password_valid) {
            return "valid";
        } else if (!email_valid) {
            return "invalid_email";
        } else {
            return "invalid_password";
        }
    };
    std::println("复杂验证: " + lang::to_string(complex_validation));
    
    // 带循环的块语句
    var calculate_factorial = (n: int) => {
        var result = 1;
        var i = 1;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        return result;
    };
    std::println("阶乘计算: " + lang::to_string(calculate_factorial));
    
    std::println("");
}

fn test_arrow_functions_as_parameters() {
    std::println("🔥 箭头函数作为参数测试");
    std::println("========================");
    
    // 这个测试可能会失败，因为我们还没有完全实现高阶函数
    // 但我们可以测试箭头函数的定义
    var processor = (data: int, transformer: string) => when {
        transformer == "double" => data * 2,
        transformer == "square" => data * data,
        transformer == "negate" => -data,
        else => data
    };
    std::println("数据处理器: " + lang::to_string(processor));
    
    std::println("");
}

fn test_edge_cases() {
    std::println("🔥 边界情况测试");
    std::println("==============");
    
    // 空参数列表
    var get_random = () => 42; // 这可能会失败
    std::println("无参数函数: " + lang::to_string(get_random));
    
    // 非常长的参数列表
    var many_params = (a: int, b: int, c: int, d: int, e: int, f: int) => a + b + c + d + e + f;
    std::println("多参数函数: " + lang::to_string(many_params));
    
    // 复杂的返回类型推断
    var type_inference_test = (flag: int) => when { flag == 1 => "string", flag == 2 => "another", else => "default" };
    std::println("类型推断测试: " + lang::to_string(type_inference_test));
    
    std::println("");
}

fn test_performance_scenarios() {
    std::println("🔥 性能场景测试");
    std::println("==============");
    
    // 计算密集型箭头函数
    var fibonacci = (n: int) => when {
        n <= 1 => n,
        n == 2 => 1,
        n == 3 => 2,
        n == 4 => 3,
        n == 5 => 5,
        n == 6 => 8,
        n == 7 => 13,
        n == 8 => 21,
        else => n * 2 // 简化版本
    };
    std::println("斐波那契: " + lang::to_string(fibonacci));
    
    // 字符串处理密集型
    var text_processor = (text: string, operation: string) => when {
        operation == "upper" => text + "_UPPER",
        operation == "lower" => text + "_lower",
        operation == "reverse" => text + "_reversed",
        operation == "trim" => text + "_trimmed",
        else => text + "_processed"
    };
    std::println("文本处理器: " + lang::to_string(text_processor));
    
    std::println("");
}

fn test_real_world_scenarios() {
    std::println("🔥 真实世界场景测试");
    std::println("==================");
    
    // 电商价格计算
    var calculate_final_price = (base_price: int, discount_percent: int, tax_percent: int, shipping: int) => {
        var discounted_price = base_price * (100 - discount_percent) / 100;
        var taxed_price = discounted_price * (100 + tax_percent) / 100;
        return taxed_price + shipping;
    };
    std::println("价格计算器: " + lang::to_string(calculate_final_price));
    
    // 用户权限检查
    var check_permissions = (user_role: string, resource: string, action: string) => when {
        user_role == "admin" => 1, // 管理员可以做任何事
        user_role == "moderator" && resource == "posts" => 1,
        user_role == "user" && action == "read" => 1,
        user_role == "user" && action == "create" && resource == "posts" => 1,
        else => 0
    };
    std::println("权限检查器: " + lang::to_string(check_permissions));
    
    // 数据验证管道
    var validate_user_data = (name: string, email: string, age: int) => when {
        name.length() < 2 => "name_too_short",
        name.length() > 50 => "name_too_long",
        !email.contains("@") => "invalid_email",
        age < 13 => "too_young",
        age > 120 => "too_old",
        else => "valid"
    };
    std::println("数据验证器: " + lang::to_string(validate_user_data));
    
    std::println("");
}

fn main() : int {
    std::println("🔥 CodeNothing 复杂箭头函数测试套件");
    std::println("=================================");
    std::println("");
    
    test_single_param_without_parentheses();
    test_complex_expressions();
    test_arrow_functions_with_null_coalescing();
    test_arrow_functions_with_string_interpolation();
    test_nested_arrow_functions();
    test_arrow_functions_with_blocks();
    test_arrow_functions_as_parameters();
    test_edge_cases();
    test_performance_scenarios();
    test_real_world_scenarios();
    
    std::println("🎉 复杂箭头函数测试完成!");
    std::println("");
    std::println("📊 测试覆盖范围:");
    std::println("✅ 单参数无括号语法");
    std::println("✅ 复杂表达式和嵌套条件");
    std::println("✅ 与其他语法糖的组合");
    std::println("✅ 块语句和多行逻辑");
    std::println("✅ 高阶函数模式");
    std::println("✅ 边界情况和错误处理");
    std::println("✅ 性能密集型场景");
    std::println("✅ 真实世界应用场景");
    
    return 0;
}
